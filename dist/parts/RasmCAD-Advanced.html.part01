<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="RasmCAD Advanced — independent 2D CAD, with precise drawing, editing, layers and local project files.">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>RasmCAD Advanced — Precision 2D workspace</title>
<style>:root{color-scheme:dark;--bg:#111923;--panel:#1c2733;--line:#344353;--muted:#93a7b9;--ink:#e5edf4;--teal:#70dbc0;--accent:#203e3c;--steel:#293949;font-family:"Segoe UI",Arial,sans-serif;font-size:13px}*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:540px;display:flex;flex-direction:column;background:var(--bg);color:var(--ink);overflow:hidden}button,input,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:4px;background:#293847;color:var(--ink);padding:7px 10px;white-space:nowrap;transition:background .12s,border-color .12s}button:hover{background:#354c60;border-color:#5c778e}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--teal);outline-offset:2px}button.primary{background:var(--teal);color:#0c2b26;border-color:var(--teal);font-weight:650}button:disabled{opacity:.38;cursor:default}.quiet{background:transparent}header{height:65px;flex-shrink:0;padding:8px 18px;display:flex;align-items:center;gap:25px;background:#1a2632;border-bottom:1px solid #3c4c5b}.brand{display:flex;align-items:center;gap:10px;min-width:276px}.brand strong{font-size:22px;font-weight:650;letter-spacing:-.5px}.brand strong em{font-size:15px;font-style:normal;font-weight:400;color:#b3c5d4;letter-spacing:0}.brand small{display:block;font-size:9px;letter-spacing:2px;color:var(--muted);margin-top:4px}.logo{display:grid;place-items:center;width:39px;height:39px;border:1px solid #6d9a93;border-radius:5px;font-size:31px;color:var(--teal);background:#203b39}.file-state{flex:1;min-width:0}.file-state span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#file-name{font-size:13px;font-weight:600}#save-state{color:var(--muted);font-size:10px;margin-top:5px}.workspace-badge{font-size:9px;letter-spacing:1.25px;color:#abc0ce;border:1px solid #3b5264;padding:7px 10px;border-radius:3px}kbd{font:10px Consolas,monospace;color:var(--muted);margin-left:9px}.actions{display:flex;align-items:center;gap:8px;min-height:49px;padding:8px 12px;background:#22313f;border-bottom:1px solid #3e5060;overflow-x:auto;flex-shrink:0}.action-group{display:flex;gap:5px;align-items:center}.actions button{padding:6px 10px;font-size:11px}.divider{height:24px;border-right:1px solid #4c5e6d;margin:0 3px}.actions #layers-toggle{display:none}main{display:flex;flex:1;min-height:0;position:relative}.tools{width:162px;flex-shrink:0;padding:7px;background:#1c2a37;overflow-y:auto;border-right:1px solid #3a4b5b;scrollbar-width:thin}.tool-group{border-bottom:1px solid #394957;margin-bottom:7px;padding-bottom:7px}.tool-group summary{display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:6px 5px;color:#bccbd7;font-size:10px;font-weight:650;text-transform:uppercase;letter-spacing:.8px;list-style:none}.tool-group summary::-webkit-details-marker{display:none}.tool-group summary:before{content:'▸';font-size:10px;margin-right:6px;color:#6d8c9f}.tool-group[open] summary:before{content:'▾'}.tool-group summary span{color:#6e8a9e;font:9px Consolas,monospace;margin-left:auto}.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;padding-top:3px}.tool-grid button{min-height:47px;padding:5px 2px;font-size:10px;border-color:transparent;background:transparent;overflow:hidden;text-overflow:ellipsis}.tool-grid button span{font:20px Arial,sans-serif;display:block;height:23px;color:#bccfdf}.tool-grid button.active{background:var(--accent);color:var(--teal);border-color:#4a8277}.tool-grid button.active span{color:var(--teal)}.tool-grid button:hover{background:#30485a}.tool-grid button[hidden]{display:none}.tool-footer{font-size:10px;line-height:1.8;text-align:center;padding:9px 0 14px;color:#8ca6b9}.tool-footer code{font-size:9px;background:none;padding:0}.work-area{flex:1;min-width:0;display:flex;flex-direction:column;direction:ltr}.workspace-head{height:32px;flex-shrink:0;display:flex;justify-content:space-between;align-items:center;padding:0 13px;color:#91a9bc;font-size:9px;border-bottom:1px solid #2c3e4e;letter-spacing:.6px;background:#17212c}.workspace-head b{font-size:10px;font-weight:600;color:#c5d5df;border-bottom:2px solid var(--teal);padding:8px 10px 7px 0}.workspace-head i{font-size:9px;font-style:normal;margin-left:12px;color:#7894a9}.workspace-dot{display:inline-block;width:6px;height:6px;background:#6eb89f;border-radius:50%;margin-left:5px}#canvas-wrap{position:relative;flex:1;min-height:60px;overflow:hidden;background:#111923}#canvas{width:100%;height:100%;display:block;touch-action:none;outline:0}#welcome{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:left;width:min(470px,86%);padding:30px;border:1px solid #41566a;background:rgba(24,38,50,.97);border-radius:7px;box-shadow:0 18px 70px #050a1080}#welcome[hidden]{display:none}.welcome-kicker{font-size:9px;letter-spacing:1.4px;color:var(--teal)}#welcome h1{font-size:27px;letter-spacing:-.6px;font-weight:600;margin:14px 0}#welcome p{color:#a4b8c8;font-size:12px;line-height:1.8;margin:0}#welcome>div{display:flex;gap:8px;margin:22px 0 18px}#welcome>div button{font-size:11px}#welcome small{font-size:9px;color:#829cae}.command-area{padding:8px 12px 10px;background:#121e29;border-top:1px solid #3c5062;flex-shrink:0}.command-caption{display:flex;justify-content:space-between;color:#657f94;font:8px Consolas,monospace;letter-spacing:1.1px;margin-bottom:6px}.command-caption span{font:9px "Segoe UI",Arial,sans-serif;letter-spacing:0}#status-log{font:10px Consolas,monospace;color:#9eb3c4;height:18px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}#prompt{color:var(--teal);font-size:11px;min-height:21px;line-height:1.7;margin-bottom:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#command-form{display:flex;align-items:center;gap:9px}#command-form label{font-size:10px;color:#b0c3d1}#command{flex:1;font:12px Consolas,monospace;padding:8px;background:#1c3244;border-color:#425e72}#command-form button{font-size:10px;padding:8px 11px}.sidebar{width:258px;flex-shrink:0;background:var(--panel);padding:15px 13px;border-left:1px solid #3a4b5b;overflow-y:auto;scrollbar-width:thin}.panel-title{font-size:12px;font-weight:650;display:flex;align-items:center;justify-content:space-between}.panel-title span{font:9px Consolas,monospace;color:var(--teal);border:1px solid #41665f;padding:3px 6px;border-radius:3px}.stats{display:flex;gap:8px;padding:13px 0 15px}.stats>div{background:#243644;flex:1;padding:10px 12px;border:1px solid #304857;border-radius:4px}.stats b{display:block;font-size:23px;font-weight:400}.stats small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.inspector-section{border-top:1px solid #3a4b58;margin-top:2px}.inspector-section summary{font-size:11px;font-weight:600;cursor:pointer;padding:11px 0;color:#c5d4df}.properties-form{display:grid;gap:6px;padding:1px 0 13px}.properties-form>label{font-size:10px;color:#9eb3c5;margin-top:3px}.property-type-row{display:flex;justify-content:space-between;font-size:10px;gap:7px;padding:1px 0 6px}.property-type-row label{color:#9eb3c5}.property-type-row span{color:#dce8ef;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}.property-pair{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:3px 0}.property-pair label{font-size:10px;color:#9eb3c5;display:flex;flex-direction:column;gap:6px}.property-pair input{width:100%}.property-pair input[type=color]{height:31px;padding:3px}.properties-form input,.properties-form select{font-size:11px;padding:6px}.properties-form>button{font-size:10px;margin-top:5px;background:#29443f;border-color:#41665c}.field-hint{font-size:9px;line-height:1.5;color:#7f9aac}.layer-panel{padding-bottom:8px}.field-label{font-size:10px;color:var(--muted);display:block;margin:1px 0 7px}input,select{background:#14232f;border:1px solid #3e5669;color:var(--ink);border-radius:3px;padding:7px;min-width:0}select{width:100%;font-size:11px}.layer-options{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:10px 0}.layer-options label{display:flex;align-items:center;gap:7px;font-size:10px;color:#a8bbc9}.layer-options input{width:31px;height:25px;padding:2px}.layer-options button{font-size:9px;padding:5px 7px}.new-layer{display:flex;gap:5px;margin-top:11px}.new-layer input{width:100%;font-size:10px}.new-layer button{padding:3px 10px;font-size:17px}.layer-list{display:grid;gap:3px;margin:11px 0;max-height:210px;overflow-y:auto}.layer-row{border:0;border-radius:3px;padding:7px 7px;display:flex;gap:8px;align-items:center;text-align:left;background:transparent;font-size:10px;max-width:100%;overflow:hidden}.layer-row.active{background:var(--accent)}.layer-row span:first-child{width:8px;height:8px;border-radius:2px;flex-shrink:0}.layer-row .layer-title{overflow:hidden;text-overflow:ellipsis}.layer-row em{color:var(--muted);font-size:9px;font-style:normal;margin-left:auto}.panel-note{margin-top:12px;border-top:1px solid #344655;padding-top:12px;font-size:10px;line-height:1.8;color:#8fa8ba}.panel-note b{color:#c8d8e3;font-size:10px}.panel-note p{margin:5px 0}.panel-note code{font-size:9px;padding:0;background:none}footer{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:31px;padding:3px 13px;border-top:1px solid #3d5060;font-size:10px;background:#233442;flex-shrink:0}.toggles{display:flex;gap:3px}.toggles button{font-size:9px;padding:4px 10px;border:1px solid #3d5261;border-radius:2px;background:#273c4c}.toggles button[aria-pressed=true]{color:var(--teal);background:var(--accent);border-color:#4e776d}.units{color:#99b0c1;font-size:9px}.units span{margin-left:15px;color:#c2d1dd}#coordinates{font:10px Consolas,monospace;min-width:165px}dialog{background:#1b2c3b;color:var(--ink);border:1px solid #506b80;border-radius:7px;width:min(870px,94vw);max-height:90vh;padding:23px;line-height:1.8;font-size:12px}dialog::backdrop{background:#030a14bd}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:10px}.dialog-head h2{margin:2px 0 0;font-weight:600;font-size:22px}.dialog-kicker{font-size:9px;letter-spacing:1.3px;color:var(--teal);text-transform:uppercase}.dialog-head button{font-size:20px;padding:2px 10px}table{width:100%;border-collapse:collapse;font-size:11px}th,td{padding:9px 8px;text-align:left;border-bottom:1px solid #375063;vertical-align:top}th{color:var(--teal);font-weight:600}td:nth-child(2){white-space:nowrap}code{display:inline-block;color:#9ce7d5;background:#10232e;padding:1px 4px;font:11px Consolas,monospace}.limit-note{color:#a9bfce;border-top:1px solid #40576a;padding-top:11px}#import-report-content{white-space:pre-wrap;word-break:break-word;font:11px/1.8 Consolas,monospace;background:#122330;border:1px solid #3b5264;padding:15px;max-height:52vh;overflow:auto}summary{user-select:none}button[hidden]{display:none!important}
@media(max-width:1250px){.sidebar{width:230px;padding:13px 11px}.tools{width:148px}.brand{min-width:250px}.workspace-badge{display:none}.actions{gap:5px}.actions button{padding:6px 8px;font-size:10px}.tool-grid button{font-size:9px;min-height:44px}.tool-grid button span{height:22px;font-size:18px}#welcome{padding:25px}#welcome h1{font-size:24px}}
@media(max-width:980px){.sidebar{display:none;position:absolute;right:0;top:0;bottom:0;width:258px;z-index:5;box-shadow:-15px 0 50px #0009}.sidebar.open{display:block}.actions #layers-toggle{display:block}.tools{width:143px}.shortcuts{display:none}.units span{display:none}}
@media(max-width:680px){body{min-height:500px}header{height:58px;padding:8px 10px;gap:12px}.brand{min-width:0}.brand strong{font-size:18px}.brand strong em{font-size:11px}.brand small{font-size:7px;letter-spacing:1px}.brand .logo{width:31px;height:31px;font-size:25px}.file-state{font-size:9px;overflow:hidden;min-width:0}#file-name{font-size:10px}#save-state{font-size:8px}#help-btn{font-size:10px;padding:6px}kbd{display:none}.actions{padding:7px 8px;min-height:45px}.actions button{font-size:10px}.tools{width:100px;padding:5px}.tool-grid{gap:2px}.tool-grid button{font-size:8px;min-height:43px}.tool-grid button span{font-size:17px}.tool-group summary{font-size:8px;padding:6px 2px;letter-spacing:.1px}.tool-group summary span{display:none}.tool-footer{font-size:8px}.workspace-head{padding:0 8px;font-size:8px;height:29px}.workspace-head i{display:none}.workspace-head>span:last-child{font-size:7px}.command-area{padding:7px}.command-caption{font-size:7px}.command-caption span{display:none}#command-form{gap:5px}#command-form label{display:none}#command{font-size:11px;padding:8px;width:60px}#command-form button{padding:8px;font-size:9px}#prompt{font-size:10px}#status-log{font-size:9px}footer{gap:5px;padding:4px 7px}#coordinates{font-size:9px;min-width:125px}.toggles button{padding:4px 6px;font-size:8px}.units{display:none}#welcome{padding:22px 15px}#welcome h1{font-size:20px}#welcome p{font-size:11px}#welcome>div{flex-direction:column}#welcome small{font-size:8px}.welcome-kicker{font-size:8px;letter-spacing:.7px}dialog{padding:16px}table{font-size:10px}th,td{padding:7px 5px}td:nth-child(2){white-space:normal}}
@media print{header,.actions,.tools,.sidebar,.command-area,footer,.workspace-head,#welcome,dialog{display:none!important}html,body,main,.work-area,#canvas-wrap{width:100%!important;height:100%!important;min-height:0!important;background:white!important;display:block!important}#canvas{width:100%!important;height:auto!important;max-height:95vh!important;object-fit:contain}}
/* Command completion, CAD selection and dimension style editor. */
.workspace-head{height:39px;gap:8px}.workspace-title{display:flex;align-items:center;gap:9px;min-width:0}.workspace-title>b{flex-shrink:0}.workspace-title>i{margin-left:0;white-space:nowrap}.command-pill{display:inline-flex;align-items:center;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:4px 8px;border:1px solid #4d786c;border-radius:3px;background:#233f39;color:#9cebd6;font:600 9px Consolas,monospace;letter-spacing:.4px}.command-controls{display:flex;gap:5px;flex-shrink:0}.command-controls button{font-size:10px;padding:5px 8px}.command-controls kbd{font-size:8px;margin-left:5px}.command-controls #finish-btn{color:#a9f0d6;border-color:#4c796a;background:#27473e}.command-controls #cancel-btn{color:#d4c9c8;background:#313b44}.selection-strip{display:flex;gap:12px;align-items:center;min-height:33px;padding:4px 12px;background:#1c2a36;border-bottom:1px solid #344b5c;flex-shrink:0}.selection-strip>label{display:flex;align-items:center;gap:7px;font-size:9px;color:#a7bfce;white-space:nowrap}.selection-strip select{width:auto;max-width:165px;font-size:9px;padding:3px 5px}.selection-strip #selection-hint{font-size:9px;line-height:1.4;color:#89a4b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.checkbox-field{display:flex!important;flex-direction:row!important;align-items:center;gap:6px;font-size:10px!important;line-height:1.5;color:#a9c0cf!important;margin:4px 0!important}.checkbox-field input[type=checkbox]{width:13px;height:13px;flex-shrink:0;accent-color:var(--teal);padding:0;margin:0}#dimension-properties{min-width:0;margin:9px 0 3px;border:1px solid #40586a;border-radius:4px;padding:10px;display:grid;gap:7px;background:#182a37}#dimension-properties[hidden]{display:none}#dimension-properties legend{font-size:10px;color:#a8dacc;padding:0 6px;font-weight:600}#dimension-properties>label{font-size:10px;color:#a8bfce}#dimension-properties .field-hint{margin:0 0 3px;line-height:1.6}.dimension-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}.dimension-grid>label{display:flex;flex-direction:column;gap:5px;font-size:9px;line-height:1.5;color:#a8bfce}.dimension-grid input{width:100%;font-size:10px;padding:6px 5px}.dimension-color-row{display:flex;justify-content:space-between;align-items:center;gap:8px}.dimension-color-row>label:first-child{display:flex;align-items:center;gap:6px;font-size:9px;color:#a8bfce}.dimension-color-row input[type=color]{width:36px;height:27px;padding:2px}#dim-defaults-btn{white-space:normal;font-size:10px;padding:7px;background:#2b4351;border-color:#476275}#apply-properties{position:sticky;bottom:0;z-index:1;box-shadow:0 -7px 12px #1c2733e0;padding:9px!important}.properties-form .field-hint{font-size:9px;line-height:1.6}#property-text::placeholder{font-size:9px;color:#6d899c}.sidebar{scroll-padding-top:15px;scroll-padding-bottom:25px}
@media(max-width:1250px){.workspace-title>i{display:none}.selection-strip{gap:8px;padding:4px 8px}.selection-strip #selection-hint{font-size:8px}.selection-strip>label{font-size:8px}.selection-strip select{font-size:8px;max-width:140px}.command-pill{max-width:125px}.command-controls button{font-size:9px;padding:5px 7px}}
@media(max-width:680px){.workspace-head{height:36px;padding:0 6px;gap:4px}.workspace-title{gap:4px}.workspace-title>b{display:none}.command-pill{max-width:100px;font-size:8px;padding:4px 6px}.command-controls{gap:3px}.command-controls button{font-size:9px;padding:5px 6px}.command-controls kbd{display:none}.selection-strip{min-height:42px;align-items:flex-start;flex-direction:column;gap:2px;padding:4px 7px}.selection-strip #selection-hint{font-size:8px;max-width:100%}.selection-strip select{padding:2px 4px}.selection-strip>label{font-size:8px}.dimension-grid>label{font-size:9px}}
@media print{.selection-strip{display:none!important}}
/* 0.5 command workspace: preserve drawing space and keep workflow controls visible. */
.version-badge{display:inline-block;margin-left:4px;padding:2px 5px;border:1px solid #598f7f;border-radius:3px;color:#a9f0d6;font:600 11px Consolas,monospace;vertical-align:middle;letter-spacing:0}.brand{min-width:286px}header{gap:16px}#diagnostics-btn{font-size:10px;padding:7px 8px}.workspace-head{min-height:39px;height:auto;padding-top:4px;padding-bottom:4px}.command-controls #select-btn{color:#c5e7f4;background:#264252;border-color:#4a7287}#errors-banner{padding:8px 16px;flex-shrink:0;max-height:66px;overflow:auto;background:#593932;color:#ffe0d3;border-bottom:1px solid #a87961;font-size:12px}#errors-banner[hidden]{display:none}.command-area{padding-top:6px;position:relative}.command-caption{align-items:center;gap:10px;margin-bottom:4px;letter-spacing:.6px}#history-toggle{padding:2px 0;border:0;background:transparent;color:#9bb4c6;font:9px Consolas,monospace;text-align:left}#history-toggle:hover{color:var(--teal)}#draft-status{color:#b3cbd9;font:9px Consolas,monospace;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#command-history{height:60px;max-height:60px;overflow-y:auto;scrollbar-width:thin;color:#92a9ba;white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.5 Consolas,monospace}#command-history.expanded{height:100px;max-height:100px;border-bottom:1px solid #2c4354;margin-bottom:4px;padding-bottom:4px}#command-history:empty{height:60px}#command-history.expanded:empty{height:100px}#command-history>div{padding:1px 0}#command-history .history-input{color:#c7dbe9}#command-history .history-error{color:#f0bca9}#status-log{min-height:32px;height:32px;max-height:32px;white-space:normal;font-size:10px;line-height:1.5}#prompt{white-space:normal;line-height:1.5;height:36px;min-height:36px;max-height:36px;overflow:auto;overflow-wrap:anywhere}.command-input-wrap{flex:1;min-width:0;position:relative;display:flex}#command{width:100%;min-width:0}#repeat-btn{background:#253b49;color:#b5cfde}#suggestions{position:absolute;bottom:calc(100% + 5px);left:0;right:0;z-index:8;max-height:190px;overflow:auto;list-style:none;margin:0;padding:4px;border:1px solid #57758c;border-radius:4px;background:#1b3041;box-shadow:0 -8px 24px #0008}#suggestions[hidden]{display:none}#suggestions>li{margin:0;padding:6px 8px;color:#d4e5ef;font:11px/1.4 Consolas,monospace;cursor:pointer;border-radius:2px}#suggestions>li:hover,#suggestions>li.active,#suggestions>li[aria-selected=true]{background:#31574e;color:#b8f2de}#suggestions>li button{width:100%;text-align:left;background:transparent;border:0;padding:0;font:inherit;color:inherit}.command-controls button{padding-left:7px;padding-right:7px}.stats>div:nth-child(2){border-color:#4b7c70}.stats #selection-count{color:#a7ead5}
@media(max-width:1250px){.brand{min-width:264px}.command-controls kbd{display:none}.workspace-title{gap:5px}.workspace-head{padding-left:8px;padding-right:8px}.command-pill{max-width:108px}}
@media(max-width:980px){header{gap:12px}.brand{min-width:254px}.command-pill{max-width:155px}}
@media(max-width:680px){header{gap:8px}.brand{min-width:0}.version-badge{font-size:9px;margin-left:1px;padding:2px 3px}.brand strong em{font-size:10px}#diagnostics-btn{font-size:0;padding:7px 5px}#diagnostics-btn:after{content:'Info';font-size:10px}.workspace-head{min-height:36px}.command-pill{max-width:74px}.command-controls button{font-size:8px;padding:5px}.command-controls{gap:3px}#draft-status{display:block;font-size:8px;max-width:58%}#command-form{gap:4px}#command-form button{padding:8px 6px}#repeat-btn{font-size:8px}#command-history{font-size:9px;height:45px;max-height:45px}#command-history:empty{height:45px}#command-history.expanded{height:85px;max-height:85px}#command-history.expanded:empty{height:85px}#status-log{font-size:9px}#prompt{font-size:10px;height:42px;min-height:42px;max-height:42px}}
@media print{#errors-banner{display:none!important}}
/* 0.6 import editing recovery stays inside existing panels. */
#layer-state{margin:7px 0;font-size:9px;line-height:1.5;overflow-wrap:anywhere}#unlock-visible-layers{width:100%;font-size:10px;padding:6px}.import-actions{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:12px}
/* Persistent advanced 2D editing forms. */
.advanced-dialog{width:min(660px,94vw)}.advanced-dialog h2{font-size:20px;margin:0 0 12px}.advanced-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 16px}.advanced-form label{display:flex;flex-direction:column;gap:4px;font-size:11px}.advanced-form label:has(textarea){grid-column:1/-1}.advanced-form textarea{min-height:110px;font:12px Consolas,monospace;resize:vertical}.advanced-form input[type=checkbox]{align-self:flex-start}.advanced-form .advanced-error,.advanced-form .import-actions{grid-column:1/-1}.advanced-error{color:#ffc7b8;min-height:18px;margin:0}.block-edit-banner{flex-shrink:0;background:#3b4228;color:#ecedc5;padding:7px 10px;font-size:11px;display:flex;align-items:center;gap:8px}.block-edit-banner[hidden]{display:none}.block-edit-banner button{font-size:10px;padding:4px 8px}@media(max-width:600px){.advanced-form{grid-template-columns:1fr}.block-edit-banner{flex-wrap:wrap}}
/* Command-depth workspace: compact hierarchy, stable model area and readable tools. */
:root{--panel:#192532;--line:#354a5b;--muted:#92aabc;--ink:#e1ebf3;--teal:#8ed5e6;--accent:#203b49;--steel:#263b4b}
header{height:61px;padding:8px 15px;background:#13212e;border-bottom-color:#344c5f;gap:18px}.brand{min-width:315px;gap:10px}.brand strong{font-size:21px;letter-spacing:-.7px}.brand strong em{color:#9bb3c5;font-size:14px}.brand small{font-size:8px;letter-spacing:1.3px;margin-top:5px;display:flex;gap:8px;align-items:center}.development-badge{color:#b7c7d5;letter-spacing:.5px;font:7px Consolas,monospace;border-left:1px solid #526879;padding-left:8px}.logo{border-radius:8px;background:#203b49;border-color:#4b7a8b;color:#9ad6e4;width:38px;height:38px}.workspace-badge{border:0;background:#1c3040;display:flex;align-items:center;gap:7px;padding:7px 9px;font-size:8px;letter-spacing:.65px}.workspace-status-dot{width:5px;height:5px;background:#9ad7c3;border-radius:50%;box-shadow:0 0 0 3px #9ad7c314}.version-badge{font-size:9px;border-color:#466877;color:#a1ccdc;background:#243b4a;padding:2px 4px}#file-name{font-size:12px}#save-state{font-size:9px;color:#8aa3b7}.quiet{font-size:10px}
.actions{min-height:59px;padding:6px 13px 7px;gap:11px;overflow-y:hidden;background:#1b2b39;border-bottom:1px solid #344b5c}.action-group{position:relative;padding-top:14px;gap:5px;flex-shrink:0}.action-group:before{content:attr(data-action-label);position:absolute;top:0;left:1px;color:#849fb4;font:8px "Segoe UI",Arial,sans-serif;text-transform:uppercase;letter-spacing:1px}.actions button{background:#243b4c;border-color:#3a5265;font-size:10px;padding:6px 10px;min-height:28px}.actions button.primary{background:#8ed5e6;color:#122c35;border-color:#8ed5e6}.actions button:hover{background:#315268;border-color:#658aa0}.actions #save-as-btn{color:#b3e1ed;border-color:#5b7f90;background:#244555}.actions #print-btn{color:#d0e7f4;background:#2b4b60;border-color:#5b7a8e}.actions .divider{height:35px;border-color:#3b5163}.actions #layers-toggle{margin-left:auto;align-self:flex-end;flex-shrink:0}
.workspace-ribbon{height:39px;min-height:39px;flex-shrink:0;display:flex;align-items:center;gap:16px;padding:0 13px;border-bottom:1px solid #3c5365;background:#142330}.workspace-tabs{height:100%;display:flex;align-items:stretch;gap:4px;flex-shrink:0}.workspace-tabs button{border-radius:0;border:0;border-bottom:2px solid transparent;background:transparent;padding:0 13px;font-size:10px;color:#91aabd}.workspace-tabs button:hover{color:#e4eef4;background:#203747}.workspace-tabs button.is-current{color:#b9e9f4;border-bottom-color:#8ed5e6;background:#213a4a}.ribbon-context{display:flex;align-items:center;gap:12px;min-width:0;flex:1;overflow:hidden}.ribbon-context strong{font:9px Consolas,monospace;font-weight:600;letter-spacing:.4px;flex-shrink:0;color:#b5d5e5}.ribbon-context>span{color:#809caf;font-size:9px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}#workflow-reference-btn{background:transparent;border-color:#3a5568;font-size:9px;padding:5px 8px;color:#b0c7d7;flex-shrink:0}
.tools{width:176px;padding:8px;background:#172634;border-right:1px solid #3b5162}.tool-group{border-bottom-color:#344b5c;padding-bottom:9px;margin-bottom:8px}.tool-group summary{font-size:9px;letter-spacing:1.1px;color:#b4cbdc;padding:6px 4px 8px}.tool-group summary span{font-size:8px;color:#648499}.tool-grid{gap:4px}.tool-grid button{border:1px solid #2b4253;background:#1a2c3a;border-radius:4px;min-height:48px;font-size:10px;color:#b1c7d8}.tool-grid button span{font-size:20px;color:#8cb5cc;height:24px}.tool-grid button:hover{background:#28495d;border-color:#567c92;color:#e0edf5}.tool-grid button.active{background:#244b5d;border-color:#78a7ba;color:#c7eff5;box-shadow:inset 0 0 0 1px #8ed5e61a}.tool-grid button.active span{color:#b6e8f4}.tool-footer{font-size:9px;line-height:1.9;color:#718fa4}
.workspace-head{min-height:39px;background:#182a38;border-bottom-color:#344e60}.workspace-title>b{font-size:9px;letter-spacing:1px;border-bottom:0;color:#c8dde9;padding-top:7px;padding-bottom:7px}.workspace-title>i{font-size:8px;color:#708fa5}.command-pill{border-color:#3d6d83;background:#1b3b4c;color:#b1e4f1;border-radius:3px;font-size:9px;padding:4px 9px}.command-controls button{font-size:9px;min-height:26px}.command-controls #finish-btn{background:#285c55;border-color:#4f8c80;color:#bcebdd}.command-controls #cancel-btn{background:#34414e;color:#c0cfda;border-color:#526575}.command-controls #select-btn{background:#28475b;border-color:#4b7189}.selection-strip{background:#1b2d3c;border-bottom-color:#30495c;min-height:32px}.selection-strip select{border-color:#425e73;background:#203a4c}.selection-strip #selection-hint{color:#7898ae}
.command-area{background:#101e2b;border-top:1px solid #50687c;padding:6px 12px 10px}.command-caption{font-size:8px}.command-area #history-toggle{color:#7f9cb2;font-size:8px;letter-spacing:1px}#command-history{color:#7694a9;font-size:10px;line-height:1.5}#command-history .history-input{color:#a7c7db}#status-log{color:#9bb5c6;font-size:10px}#prompt{font-size:11px;font-weight:500;color:#a9e4cf}#prompt:before{content:'› ';color:#8bcfb7;font-weight:700}#command-form{gap:8px}#command-form label{font-size:9px;text-transform:uppercase;letter-spacing:.7px;color:#83a7be}#command{background:#203b4e;border-color:#54788f;border-radius:4px;color:#e1f0fa;font-size:12px;padding:9px 10px}#command::placeholder{color:#7090a6}#command-form button{background:#284a60;border-color:#486c82;color:#c5dfef}#command-form #repeat-btn{background:#1d3445;color:#9bb8cb}
.sidebar{width:272px;padding:14px;background:#192936;border-left-color:#3b5264}.panel-title{font-size:12px;color:#d2e3ee}.panel-title span{border-color:#45667a;background:#213b4c;color:#a8d8e8;font-size:8px}.stats{gap:8px;padding:12px 0}.stats>div{background:#203747;border-color:#344f63;padding:9px 11px}.stats b{font-size:23px;color:#cbe4f2}.stats #selection-count{color:#a9dfd1}.stats small{font-size:9px;color:#7799b0;text-transform:uppercase;letter-spacing:.7px}.inspector-section{border-top-color:#344e61}.inspector-section summary{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:#a7c1d4}.properties-form input,.properties-form select,.layer-panel input,.layer-panel select{background:#142734;border-color:#3c5a70}#dimension-properties{background:#162b39;border-color:#3c586d}#apply-properties{background:#245248;border-color:#4b7a6b;color:#c3e8dc;box-shadow:0 -7px 12px #192936e0}.panel-note{font-size:9px;color:#7898af;border-top-color:#344b5c}.panel-note b{color:#aac5d8;font-size:9px}footer{min-height:30px;background:#1b3040;border-top-color:#425b6f;padding-left:13px;padding-right:13px}.toggles button{background:#203a4c;border-color:#3d5c72;color:#87a8be;font-size:8px;letter-spacing:.4px;padding:4px 11px}.toggles button[aria-pressed=true]{background:#274c5b;border-color:#6b99ac;color:#b3e3eb}#coordinates{font-size:10px;color:#b8cfdf}.units{font-size:8px;color:#7290a6}
#welcome{width:min(445px,85%);padding:29px;border-color:#46667b;background:#192f3ff5;border-radius:8px;box-shadow:0 20px 65px #030b1280}#welcome .welcome-kicker{color:#94c5d8;font-size:9px;letter-spacing:1.4px}#welcome h1{font-size:26px;font-weight:550;color:#d7e8f1;letter-spacing:-.7px}#welcome p{font-size:12px;line-height:1.8;color:#96b4c8}#welcome small{color:#6e94ab;font-size:8px}
.workflow-reference{width:min(900px,95vw)}.workflow-reference>p{font-size:11px;color:#9fb9ca}.workflow-reference-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;max-height:54vh;overflow:auto;padding-right:4px}.workflow-reference-item{display:grid;grid-template-columns:1fr auto;gap:5px 10px;white-space:normal;text-align:left;background:#1b3547;border-color:#3b5a6f;padding:10px 12px}.workflow-reference-item strong{font:600 11px Consolas,monospace;color:#b8e3ef}.workflow-reference-item small{font-size:8px;letter-spacing:.6px;text-transform:uppercase;color:#7ea1b8}.workflow-reference-item span{grid-column:1/-1;font-size:10px;line-height:1.6;color:#9bb8cb}.save-dialog form{display:grid;gap:14px}.save-dialog form>label{display:grid;gap:5px;font-size:11px;color:#adc6d7}.save-dialog form>label input,.save-dialog form>label select{width:100%}.save-dialog p{margin:0;color:#8eacbf;font-size:11px}.save-dialog #save-dwg-note{border-top:1px solid #3c5769;padding-top:10px;font-size:10px;color:#9cabb8}.save-actions{display:flex;justify-content:flex-end;gap:8px}.save-actions button{font-size:11px}
@media(max-width:1250px){header{gap:12px}.brand{min-width:305px}.workspace-badge{display:none}.sidebar{width:245px;padding:12px}.tools{width:158px}.actions{gap:7px}.actions button{padding:6px 8px;font-size:9px}.workspace-ribbon{gap:12px;padding:0 10px}.workspace-tabs button{padding:0 10px}.ribbon-context{gap:7px}.ribbon-context>span{font-size:8px}.tool-grid button{font-size:9px;min-height:46px}}
@media(max-width:980px){.sidebar{width:272px}.brand{min-width:280px}.development-badge{display:none}.tools{width:151px}.ribbon-context>span{display:none}.workspace-tabs button{font-size:9px}.actions #layers-toggle{display:block}.actions{min-height:58px}.workspace-ribbon{gap:8px}.ribbon-context strong{font-size:8px}}
@media(max-width:680px){header{height:56px;padding:7px 9px;gap:8px}.brand{min-width:0}.brand strong{font-size:18px}.brand strong em{font-size:10px}.brand small{font-size:6px;letter-spacing:.7px}.brand .logo{width:31px;height:31px;font-size:25px}.brand .version-badge{font-size:8px}#help-btn{font-size:0;padding:7px}#help-btn:after{content:'Help';font-size:9px}.actions{min-height:56px;padding:5px 8px;gap:7px}.actions button{font-size:9px;padding:5px 8px}.action-group{padding-top:12px}.action-group:before{font-size:7px}.actions .divider{height:31px;margin:0}.workspace-ribbon{height:35px;min-height:35px;padding:0 6px;gap:6px}.workspace-tabs{gap:0}.workspace-tabs button{font-size:9px;padding:0 8px}.ribbon-context{display:none}#workflow-reference-btn{font-size:0;border:0;padding:6px;margin-left:auto}#workflow-reference-btn:after{content:'Commands';font-size:9px}.tools{width:100px;padding:5px}.tool-grid{gap:3px}.tool-grid button{font-size:8px;min-height:43px}.tool-grid button span{font-size:17px;height:21px}.tool-group summary{font-size:8px;letter-spacing:.2px}.sidebar{width:260px}.workspace-title>b{display:none}.workspace-head{min-height:36px}.command-area{padding:6px 7px 8px}#command-form label{display:none}#command-form{gap:4px}#command-form button{padding:8px 6px;font-size:9px}#command{font-size:11px;padding:8px}#prompt{font-size:10px}footer{padding:4px 7px}#coordinates{font-size:9px}.toggles button{padding:4px 6px;font-size:8px}.workflow-reference-list{grid-template-columns:1fr}.workflow-reference-item{padding:9px 11px}.save-actions{flex-wrap:wrap}}
@media print{.workspace-ribbon{display:none!important}}
@media(max-height:900px) and (min-width:681px){#command-history,#command-history:empty{height:40px;max-height:40px}#command-history.expanded,#command-history.expanded:empty{height:80px;max-height:80px}#status-log{height:26px;min-height:26px;max-height:26px}#prompt{height:32px;min-height:32px;max-height:32px}.command-area{padding-bottom:8px}.tool-grid button{min-height:44px}}
</style>
</head>
<body>
<header>
 <div class="brand"><span class="logo" aria-hidden="true">⌑</span><div><strong>RasmCAD <em>Advanced</em> <span class="version-badge">0.9-dev</span></strong><small>PRECISION DRAFTING WORKSPACE <span class="development-badge">DWG / LAYOUT PREVIEW</span></small></div></div>
 <div class="file-state"><span id="file-name">Untitled drawing</span><span id="save-state">Ready to draw</span></div>
 <span class="workspace-badge"><span class="workspace-status-dot"></span> LOCAL DRAWING WORKSPACE</span><button id="diagnostics-btn" class="quiet" title="Download a diagnostic report for troubleshooting">Diagnostics</button><button id="help-btn" class="quiet">Help <kbd>F1</kbd></button>
</header>
<nav class="actions" id="workspace-output" aria-label="File and view actions">
 <div class="action-group" data-action-label="Drawing"><button id="new-btn" title="New drawing · Ctrl+N">New</button><button id="open-btn" title="Open drawing · Ctrl+O">Open</button><button id="save-btn" class="primary" title="Download an editable project · Ctrl+S">Save project</button><button id="recovery-btn" type="button">Recovery</button><button id="save-as-btn" title="Choose file name and available CAD exchange format">Save As</button></div>
 <span class="divider"></span><div class="action-group" data-action-label="Output"><button id="example-btn">Example</button><button id="dxf-btn">DXF</button><button id="png-btn">PNG</button><button id="print-btn" title="Choose drawing area, paper, scale and output">Plot / Print</button></div>
 <span class="divider"></span><div class="action-group" data-action-label="History &amp; view"><button id="undo-btn" title="Undo · Ctrl+Z">↶ Undo</button><button id="redo-btn" title="Redo · Ctrl+Y">↷ Redo</button><button id="fit-btn" title="Zoom extents · Z">Fit drawing</button></div><button id="layers-toggle">Properties / Layers</button>
</nav>
<nav class="workspace-ribbon" aria-label="Workspace tool groups"><div class="workspace-tabs"><button type="button" id="workspace-tab-draw" data-workspace-tab="draw" class="is-current" aria-pressed="true">Draw</button><button type="button" id="workspace-tab-modify" data-workspace-tab="modify" aria-pressed="false">Modify</button><button type="button" id="workspace-tab-annotate" data-workspace-tab="annotate" aria-pressed="false">Annotate</button><button type="button" id="workspace-tab-output" data-workspace-tab="output" aria-pressed="false">Output</button></div><div class="ribbon-context" aria-live="polite"><strong id="workflow-name">Selection</strong><span id="workflow-guide">Pick objects or use a directional selection window.</span></div><button id="workflow-reference-btn" type="button" title="Open the practical command reference">Command reference</button></nav>
<div id="errors-banner" role="alert" hidden></div>
<main>
 <nav class="tools" aria-label="Drawing and editing tools">
  <details class="tool-group" data-workspace-group="draw" open><summary>Draw <span>01</span></summary><div class="tool-grid">
   <button data-tool="select" title="SELECT"><span>↖</span>Select</button><button data-tool="line" title="L / LINE"><span>╱</span>Line</button><button data-tool="polyline" title="PL / PLINE"><span>⌁</span>Polyline</button><button data-tool="rectangle" title="REC / RECTANGLE"><span>▭</span>Rectangle</button><button data-tool="circle" title="C / CIRCLE"><span>○</span>Circle</button><button data-tool="arc" title="A / ARC"><span>◠</span>Arc</button><button data-tool="text" title="T / TEXT"><span>A</span>Text</button><button data-tool="dimension" title="DIM"><span>↔</span>Aligned dim</button>
  </div></details>
  <details class="tool-group" data-workspace-group="modify" open><summary>Modify <span>02</span></summary><div class="tool-grid">
   <button data-tool="move" title="M / MOVE"><span>✣</span>Move</button><button data-tool="copy" title="CO / COPY"><span>▣</span>Copy</button><button data-tool="rotate" title="RO / ROTATE"><span>↻</span>Rotate</button><button data-tool="scale" title="SC / SCALE"><span>⤢</span>Scale</button><button data-tool="trim" title="TRIM"><span>⌿</span>Trim</button><button data-tool="extend" title="EXTEND"><span>⇥</span>Extend</button><button data-tool="offset" title="OFFSET"><span>∥</span>Offset</button><button data-tool="mirror" title="MIRROR"><span>◁▷</span>Mirror</button><button data-tool="fillet" title="FILLET"><span>╭</span>Fillet</button><button data-tool="chamfer" title="CHAMFER"><span>⌜</span>Chamfer</button><button data-tool="array" title="ARRAY"><span>▦</span>Rect. array</button><button data-tool="polararray" title="POLARARRAY"><span>✺</span>Polar array</button><button data-tool="explode" title="EXPLODE"><span>⤡</span>Explode</button><button data-tool="join" title="JOIN"><span>⌁</span>Join</button><button id="delete-btn" title="Erase selected objects · Delete"><span>×</span>Erase</button>
  </div></details>
  <details class="tool-group" data-workspace-group="annotate"><summary>Annotate <span>03</span></summary><div class="tool-grid">
   <button data-tool="distance" title="DISTANCE"><span>↔</span>Distance</button><button data-tool="angle" title="ANGLE"><span>∠</span>Angle</button><button data-tool="area" title="AREA"><span>▱</span>Area</button><button data-tool="dimlinear" title="DIMLINEAR"><span>↕</span>Linear dim</button><button data-tool="dimangular" title="DIMANGULAR"><span>∡</span>Angular dim</button><button data-tool="dimradius" title="DIMRADIUS"><span>R</span>Radius dim</button><button data-tool="dimdiameter" title="DIMDIAMETER"><span>Ø</span>Diameter dim</button>
  </div></details>
  <div class="tool-footer">Precise input<br><code>x,y</code> · <code>@dx,dy</code><br><code>@length&lt;angle</code></div>
 </nav>
 <section class="work-area" aria-label="Model workspace">
  <div class="workspace-head"><div class="workspace-title"><b>MODEL SPACE</b><span id="active-command" class="command-pill" role="status" aria-live="polite">SELECT</span><i>Top / World</i></div><div class="command-controls"><button id="finish-btn" type="button" title="Finish drawing or confirm the current command · Enter">Finish <kbd>Enter</kbd></button><button id="cancel-btn" type="button" title="Discard only the unconfirmed preview and stop · Esc">Stop <kbd>Esc</kbd></button><button id="select-btn" type="button" title="Discard the unconfirmed preview and return to object selection; completed objects remain">Select</button></div></div>
  <div class="selection-strip"><label for="selection-mode">Selection <select id="selection-mode" aria-label="Object selection mode"><option value="additive" selected>Add to selection</option><option value="replace">Replace selection</option></select></label><span id="selection-hint">Click to add · Shift+click to remove · L→R inside / R→L crossing</span></div>
  <div id="canvas-wrap"><canvas id="canvas" tabindex="0" aria-label="CAD drawing canvas"></canvas>
   <div id="welcome"><span class="welcome-kicker">DRAFT · REFINE · DOCUMENT</span><h1>Your drawing starts here.</h1><p>Open an existing drawing or start with precise points. Follow the command prompt to draw, edit, measure and prepare your output.</p><div><button id="welcome-line" class="primary">Draw a line</button><button id="welcome-example">Open example plan</button></div><small>Independent 2D drafting · Native projects + supported CAD exchange</small></div>
  </div>
  <div class="command-area"><div class="command-caption"><button id="history-toggle" type="button" aria-expanded="false" aria-controls="command-history" title="Expand or collapse command history">COMMAND HISTORY ▴</button><span id="draft-status">0 objects · no preview</span></div><div id="command-history" role="log" aria-label="Command history" aria-live="off" tabindex="0"></div><div id="status-log" role="status" aria-live="polite">Ready. Choose a tool, enter coordinates, or type HELP.</div><div id="prompt">Select objects: click an object or drag a selection window.</div><form id="command-form"><label for="command">Command</label><div class="command-input-wrap"><input id="command" dir="ltr" autocomplete="off" spellcheck="false" placeholder="LINE · length 100 · @100&lt;0 · 100,200" aria-label="Commands and coordinates" aria-autocomplete="list" aria-controls="suggestions" aria-expanded="false"><ul id="suggestions" role="listbox" aria-label="Command suggestions" hidden></ul></div><button id="repeat-btn" type="button" title="Repeat the last drawing or editing command">Repeat</button><button type="submit">Enter ↵</button></form></div>
 </section>
 <aside id="sidebar" class="sidebar" aria-label="Properties and layers">
  <div class="panel-title">Properties &amp; layers <span>2D / WCS</span></div>
  <div class="stats"><div><b id="entity-count">0</b><small>Objects</small></div><div><b id="selection-count">0</b><small>Selected</small></div></div>
  <details class="inspector-section" open><summary>Object properties</summary><div class="properties-form">
   <div class="property-type-row"><label>Object type</label><span id="property-type" aria-live="polite">No selection</span></div>
   <label for="property-layer">Layer</label><select id="property-layer" aria-label="Selected object layer"></select>
   <label class="checkbox-field" for="property-bylayer"><input id="property-bylayer" type="checkbox" checked> Use layer color (ByLayer)</label>
   <div class="property-pair"><label for="property-color">Object color<input id="property-color" type="color" value="#e5edf5"></label><label for="property-linewidth">Line width<input id="property-linewidth" type="number" min="0.1" max="100" step="0.1" value="1"></label></div>
   <label for="property-text">Text / dimension override</label><input id="property-text" type="text" maxlength="1000000" autocomplete="off" placeholder="&lt;&gt; keeps the measured value">
   <label for="property-height">Text height</label><input id="property-height" type="number" min="0.01" step="0.5" value="12">
   <fieldset id="dimension-properties"><legend>Dimension style</legend>
    <p class="field-hint">Adjust the selected dimensions, or save these settings as the defaults for new dimensions. Text height is set above.</p>
    <div class="dimension-grid"><label for="dim-scale">Overall scale<input id="dim-scale" type="number" min="0.001" step="any" value="1"></label><label for="dim-arrow-size">Arrow size<input id="dim-arrow-size" type="number" min="0.001" step="any" value="6"></label></div>
    <label for="dim-arrow-style">Arrow style</label><select id="dim-arrow-style"><option value="closed">Closed arrow</option><option value="open">Open arrow</option><option value="tick">Architectural tick</option></select>
    <div class="dimension-grid"><label for="dim-extension-offset">Extension offset<input id="dim-extension-offset" type="number" min="0" step="any" value="2"></label><label for="dim-extension-extend">Extension beyond line<input id="dim-extension-extend" type="number" min="0" step="any" value="4"></label></div>
    <div class="dimension-grid"><label for="dim-text-gap">Text gap<input id="dim-text-gap" type="number" min="0" step="any" value="3"></label><label for="dim-precision">Decimal places<input id="dim-precision" type="number" min="0" max="8" step="1" value="2"></label></div>
    <div class="dimension-grid"><label for="dim-prefix">Prefix<input id="dim-prefix" type="text" maxlength="128" value=""></label><label for="dim-suffix">Suffix<input id="dim-suffix" type="text" maxlength="128" value=""></label></div>
    <div class="dimension-color-row"><label for="dim-line-color">Line color<input id="dim-line-color" type="color" value="#e5edf5"></label><label class="checkbox-field" for="dim-line-bylayer"><input id="dim-line-bylayer" type="checkbox" checked> Inherit object color</label></div>
    <div class="dimension-color-row"><label for="dim-text-color">Text color<input id="dim-text-color" type="color" value="#e5edf5"></label><label class="checkbox-field" for="dim-text-bylayer"><input id="dim-text-bylayer" type="checkbox" checked> Inherit object color</label></div>
    <button id="dim-defaults-btn" type="button">Use as dimension defaults</button>
   </fieldset>
   <button id="apply-properties">Apply changed properties</button><small class="field-hint">Only fields you change are applied. Unchanged properties are preserved across a mixed selection.</small>
  </div></details>
  <details class="inspector-section" open><summary>Layers</summary><div class="layer-panel">
   <label class="field-label" for="layer-select">Current layer</label><select id="layer-select" aria-label="Current drawing layer"></select>
   <div class="layer-options"><label>Layer color <input id="layer-color" type="color" value="#e5edf5"></label><button id="layer-visibility">Hide</button><button id="layer-lock">Lock</button></div>
   <p id="layer-state" class="field-hint" role="status">Ready to draw on 0</p><button id="unlock-visible-layers" type="button" title="Unlock visible layers so their existing objects can be selected and edited. Undo restores the locks.">Unlock visible layers</button>
   <div class="new-layer"><input id="layer-name" maxlength="80" placeholder="New layer name" aria-label="New layer name"><button id="add-layer-btn" aria-label="Add layer">+</button></div><div id="layer-list" class="layer-list"></div>
  </div></details>
  <div class="panel-note"><b>Keep the editable project</b><p>Save project preserves your editable drawing as <code>.rasm.json</code>. Save As offers file-name and format choices. Keep a native project alongside exchange outputs.</p></div>
  <div class="panel-note shortcuts"><b>Navigation</b><p>Wheel: zoom<br>Middle drag: pan<br>Right-click / blank Enter: finish<br>Esc: discard unconfirmed preview<br>Shift+click: remove from selection<br>Delete: erase selected</p></div>
 </aside>
</main>
<footer><div id="coordinates" dir="ltr">X 0.00 · Y 0.00</div><div class="toggles"><button id="grid-btn" aria-pressed="true">GRID</button><button id="snap-btn" aria-pressed="true">OSNAP</button><button id="ortho-btn" aria-pressed="false">ORTHO</button></div><span class="units">Decimal drawing units <span>TOP / WCS</span></span></footer>
<input id="file-input" type="file" accept=".json,.rcad,.dxf,.dwg,.dwt,.dws,.bak,.sv$" hidden>
<dialog id="workflow-reference" class="advanced-dialog workflow-reference"><div class="dialog-head"><div><span class="dialog-kicker">Practical 2D workflows</span><h2>Command reference</h2></div><button id="workflow-reference-close" type="button" aria-label="Close command reference">×</button></div><p>Choose a command below. The drawing prompt shows the options available at the current step. Enter confirms a value or ends a repeated command; Esc keeps completed edits.</p><div id="workflow-reference-list" class="workflow-reference-list"></div><p class="field-hint">Commands have different selection and point stages. Only the options named in the active prompt are accepted. This reference describes implemented workflows.</p></dialog>
<dialog id="help-dialog"><div class="dialog-head"><div><span class="dialog-kicker">RasmCAD Advanced 0.9-dev</span><h2>Drawing and commands</h2></div><button id="help-close" aria-label="Close help">×</button></div>
 <p>Choose a tool and follow the green command prompt: it names the next point or value needed. Coordinates use <code>100,200</code>, relative offsets use <code>@50,0</code>, and relative distance/angle uses <code>@100&lt;45</code>. Angles are in degrees, counterclockwise from the positive X axis. For a line, pick the start point, move the cursor to set the direction, type a length such as <code>100</code>, and press Enter to commit that segment. Press Enter again, right-click, or use Finish to end connected lines. A circle finishes after a radius point or a positive numeric radius. You can also press, drag and release to create a single line, circle or rectangle; a line drawn in one stroke ends automatically. Stop, Esc or Select discards only the unconfirmed preview: a line endpoint or circle radius must be clicked, entered as a value, or completed by releasing a drawing stroke before it becomes a permanent object. Completed objects remain. The object count tracks committed drawing objects; a preview is shown separately.</p>
 <table><thead><tr><th>Task</th><th>Command</th><th>Workflow</th></tr></thead><tbody>
 <tr><td>Line / polyline</td><td><code>L / PL</code></td><td>Pick successive points, or aim the cursor and enter a length. Finish / Enter / right-click or double-click ends the command. U removes the last segment/vertex; C closes the path.</td></tr><tr><td>Rectangle / circle</td><td><code>REC / C</code></td><td>Rectangle: opposite corners. Circle: center then radius; D chooses diameter after the center. Enter 2P or 3P before picking for diameter endpoints or three circumference points.</td></tr><tr><td>Arc / text</td><td><code>A / T</code></td><td>Arc: CENTER uses center/start/end direction; 3P uses three circumference points. Text: insertion point, then type the text.</td></tr><tr><td>Move / copy</td><td><code>M / CO</code></td><td>Select objects, confirm, then pick base and destination points. COPY supports Single/Multiple, Array/Fit, and U. MOVE supports Displacement.</td></tr><tr><td>Rotate / scale</td><td><code>RO / SC</code></td><td>Select objects, choose a base point, then enter an angle or positive scale factor. R / Reference uses a known angle or length and a target value.</td></tr><tr><td>Trim / extend</td><td><code>TRIM / EXTEND</code></td><td>Follow the prompt to identify a boundary and the line segment to modify.</td></tr><tr><td>Offset / mirror</td><td><code>OFFSET / MIRROR</code></td><td>Offset creates a parallel copy at a distance; mirror uses a two-point reflection axis. Enter KEEP or DELETE before the axis to choose source handling.</td></tr><tr><td>Fillet / chamfer</td><td><code>FILLET / CHAMFER</code></td><td>Use two intersecting line objects with a radius or setback distance.</td></tr><tr><td>Arrays</td><td><code>ARRAY / POLARARRAY</code></td><td>Select geometry, then enter the counts, spacing or rotation requested by the prompt.</td></tr><tr><td>Explode / join</td><td><code>EXPLODE / JOIN</code></td><td>Explode separates supported composite geometry; dimension arrow outlines and primitive colors remain, but filled arrow areas are not independent fill objects. Join connects compatible line geometry.</td></tr><tr><td>Measurements</td><td><code>DISTANCE / ANGLE / AREA</code></td><td>Pick the requested points or supported geometry. Read the result in the command area.</td></tr><tr><td>Aligned dimension</td><td><code>DIM</code></td><td>Pick two measurement points, then the position of the dimension line.</td></tr><tr><td>View / history</td><td><code>Z / U / REDO</code></td><td>Fit the drawing / undo / redo. Wheel zooms; middle-button drag pans.</td></tr>
 </tbody></table>
 <p><b>Selection:</b> clicks add objects by default. Shift+click removes an object; Ctrl+click adds it. Use the Selection menu to switch to Replace selection. Drag left to right to select objects entirely inside the window; drag right to left to select objects that cross the window. Start Move, Copy or another edit command, pick the objects when prompted, and press Enter to confirm the selection.</p>
 <p><b>Command line:</b> start typing an English command to see suggestions. Tab fills the first match; arrow keys select a suggestion. Enter submits the typed value, or the suggestion explicitly selected with an arrow key. Up/Down recall earlier input when suggestions are closed. Command history keeps previous inputs and results. Repeat starts the last tool again. Select returns to object picking. Diagnostics downloads a report when troubleshooting an unexpected result.</p>
 <p><b>Properties:</b> select objects, change the fields you need, and click Apply changed properties. ByLayer inherits the layer color. Fields you do not change stay intact for each object in a mixed selection.</p>
 <p><b>Dimension styles:</b> select a dimension and set text height, overall scale, arrow size/style, extension-line offset/extension, text gap, precision, prefix/suffix, and separate line/text colors. Inherit object color follows the dimension object color, including its ByLayer setting; uncheck it for an explicit line or text color. Without custom defaults, new dimensions start with a readable text height calculated from the current zoom, stored in drawing units. In Text / dimension override, <code>&lt;&gt;</code> inserts the measured value: for example <code>L=&lt;&gt; mm</code>. Overall scale changes annotation appearance, not the measured value. Use as dimension defaults applies these settings to dimensions you draw afterward; Apply changed properties edits the selected dimensions.</p>
 <p><b>Shortcuts:</b> Ctrl+S save project · Ctrl+O open · Ctrl+N new · Ctrl+Z undo · Ctrl+Y redo · Delete erase · Enter/right-click finish · Esc cancel · F1 help. Drawing toggles appear in the status bar.</p>
 <p><b>Advanced 2D:</b> expand Advanced 2D in the left tools or type a command. STRETCH takes two crossing-window corners, then base/destination. BREAK takes two cut points on a selected object. LENGTHEN, ALIGN, PEDIT and SPLINEDIT show operation forms. SPLINE creates an editable interpolating curve. HATCH takes selected closed boundaries or a picked interior, with SOLID/ANSI31/CROSS patterns; HATCHEDIT changes its settings. REGION creates planar polygonal regions. BLOCK and INSERT retain reusable definitions; BEDIT/REFEDIT stage edits until BCLOSE SAVE or CANCEL. ATTDEF manages definitions and ATTEDIT instance values. WBLOCK exports a native block project. DIMSTYLE manages named rendered styles; DIMCONTINUE, DIMBASELINE, DIMORDINATE, DIMEDIT and MLEADER extend annotations. OSNAPSET enables intersection, perpendicular, tangent and nearest modes. Perpendicular and tangent require a first/base point.</p>
 <p><b>Vector PDF:</b> Plot vector PDF opens paper, orientation, drawing-unit, scale 1:N and plot-window settings. The PDF contains vector geometry and embedded substitute-font text. Print that PDF at Actual size / 100% to preserve the selected scale. Source SHX fonts and complex text shaping may differ.</p>
 <p><b>New workflows:</b> SELECT FENCE / WPOLYGON / CPOLYGON, QSELECT and SELECTPREVIOUS improve selection. PLINE accepts A for a three-point arc, L for straight segments and WIDTH start,end. DIMASSOC links a selected dimension to a selected line or circle; STATUS and REMOVE inspect or detach it. PLOT includes saved page setups, scaled layout viewports and multi-sheet PDF. RECOVERY is optional local browser storage.</p><p><b>Files and layers:</b> Open reads supported DWG and ASCII/binary DXF locally. DWG-based DWT/DWS templates, BAK and SV$ backups are recognized by their file contents. After import, Continue drawing closes the report. The active drawing layer is visible and unlocked; source layer states are preserved. Use Layers → Unlock visible layers to edit objects on deliberately locked source layers; Undo restores their locks. Export DXF downloads supported editable geometry for CAD exchange. Save project downloads a native <code>.rasm.json</code> file; optional local recovery is available through Recovery. Save As also offers experimental DWG2000 exchange with geometry readback; polylines, blocks, hatches and dimensions export as visible independent geometry. Keep a native project for full editability. Keep the downloaded project to continue editing. Review import notices for unsupported content. A file's release label and its underlying DWG/DXF format version are separate.</p><p class="limit-note">An independent 2D CAD application. Full visual fidelity across all AutoCAD formats is not established. DWF/DWFx, DGN, advanced entities, imported paper-space layouts and 3D workflows are not supported as complete systems. RasmCAD plot layouts support multiple scaled viewports and batch PDF. Managed-device security policies still apply.</p>
</dialog>
<dialog id="import-report"><div class="dialog-head"><div><span class="dialog-kicker">File exchange</span><h2>Import report</h2></div><button id="import-report-close" aria-label="Close import report">×</button></div><p>The current drawing layer is ready for new objects. Source layer visibility and real locks are preserved. Use Unlock visible layers to edit objects on intentionally locked layers. Review any skipped or approximated content below.</p><pre id="import-report-content" tabindex="0"></pre><div class="import-actions"><button id="import-continue" type="button" class="primary">Continue drawing</button><button id="import-unlock-layers" type="button" hidden>Unlock visible layers</button></div></dialog>
<script>/* RasmCAD Browser: independent dependency-free 2D document and geometry core. */
(function (root, factory) {
  'use strict';
  const api = factory();
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.RasmCore = api;
})(typeof globalThis !== 'undefined' ? globalThis : this, function () {
  'use strict';
  const PI = Math.PI, TAU = PI * 2;
  const MAX_FILE = 64 * 1024 * 1024, MAX_ENTITIES = 100000;
  const MAX_POINTS = 100000, MAX_TOTAL_POINTS = 1000000, MAX_LAYERS = 4096;
  const MAX_COORD = 1e12, HISTORY_BUDGET = 16 * 1024 * 1024;
  const KINDS = new Set(['line', 'polyline', 'circle', 'arc', 'text', 'dimension', 'compound', 'solid']);
  const OWN = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
  const get = (o, k, fallback) => OWN(o, k) ? o[k] : fallback;
  function requireValue(condition, message) { if (!condition) throw new Error(message); }
  function object(value, label) {
    requireValue(value !== null && typeof value === 'object' && !Array.isArray(value), label + ' must be an object');
    return value;
  }
  function number(value, label) {
    requireValue(typeof value === 'number' && Number.isFinite(value) && Math.abs(value) <= MAX_COORD, 'Invalid ' + label);
    return value;
  }
  function positive(value, label) { number(value, label); requireValue(value > 0, label + ' must be positive'); return value; }
  function nonnegative(value, label) { number(value, label); requireValue(value >= 0, label + ' must not be negative'); return value; }
  function identifier(value, label) {
    requireValue(Number.isSafeInteger(value) && value > 0 && value < Number.MAX_SAFE_INTEGER, 'Invalid ' + label); return value;
  }
  function bool(value, label) { requireValue(typeof value === 'boolean', 'Invalid ' + label); return value; }
  function string(value, limit, label, emptyAllowed) {
    requireValue(typeof value === 'string' && (emptyAllowed || value.length > 0) && value.length <= limit, 'Invalid ' + label + ' length');
    requireValue(!/[\u0000\r\n]/.test(value), 'Invalid control character in ' + label);
    // Reject unpaired UTF-16 surrogates so downloads preserve text faithfully.
    for (let i = 0; i < value.length; i++) {
      const c = value.charCodeAt(i);
      if (c >= 0xD800 && c <= 0xDBFF) { requireValue(i + 1 < value.length && value.charCodeAt(i + 1) >= 0xDC00 && value.charCodeAt(i + 1) <= 0xDFFF, 'Invalid Unicode in ' + label); i++; }
      else requireValue(c < 0xDC00 || c > 0xDFFF, 'Invalid Unicode in ' + label);
    }
    return value;
  }
  function color(value, byLayer) {
    if (byLayer && value === null) return null;
    requireValue(typeof value === 'string' && /^#[\da-f]{6}$/i.test(value), 'Invalid color'); return value.toLowerCase();
  }
  function point(value) { object(value, 'Point'); return { x: number(get(value, 'x'), 'X coordinate'), y: number(get(value, 'y'), 'Y coordinate') }; }
  const add = (a, b) => ({ x: a.x + b.x, y: a.y + b.y });
  const sub = (a, b) => ({ x: a.x - b.x, y: a.y - b.y });
  const mul = (a, s) => ({ x: a.x * s, y: a.y * s });
  const distance = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
  const normalizedAngle = a => ((a % TAU) + TAU) % TAU;
  function arcSpan(start, end) { const span = normalizedAngle(end - start); return span < 1e-12 ? TAU : span; }
  function onArc(a, start, end) { const delta=normalizedAngle(a-start);return delta<=arcSpan(start,end)+1e-10||TAU-delta<=1e-10; }
  function normalizedLayer(raw) {
    object(raw, 'Layer');
    return { name: string(get(raw, 'name'), 255, 'layer name', false), color: color(get(raw, 'color', '#e5edf5'), false),
      visible: bool(get(raw, 'visible', true), 'layer visibility'), locked: bool(get(raw, 'locked', false), 'layer lock') };
  }
  const COMPOUND_TYPES = new Set(['hatch','region','block','spline','leader','polyline','plotViewport']);
  function jsonData(value, depth = 0, budget = {nodes:0}, path = new Set()) {
    requireValue(depth <= 32 && ++budget.nodes <= 2000000, 'Metadata exceeds complexity limit');
    if(value===null||typeof value==='boolean')return value;
    if(typeof value==='number')return number(value,'metadata number');
    if(typeof value==='string'){requireValue(value.length<=1000000&&!value.includes('\0'),'Invalid metadata string');return value;}
    requireValue(value&&typeof value==='object'&&!path.has(value),'Invalid or cyclic metadata');path.add(value);
    let result;
    if(Array.isArray(value)){requireValue(value.length<=MAX_TOTAL_POINTS,'Metadata array is too large');result=value.map(v=>jsonData(v,depth+1,budget,path));}
    else {const keys=Object.keys(value);requireValue(keys.length<=100000,'Metadata object is too large');result={};for(const key of keys){requireValue(key.length<=255,'Metadata key is too long');Object.defineProperty(result,key,{value:jsonData(value[key],depth+1,budget,path),enumerable:true,writable:true,configurable:true});}}
    path.delete(value);return result;
  }
  function normalizedResources(raw) {
    const resources=jsonData(raw===undefined?{}:object(raw,'Resources'));
    for(const key of ['blocks','dimStyles','plot'])if(!OWN(resources,key))resources[key]={};
    for(const key of ['blocks','dimStyles','plot'])object(resources[key],key+' resources');
    return resources;
  }
  function resourcePointCount(value,depth=0,path=new Set()){
    if(value===null||typeof value!=='object')return 0;
    requireValue(depth<=32&&!path.has(value),'Invalid or cyclic resources');path.add(value);
    let count=!Array.isArray(value)&&OWN(value,'x')&&OWN(value,'y')?1:0;
    for(const child of Object.values(value)){count+=resourcePointCount(child,depth+1,path);requireValue(count<=MAX_TOTAL_POINTS,'Resources have too many points');}
    path.delete(value);return count;
  }
  function entityMetrics(e) {let points=e.points.length+(e.data?.loops||[]).reduce((sum,loop)=>sum+loop.length,0)+(e.data?.paths||[]).reduce((sum,path)=>sum+path.length,0),entities=1;for(const part of e.parts||[]){const n=entityMetrics(part);points+=n.points;entities+=n.entities;}return{points,entities};}
  function normalizedEntity(raw, defaultLayer, assignedId, depth = 0, budget = {points:0,entities:0}) {
    requireValue(depth<=4&&++budget.entities<=MAX_ENTITIES,'Compound nesting or entity limit exceeded');
    object(raw, 'Entity'); const kind = get(raw, 'kind'); requireValue(KINDS.has(kind), 'Unsupported entity kind');
    const rawPoints = get(raw, 'points'); requireValue(Array.isArray(rawPoints) && rawPoints.length <= MAX_POINTS, 'Invalid entity point array');
    const dimensionStyle = kind === 'dimension' ? get(raw, 'dimensionStyle', 'aligned') : 'aligned';
    if (kind === 'dimension') requireValue(['aligned','horizontal','vertical','angular','radius','diameter','ordinateX','ordinateY'].includes(dimensionStyle), 'Unknown dimension style');
    const needed = kind === 'line' || kind === 'polyline' ? 2 : kind === 'solid' ? 3 : kind === 'dimension' ? (dimensionStyle === 'angular' ? 4 : 3) : 1;
    requireValue(rawPoints.length >= needed && (['polyline','compound'].includes(kind) || kind==='solid'&&rawPoints.length<=4 || rawPoints.length === needed), 'Unexpected entity point count');
    budget.points+=rawPoints.length;requireValue(budget.points<=MAX_TOTAL_POINTS,'Document has too many points');
    const e = { id: identifier(assignedId === undefined ? get(raw, 'id') : assignedId, 'entity ID'), kind,
      points: rawPoints.map(point), radius: number(get(raw, 'radius', 0), 'radius'),
      startAngle: number(get(raw, 'startAngle', 0), 'start angle'), endAngle: number(get(raw, 'endAngle', 0), 'end angle'),
      closed: bool(get(raw, 'closed', false), 'polyline closure'), text: string(get(raw, 'text', ''), 1000000, 'text', true),
      textHeight: positive(get(raw, 'textHeight', 12), 'text height'), layer: string(get(raw, 'layer', defaultLayer || '0'), 255, 'layer name', false),
      color: color(get(raw, 'color', null), true), lineWidth: positive(get(raw, 'lineWidth', 1), 'line width') };
    if(kind==='solid')e.closed=true;
    if(kind==='compound'){
      e.subtype=get(raw,'subtype');requireValue(COMPOUND_TYPES.has(e.subtype),'Unknown compound subtype');
      const parts=get(raw,'parts',[]);requireValue(Array.isArray(parts)&&parts.length<=MAX_ENTITIES,'Invalid compound parts');
      e.parts=parts.map((part,index)=>normalizedEntity(part,e.layer,index+1,depth+1,budget));
      e.data=jsonData(get(raw,'data',{}));object(e.data,'Compound metadata');
      if(e.data.loops!==undefined){requireValue(Array.isArray(e.data.loops)&&e.data.loops.length<=MAX_POINTS,'Invalid compound loops');e.data.loops=e.data.loops.map(loop=>{requireValue(Array.isArray(loop)&&loop.length>=3&&loop.length<=MAX_POINTS,'Invalid boundary loop');budget.points+=loop.length;requireValue(budget.points<=MAX_TOTAL_POINTS,'Document has too many points');return loop.map(point);});}
      if(e.data.paths!==undefined){requireValue(Array.isArray(e.data.paths)&&e.data.paths.length<=MAX_POINTS,'Invalid leader paths');e.data.paths=e.data.paths.map(path=>{requireValue(Array.isArray(path)&&path.length>=2&&path.length<=MAX_POINTS,'Invalid leader path');budget.points+=path.length;requireValue(budget.points<=MAX_TOTAL_POINTS,'Document has too many points');return path.map(point);});}
      if(e.data.textPoint!==undefined)e.data.textPoint=point(e.data.textPoint);
      if(e.data.matrix!==undefined)requireValue(Array.isArray(e.data.matrix)&&e.data.matrix.length===6&&e.data.matrix.every(v=>typeof v==='number'&&Number.isFinite(v)&&Math.abs(v)<=MAX_COORD),'Invalid block transform matrix');
    }
    if (kind === 'dimension') {
      if(OWN(raw,'styleName'))e.styleName=string(raw.styleName,255,'dimension style name',false);
      e.dimensionStyle = dimensionStyle;
      e.dimensionScale = positive(get(raw, 'dimensionScale', 1), 'dimension scale');
      e.arrowSize = positive(get(raw, 'arrowSize', e.textHeight * .6), 'arrow size');
      e.extensionOffset = nonnegative(get(raw, 'extensionOffset', e.textHeight * .15), 'extension offset');
      e.extensionExtend = nonnegative(get(raw, 'extensionExtend', e.textHeight * .25), 'extension extension');
      e.textGap = nonnegative(get(raw, 'textGap', e.textHeight * .35), 'text gap');
      e.precision = get(raw, 'precision', 2);
      requireValue(Number.isInteger(e.precision) && e.precision >= 0 && e.precision <= 8, 'Dimension precision must be an integer from 0 to 8');
      e.prefix = string(get(raw, 'prefix', ''), 128, 'dimension prefix', true);
      e.suffix = string(get(raw, 'suffix', ''), 128, 'dimension suffix', true);
      e.textColor = color(get(raw, 'textColor', null), true);
      e.dimensionColor = color(get(raw, 'dimensionColor', null), true);
      e.arrowStyle = get(raw, 'arrowStyle', 'closed');
      requireValue(['closed','open','tick'].includes(e.arrowStyle), 'Unknown dimension arrow style');
      annotationGeometry(e);
    }
    if (kind === 'circle' || kind === 'arc') positive(e.radius, 'radius');
    return e;
  }
  function validateEntity(e) { normalizedEntity(e, '0', get(e, 'id', 1) || 1); return true; }
  function validateState(raw) {
    object(raw, 'Document');
    const rawLayers = get(raw, 'layers'), rawEntities = get(raw, 'entities');
    requireValue(Array.isArray(rawLayers) && rawLayers.length > 0 && rawLayers.length <= MAX_LAYERS, 'Invalid layer count');
    requireValue(Array.isArray(rawEntities) && rawEntities.length <= MAX_ENTITIES, 'Invalid entity count');
    const layers = rawLayers.map(normalizedLayer), names = new Set();
    for (const layer of layers) { requireValue(!names.has(layer.name), 'Duplicate layer name'); names.add(layer.name); }
    const currentLayer = string(get(raw, 'currentLayer'), 255, 'current layer', false);
    requireValue(names.has(currentLayer), 'Current layer does not exist');
    const entities = [], ids = new Set(),budget={points:0,entities:0}; let maxId = 0, pointCount = 0;
    for (const rawEntity of rawEntities) {
