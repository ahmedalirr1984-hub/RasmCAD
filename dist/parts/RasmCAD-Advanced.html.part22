function createSpline(points,options={}){check(Array.isArray(points)&&points.length>=2&&points.length<=2048,'SPLINE requires 2..2048 control points');points=points.map(p=>({...point(p)}));const closed=!!options.closed;check(!closed||points.length>=3,'A closed spline needs at least three control points');const tension=options.tension??0,samples=options.samples??16;finite(tension);check(tension>=0&&tension<=1,'Tension must be between 0 and 1');check(Number.isInteger(samples)&&samples>=4&&samples<=64,'Spline samples must be 4..64');const n=points.length;check((closed?n:n-1)*samples+(closed?0:1)<=100000,'Spline tessellation exceeds 100,000 points');const out=[],get=i=>points[closed?(i%n+n)%n:Math.max(0,Math.min(n-1,i))];for(let i=0;i<(closed?n:n-1);i++){const a=get(i),b=get(i+1),ta=mul(sub(get(i+1),get(i-1)),(1-tension)/2),tb=mul(sub(get(i+2),get(i)),(1-tension)/2);for(let j=0;j<samples;j++){const t=j/samples,t2=t*t,t3=t2*t;out.push(add(add(mul(a,2*t3-3*t2+1),mul(ta,t3-2*t2+t)),add(mul(b,-2*t3+3*t2),mul(tb,t3-t2))));}}if(!closed)out.push({...points.at(-1)});return {kind:'compound',subtype:'spline',points,parts:[{kind:'polyline',points:out,closed,layer:options.layer||'0',color:options.color??null,lineWidth:options.lineWidth||1}],data:{tension,samples,closed},layer:options.layer||'0',color:options.color??null,lineWidth:options.lineWidth||1};}
function splineEdit(doc,id,action,value){action=String(action).toUpperCase();return transaction(doc,w=>{const e=list(w,[id])[0];check(e.kind==='compound'&&e.subtype==='spline','Select an editable native spline');const points=clone(e.points),options={...e.data,layer:e.layer,color:e.color,lineWidth:e.lineWidth};if(action==='REVERSE')points.reverse();else if(action==='CLOSE')options.closed=true;else if(action==='OPEN')options.closed=false;else if(action==='TENSION')options.tension=value;else if(['VERTEX','INSERT','DELETE'].includes(action)){const i=typeof value==='number'?value:value?.index;check(Number.isInteger(i)&&i>=0&&i<points.length,'Invalid spline control-point index');if(action==='DELETE'){check(points.length>2,'A spline needs at least two control points');points.splice(i,1);}else{const p=point(value.point||value);if(action==='VERTEX')points[i]={...p};else points.splice(i+1,0,{...p});}}else throw Error('SPLINEDIT options: VERTEX, INSERT, DELETE, TENSION, REVERSE, CLOSE, OPEN');return replace(w,e,[{...e,...createSpline(points,options)}]);});}
function style(e){return JSON.stringify([e.kind,e.layer,e.color,e.lineWidth,e.textHeight,e.text,e.dimensionStyle,e.data||null]);}
function samePoints(a,b,tol,closed){if(a.length!==b.length)return false;const match=(q,offset)=>a.every((p,i)=>dist(p,q[(i+offset)%q.length])<=tol);for(const q of [b,[...b].reverse()]){if(!closed){if(match(q,0))return true;}else for(let offset=0;offset<q.length;offset++)if(match(q,offset))return true;}return false;}
function duplicate(a,b,tol){if(style(a)!==style(b)||a.closed!==b.closed)return false;if(a.kind==='line'||a.kind==='polyline')return samePoints(a.points,b.points,tol,a.closed);if(a.kind==='circle')return dist(a.points[0],b.points[0])<=tol&&Math.abs(a.radius-b.radius)<=tol;if(a.kind==='arc')return dist(a.points[0],b.points[0])<=tol&&Math.abs(a.radius-b.radius)<=tol&&Math.abs(Math.atan2(Math.sin(a.startAngle-b.startAngle),Math.cos(a.startAngle-b.startAngle)))<=tol/Math.max(1,a.radius)&&Math.abs(C.arcSpan(a.startAngle,a.endAngle)-C.arcSpan(b.startAngle,b.endAngle))<=tol/Math.max(1,a.radius);if(a.kind==='text')return dist(a.points[0],b.points[0])<=tol&&Math.abs(a.startAngle-b.startAngle)<=1e-9;return false;}
function overkill(doc,ids,tolerance=1e-7){finite(tolerance);check(tolerance>0,'Tolerance must be positive');return transaction(doc,w=>{let es=list(w,ids);check(es.length<=3000,'OVERKILL supports up to 3,000 selected objects per pass');const removed=new Set();for(let i=0;i<es.length;i++){const a=es[i];if(removed.has(a.id))continue;for(let j=i+1;j<es.length;j++){const b=es[j];if(removed.has(b.id))continue;if(duplicate(a,b,tolerance)){removed.add(b.id);continue;}if(a.kind!=='line'||b.kind!=='line'||style(a)!==style(b))continue;const v=sub(a.points[1],a.points[0]),l=Math.hypot(v.x,v.y);if(l<=EPS)continue;const u=mul(v,1/l);if(b.points.some(p=>Math.abs(cross(sub(p,a.points[0]),u))>tolerance))continue;const t=b.points.map(p=>dot(sub(p,a.points[0]),u)).sort((x,y)=>x-y);if(t[1]<-tolerance||t[0]>l+tolerance)continue;const origin=a.points[0];a.points=[add(origin,mul(u,Math.min(0,t[0]))),add(origin,mul(u,Math.max(l,t[1])))];removed.add(b.id);j=i;}}w.erase([...removed]);return es.filter(e=>!removed.has(e.id)).map(e=>e.id);});}
function explode(doc,ids){return transaction(doc,w=>{const es=list(w,ids),result=[];for(const e of es){let parts=[];if(e.kind==='compound')parts=clone(e.parts);else if(e.kind==='solid'){for(let i=0;i<e.points.length;i++)parts.push({kind:'line',points:[e.points[i],e.points[(i+1)%e.points.length]]});}else if(e.kind==='polyline'){for(let i=1;i<e.points.length;i++)parts.push({kind:'line',points:[e.points[i-1],e.points[i]]});if(e.closed)parts.push({kind:'line',points:[e.points.at(-1),e.points[0]]});}else if(e.kind==='dimension'){const g=C.annotationGeometry(e);parts=[...g.segments.map(s=>({kind:'line',points:[s.a,s.b],color:s.color??e.color})),...g.arcs.map(a=>({kind:'arc',points:[a.center],radius:a.radius,startAngle:a.startAngle,endAngle:a.endAngle,color:a.color??e.color})),...g.labels.map(l=>({kind:'text',points:[l.point],text:l.text,textHeight:l.height,startAngle:l.angle,color:l.color??e.color})),...g.fills.map(f=>({kind:'solid',points:f.points,color:f.color??e.color}))];}else throw Error('EXPLODE supports polylines, dimensions, compounds and solids');check(parts.length,'No geometry to explode');parts=parts.map(p=>({...p,layer:p.layer||e.layer,color:p.color===undefined?e.color:p.color,lineWidth:p.lineWidth||e.lineWidth}));result.push(...replace(w,e,parts));}return result;});}
return Object.freeze({stretch,breakEntity,lengthen,align,pedit,createSpline,splineEdit,overkill,explode});
});
</script><script>/* Independent planar boundaries, regions and clipped editable hatch geometry. */
(function(root,factory){
  'use strict';
  if(typeof module==='object'&&module.exports)module.exports=factory(require('./core.js'),require('./editing.js'));
  else root.RasmHatch=factory(root.RasmCore,root.RasmEdit);
})(typeof globalThis!=='undefined'?globalThis:this,function(C,E){
  'use strict';
  const EPS=1e-7,MAX_SEGMENTS=1200,MAX_PARTS=20000,MAX_VERTICES=4096,TAU=2*Math.PI;
  const clone=x=>JSON.parse(JSON.stringify(x)),dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
  const cross=(a,b,c)=>(b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x);
  function check(value,message){if(!value)throw Error(message);}
  function point(p){check(p&&Number.isFinite(p.x)&&Number.isFinite(p.y)&&Math.abs(p.x)<=1e12&&Math.abs(p.y)<=1e12,'Boundary contains an invalid coordinate.');return{x:p.x,y:p.y};}
  function tolerance(points){let m=1;for(const p of points)m=Math.max(m,Math.abs(p.x),Math.abs(p.y));return EPS+Number.EPSILON*m*2;}
  function signedArea(loop){const o=loop[0];let sum=0;for(let i=0;i<loop.length;i++){const a=loop[i],b=loop[(i+1)%loop.length];sum+=(a.x-o.x)*(b.y-o.y)-(a.y-o.y)*(b.x-o.x);}return sum/2;}
  function onSegment(p,a,b,t=EPS){const length=dist(a,b);if(length<=t)return dist(p,a)<=t;return Math.abs(cross(a,b,p))/length<=t&&(p.x-a.x)*(p.x-b.x)+(p.y-a.y)*(p.y-b.y)<=t*length;}
  function contains(loop,p,includeEdge=true){let odd=false;const t=tolerance([p,...loop]);for(let i=0,j=loop.length-1;i<loop.length;j=i++){
    const a=loop[j],b=loop[i];if(onSegment(p,a,b,t))return includeEdge;
    if((a.y>p.y)!==(b.y>p.y)&&(b.x-a.x)*(p.y-a.y)/(b.y-a.y)>p.x-a.x)odd=!odd;
  }return odd;}
  function inside(loops,p){let odd=false;for(const loop of loops)if(contains(loop,p,false))odd=!odd;return odd;}
  function cleanLoop(raw){
    check(Array.isArray(raw)&&raw.length>=3&&raw.length<=MAX_VERTICES,'Boundary needs 3–4096 vertices.');
    const loop=[],t=tolerance(raw);for(const p of raw){const q=point(p);if(!loop.length||dist(q,loop.at(-1))>t)loop.push(q);}
    if(loop.length>1&&dist(loop[0],loop.at(-1))<=t)loop.pop();
    check(loop.length>=3&&Math.abs(signedArea(loop))>t*t,'Boundary has zero area.');return loop;
  }
