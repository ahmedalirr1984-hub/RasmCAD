function instance(d,n,m,layer='0',provided={},prior={},depth=0){
 check(depth<MAX_DEPTH,'Block nesting exceeds '+MAX_DEPTH+' levels');const def=lookup(d,n);m=matrix(m);const vals=valuesFor(def,provided,prior,true),parts=[];
