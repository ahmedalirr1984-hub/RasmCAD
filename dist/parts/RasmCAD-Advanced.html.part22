      edges.sort((a,b)=>a.x-b.x);check(edges.length%2===0,'Invalid solid-fill boundary.');
      const at=(e,y)=>({x:e.a.x+(y-e.a.y)*(e.b.x-e.a.x)/(e.b.y-e.a.y),y});
