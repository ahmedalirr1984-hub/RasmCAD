 warnings.push('Embedded DejaVu text substitutes source CAD fonts; complex shaping and unsupported glyphs may differ.');
 return {paper,orientation,widthMm,heightMm,marginMm,drawableWidthMm,drawableHeightMm,units,unitMm,area,bounds,fit,scale,fitScale,plottedWidthMm,plottedHeightMm,centered,originMm,factor,lineWidthMm,monochrome:options.monochrome!==false,useLineweights:options.useLineweights!==false,clipped,warnings,toPage};
}
function rgb(hex){return[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)/255);}
function bytes(s){return new TextEncoder().encode(s);}
function join(chunks){const result=new Uint8Array(chunks.reduce((sum,v)=>sum+v.length,0));let at=0;for(const chunk of chunks){result.set(chunk,at);at+=chunk.length;}return result;}
function fromBase64(s){if(typeof Buffer!=='undefined')return new Uint8Array(Buffer.from(s,'base64'));return Uint8Array.from(atob(s),c=>c.charCodeAt(0));}
function utf16Hex(code){if(code<=65535)return code.toString(16).padStart(4,'0').toUpperCase();code-=65536;return(0xD800+(code>>10)).toString(16)+(0xDC00+(code&1023)).toString(16);}
function serializePdf(doc,options={}){
 const plan=planPlot(doc,options),commands=[],used=new Map(),warnings=plan.warnings.slice();let primitiveCount=0;
 const point=p=>plan.toPage(p),xy=p=>{const q=point(p);return n(q.x)+' '+n(q.y);};
 function style(e,ink){const c=plan.monochrome?[0,0,0]:rgb(ink);commands.push(c.map(n).join(' ')+' RG',c.map(n).join(' ')+' rg',n(plan.lineWidthMm*MM*(plan.useLineweights?(e.lineWidth||1):1))+' w','1 J','1 j');}
 function path(points,close=false,fill=false){if(!points?.length)return;commands.push(xy(points[0])+' m');for(let i=1;i<points.length;i++)commands.push(xy(points[i])+' l');if(close)commands.push('h');commands.push(fill?'f':'S');primitiveCount++;}
 function arc(center,radius,start,span){const pieces=Math.max(1,Math.ceil(span/(Math.PI/2))),step=span/pieces;for(let i=0;i<pieces;i++){const a=start+i*step,b=a+step,k=4/3*Math.tan(step/4);const pa={x:center.x+radius*Math.cos(a),y:center.y+radius*Math.sin(a)},pb={x:center.x+radius*Math.cos(b),y:center.y+radius*Math.sin(b)},ca={x:pa.x-k*radius*Math.sin(a),y:pa.y+k*radius*Math.cos(a)},cb={x:pb.x+k*radius*Math.sin(b),y:pb.y-k*radius*Math.cos(b)};if(!i)commands.push(xy(pa)+' m');commands.push(xy(ca)+' '+xy(cb)+' '+xy(pb)+' c');}commands.push('S');primitiveCount++;}
 function label(p,value,height,angle=0){if(!value)return;const visual=String(value).replace(/[\u0590-\u08ff\ufb1d-\ufdff\ufe70-\ufeff]+/g,run=>Array.from(run).reverse().join(''));const chars=Array.from(visual),codes=[];for(const character of chars){const code=character.codePointAt(0),gid=FONT.cmap[code]||0;if(!gid&&!warnings.includes('Some text glyphs are unavailable in the embedded font and use a missing-glyph symbol.'))warnings.push('Some text glyphs are unavailable in the embedded font and use a missing-glyph symbol.');used.set(gid,used.get(gid)||code);codes.push(gid.toString(16).padStart(4,'0'));}const q=point(p),co=Math.cos(angle),si=Math.sin(angle);commands.push('BT','/F1 '+n(height*plan.factor)+' Tf',n(co)+' '+n(si)+' '+n(-si)+' '+n(co)+' '+n(q.x)+' '+n(q.y)+' Tm','<'+codes.join('')+'> Tj','ET');primitiveCount++;}
 function emit(e,parentInk,depth=0){if(depth>8)throw Error('Plot compound nesting is too deep.');if(!visible(doc,e))return;const ink=color(doc,e,parentInk);style(e,ink);
  if(e.kind==='compound'){
   if(e.subtype==='hatch'&&String(e.data?.pattern).toUpperCase()==='SOLID'&&e.data?.loops?.length){for(const loop of e.data.loops){if(!loop.length)continue;commands.push(xy(loop[0])+' m');for(let i=1;i<loop.length;i++)commands.push(xy(loop[i])+' l');commands.push('h');}commands.push('f*');primitiveCount++;}
   else for(const part of e.parts||[])emit(part,ink,depth+1);
  }else if(e.kind==='line'||e.kind==='polyline')path(e.points,e.closed);
  else if(e.kind==='solid')path(e.points,true,true);
  else if(e.kind==='circle'||e.kind==='arc')arc(e.points[0],e.radius,e.kind==='circle'?0:e.startAngle,e.kind==='circle'?TAU:C.arcSpan(e.startAngle,e.endAngle));
  else if(e.kind==='text')label(e.points[0],e.text,e.textHeight,e.startAngle||0);
  else if(e.kind==='dimension'){const g=C.annotationGeometry(e);for(const s of g.segments){style(e,s.color||ink);path([s.a,s.b]);}for(const a of g.arcs){style(e,a.color||ink);arc(a.center,a.radius,a.startAngle,C.arcSpan(a.startAngle,a.endAngle));}for(const f of g.fills||[]){style(e,f.color||ink);path(f.points,true,true);}for(const l of g.labels){style(e,l.color||ink);label(l.point,l.text,l.height,l.angle||0);}}
  else throw Error('Plot does not support entity kind '+e.kind+'.');
 }
 commands.push('q',n(plan.marginMm*MM)+' '+n(plan.marginMm*MM)+' '+n(plan.drawableWidthMm*MM)+' '+n(plan.drawableHeightMm*MM)+' re W n');
 if(plan.area==='window')commands.push(n(plan.originMm.x*MM)+' '+n(plan.originMm.y*MM)+' '+n(plan.plottedWidthMm*MM)+' '+n(plan.plottedHeightMm*MM)+' re W n');
 for(const e of doc.entities)emit(e);commands.push('Q');
 const objects=[null],addObject=value=>{objects.push(typeof value==='string'?bytes(value):value);return objects.length-1;};
 const stream=(data,extra='')=>join([bytes('<< /Length '+data.length+' '+extra+' >>\nstream\n'),data,bytes('\nendstream')]);
 const fontData=fromBase64(FONT.base64),fontFile=addObject(stream(fontData,'/Length1 '+fontData.length));
 const ratio=1000/FONT.units,bbox=FONT.bbox.map(v=>n(v*ratio)).join(' ');
 const descriptor=addObject('<< /Type /FontDescriptor /FontName /RasmCADPlot /Flags 32 /FontBBox ['+bbox+'] /ItalicAngle 0 /Ascent '+n(FONT.ascent*ratio)+' /Descent '+n(FONT.descent*ratio)+' /CapHeight 730 /StemV 80 /FontFile2 '+fontFile+' 0 R >>');
 const entries=[...used.entries()].sort((a,b)=>a[0]-b[0]);let cmap='/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n/CMapName /RasmCADUnicode def\n/CMapType 2 def\n1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\n';
 for(let at=0;at<entries.length;at+=100){const batch=entries.slice(at,at+100);cmap+=batch.length+' beginbfchar\n'+batch.map(([gid,code])=>'<'+gid.toString(16).padStart(4,'0')+'> <'+utf16Hex(code)+'>').join('\n')+'\nendbfchar\n';}
 cmap+='endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend';const toUnicode=addObject(stream(bytes(cmap)));
 const widthArray=entries.map(([gid])=>gid+' ['+n((FONT.widths[gid]||FONT.units*.6)*ratio)+']').join(' ');
 const cid=addObject('<< /Type /Font /Subtype /CIDFontType2 /BaseFont /RasmCADPlot /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /FontDescriptor '+descriptor+' 0 R /DW 600 /W ['+widthArray+'] /CIDToGIDMap /Identity >>');
 const font=addObject('<< /Type /Font /Subtype /Type0 /BaseFont /RasmCADPlot /Encoding /Identity-H /DescendantFonts ['+cid+' 0 R] /ToUnicode '+toUnicode+' 0 R >>');
 const content=addObject(stream(bytes(commands.join('\n')+'\n'))),pages=addObject(''),page=addObject('<< /Type /Page /Parent '+pages+' 0 R /MediaBox [0 0 '+n(plan.widthMm*MM)+' '+n(plan.heightMm*MM)+'] /Resources << /Font << /F1 '+font+' 0 R >> >> /Contents '+content+' 0 R >>');
 objects[pages]=bytes('<< /Type /Pages /Kids ['+page+' 0 R] /Count 1 >>');const catalog=addObject('<< /Type /Catalog /Pages '+pages+' 0 R >>'),info=addObject('<< /Creator (RasmCAD vector plot) /Producer (RasmCAD independent vector PDF writer) >>');
 const chunks=[bytes('%PDF-1.7\n%RasmCAD-vector\n')],offsets=[0];let offset=chunks[0].length;
 for(let i=1;i<objects.length;i++){offsets.push(offset);const chunk=join([bytes(i+' 0 obj\n'),objects[i],bytes('\nendobj\n')]);chunks.push(chunk);offset+=chunk.length;}
 const xref=offset;chunks.push(bytes('xref\n0 '+objects.length+'\n0000000000 65535 f \n'+offsets.slice(1).map(v=>String(v).padStart(10,'0')+' 00000 n \n').join('')+'trailer\n<< /Size '+objects.length+' /Root '+catalog+' 0 R /Info '+info+' 0 R >>\nstartxref\n'+xref+'\n%%EOF\n'));
 const result=join(chunks);if(result.length>64*1024*1024)throw Error('PDF exceeds 64 MiB.');
 Object.defineProperties(result,{plotPlan:{value:plan},warnings:{value:warnings},primitiveCount:{value:primitiveCount}});return result;
}
return Object.freeze({PAPERS,UNITS,planPlot,serializePdf,drawingBounds});
});
</script><script>/* RasmCAD scaled vector PDF plot dialog. No raster capture or network service. */
(function(root,factory){'use strict';if(typeof module==='object'&&module.exports)module.exports=factory(require('./plot.js'));else root.RasmPlotUI=factory(root.RasmPlot);})(typeof globalThis!=='undefined'?globalThis:this,function(Plot){
'use strict';
function mount(context){
 if(!context||typeof context.getDocument!=='function'||typeof context.download!=='function')throw Error('Plot dialog needs document and download callbacks.');
 const doc=globalThis.document,dialog=doc.createElement('dialog');dialog.id='plot-dialog';dialog.setAttribute('aria-label','Scaled vector PDF plot');
 dialog.style.width='min(840px,94vw)';
 const heading=doc.createElement('div');heading.className='dialog-head';const title=doc.createElement('h2');title.textContent='Plot vector PDF';const close=doc.createElement('button');close.type='button';close.id='plot-close';close.textContent='×';close.setAttribute('aria-label','Close plot settings');close.onclick=()=>dialog.close();heading.append(title,close);dialog.append(heading);
 const intro=doc.createElement('p');intro.textContent='Choose physical paper size, drawing units, plot area and scale. The PDF contains vectors and embedded text, independent of screen zoom.';dialog.append(intro);
 const form=doc.createElement('form');form.id='plot-form';form.style.cssText='display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;';dialog.append(form);const controls={};
 function field(key,label,type,value,options){const holder=doc.createElement('label');holder.style.cssText='display:flex;flex-direction:column;gap:5px;min-width:0';holder.textContent=label;const el=doc.createElement(options?'select':'input');el.id='plot-'+key;el.name=key;if(options)for(const [v,t]of options){const opt=doc.createElement('option');opt.value=v;opt.textContent=t;el.append(opt);}else el.type=type;el.value=String(value);if(type==='number'){el.step='any';el.required=true;}holder.append(el);form.append(holder);controls[key]=el;return el;}
 field('paper','Paper size','', 'A4', [...Object.keys(Plot.PAPERS).map(k=>[k,k]),['Custom','Custom size']]);
 field('orientation','Orientation','','landscape',[['landscape','Landscape'],['portrait','Portrait']]);
 field('widthMm','Custom paper width (mm)','number',297);field('heightMm','Custom paper height (mm)','number',210);
 field('units','One drawing unit means','','mm', [['mm','1 mm'],['cm','1 cm'],['m','1 m'],['inch','1 inch'],['ft','1 foot']]);
 field('area','Plot area','','extents',[['extents','Visible drawing extents'],['window','Window coordinates']]);
 field('scale','Scale 1 : N','number',100);field('marginMm','Paper margin (mm)','number',10);
 for(const [key,label,value]of [['xmin','Window minimum X',0],['ymin','Window minimum Y',0],['xmax','Window maximum X',1000],['ymax','Window maximum Y',1000]])field(key,label,'number',value);
 field('lineWidthMm','Base line weight on paper (mm)','number',.25);
 const checks=doc.createElement('div');checks.style.cssText='display:grid;gap:6px;align-content:center';form.append(checks);
 for(const[key,label,value]of[['fit','Fit to printable area',false],['center','Center drawing on paper',true],['monochrome','Monochrome (black)',true],['useLineweights','Use object line-weight multipliers',true]]){const holder=doc.createElement('label');holder.style.cssText='display:flex;align-items:center;gap:8px';const el=doc.createElement('input');el.type='checkbox';el.id='plot-'+key;el.checked=value;controls[key]=el;holder.append(el,doc.createTextNode(label));checks.append(holder);}
 const summary=doc.createElement('div');summary.id='plot-summary';summary.setAttribute('role','status');summary.style.cssText='grid-column:1/-1;padding:10px;border:1px solid #486276;background:#14232f;white-space:pre-wrap';form.append(summary);
 const preview=doc.createElementNS('http://www.w3.org/2000/svg','svg');preview.id='plot-paper-preview';preview.setAttribute('aria-label','Paper and plotted extents preview');preview.style.cssText='grid-column:1/-1;width:100%;height:140px;background:#253744';form.append(preview);
 const fontNote=doc.createElement('p');fontNote.style.cssText='grid-column:1/-1;margin:0;color:#9fb5c6;font-size:11px';fontNote.textContent='Text uses an embedded DejaVu substitute font. Complex Arabic shaping, source SHX/CAD fonts and glyphs outside the embedded subset may differ. Print this PDF at Actual size / 100% to preserve the selected scale.';form.append(fontNote);
 const actions=doc.createElement('div');actions.style.cssText='grid-column:1/-1;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px';const selected=doc.createElement('button');selected.type='button';selected.id='plot-use-selection';selected.textContent='Use selected bounds';selected.hidden=typeof context.getSelectionBounds!=='function';actions.append(selected);const update=doc.createElement('button');update.type='button';update.id='plot-preview-btn';update.textContent='Update plan';const submit=doc.createElement('button');submit.type='submit';submit.id='plot-download';submit.className='primary';submit.textContent='Download vector PDF';actions.append(update,submit);form.append(actions);
 function options(){return{paper:controls.paper.value,orientation:controls.orientation.value,widthMm:Number(controls.widthMm.value),heightMm:Number(controls.heightMm.value),units:controls.units.value,area:controls.area.value,scale:Number(controls.scale.value),marginMm:Number(controls.marginMm.value),lineWidthMm:Number(controls.lineWidthMm.value),fit:controls.fit.checked,center:controls.center.checked,monochrome:controls.monochrome.checked,useLineweights:controls.useLineweights.checked,window:{xmin:Number(controls.xmin.value),ymin:Number(controls.ymin.value),xmax:Number(controls.xmax.value),ymax:Number(controls.ymax.value)}};}
 function paint(plan){preview.replaceChildren();preview.setAttribute('viewBox',`-8 -8 ${plan.widthMm+16} ${plan.heightMm+16}`);function rect(x,y,w,h,fill,stroke,dash){const r=doc.createElementNS(preview.namespaceURI,'rect');for(const[k,v]of Object.entries({x,y,width:w,height:h,fill,stroke,'stroke-width':.8}))r.setAttribute(k,v);if(dash)r.setAttribute('stroke-dasharray','3 2');preview.append(r);}rect(0,0,plan.widthMm,plan.heightMm,'white','#111');rect(plan.marginMm,plan.marginMm,plan.drawableWidthMm,plan.drawableHeightMm,'none','#999',true);rect(plan.originMm.x,plan.heightMm-plan.originMm.y-plan.plottedHeightMm,Math.max(.2,plan.plottedWidthMm),Math.max(.2,plan.plottedHeightMm),'#63bdb33a',plan.clipped?'#b42c20':'#127b70');}
 function refresh(){for(const key of ['widthMm','heightMm'])controls[key].disabled=controls.paper.value!=='Custom';for(const key of ['xmin','ymin','xmax','ymax'])controls[key].disabled=controls.area.value!=='window';controls.scale.disabled=controls.fit.checked;try{const plan=Plot.planPlot(context.getDocument(),options());summary.textContent=`${plan.paper} ${plan.orientation} · ${plan.widthMm} × ${plan.heightMm} mm\nScale 1:${Number(plan.scale.toPrecision(7))}${plan.fit?' (calculated fit)':''} · Drawing unit: ${plan.units}\nPlotted extent: ${Number(plan.plottedWidthMm.toFixed(3))} × ${Number(plan.plottedHeightMm.toFixed(3))} mm${plan.clipped?'\nCLIPPING: drawing exceeds printable area at this scale.':''}`;summary.style.color=plan.clipped?'#ffc6a8':'';submit.disabled=false;paint(plan);return plan;}catch(error){summary.textContent=error.message;summary.style.color='#ffbaac';submit.disabled=true;preview.replaceChildren();return null;}}
 selected.onclick=()=>{try{const b=context.getSelectionBounds();if(!b?.valid)throw Error('Select objects before using their bounds.');controls.area.value='window';for(const[k,v]of Object.entries({xmin:b.min.x,ymin:b.min.y,xmax:b.max.x,ymax:b.max.y}))controls[k].value=String(v);refresh();}catch(error){summary.textContent=error.message;}};
 update.onclick=refresh;form.addEventListener('input',refresh);form.addEventListener('change',refresh);
 form.addEventListener('submit',event=>{event.preventDefault();try{if(!refresh())return;const settings=options(),pdf=Plot.serializePdf(context.getDocument(),settings);if(context.setPlotSettings)context.setPlotSettings(settings);context.download(pdf,'RasmCAD-plot.pdf','application/pdf');context.log?.(`Vector PDF downloaded: ${pdf.plotPlan.paper}, scale 1:${Number(pdf.plotPlan.scale.toPrecision(7))}. Print PDF at 100% / Actual size.`);summary.textContent+='\nPDF downloaded. Use Actual size / 100% in your PDF printer.';if(pdf.warnings.length)summary.textContent+='\n'+pdf.warnings.join('\n');}catch(error){summary.textContent=error.message;summary.style.color='#ffbaac';context.log?.('Plot failed: '+error.message,true);}});
 doc.body.append(dialog);
 function show(){const saved=context.getDocument().resources?.plot;if(saved)for(const[key,el]of Object.entries(controls)){if(key in saved){if(el.type==='checkbox')el.checked=!!saved[key];else el.value=String(saved[key]);}if(['xmin','ymin','xmax','ymax'].includes(key)&&saved.window?.[key]!=null)el.value=String(saved.window[key]);}refresh();if(!dialog.open)dialog.showModal();}
 return Object.freeze({show,close:()=>dialog.close(),refresh,element:dialog});
}
return Object.freeze({mount});
});
</script><script>/* Interactive advanced 2D command workflows. Geometry lives in the pure modules. */
(function(root){'use strict';
root.RasmAdvancedUI={mount(ctx){
 const C=root.RasmCore,A=root.RasmAdvancedEdit,H=root.RasmHatch,B=root.RasmBlocks,D=root.RasmDimensions,N=root.RasmCommands;
 let state=null,blockSession=null;
 const snapModes=new Set(['endpoint','midpoint','center','quadrant','intersection']);
 const names=['STRETCH','BREAK','LENGTHEN','ALIGN','PEDIT','SPLINEDIT','SPLINE','OVERKILL','EXPLODE','EXPLOAD','HATCH','HATCHEDIT','BOUNDARY','REGION','BLOCK','INSERT','WBLOCK','BEDIT','REFEDIT','BCLOSE','ATTDEF','ATTEDIT','ATTSYNC','DIMSTYLE','DIMCONTINUE','DIMBASELINE','DIMORDINATE','DIMEDIT','QLEADER','MLEADER','MLEADEREDIT','OSNAPSET'];
 const doc=()=>ctx.getDocument(),ids=()=>ctx.getSelection(),clone=x=>JSON.parse(JSON.stringify(x));
 const number=(v,label)=>{const n=N.number(v);if(n===null)throw Error('Enter a valid '+label);return n;};
 const done=(result,message)=>{state=null;ctx.changed(Array.isArray(result)?result:[],message||'Command completed.');};
 const refresh=()=>ctx.refresh();
 const run=fn=>{try{return fn();}catch(e){ctx.log(e.message,true);refresh();}};
 function dialog(title,fields,apply){
  const d=document.createElement('dialog');d.className='advanced-dialog';
  const heading=document.createElement('h2');heading.textContent=title;d.append(heading);
  let applied=false;
  const form=document.createElement('form');form.className='advanced-form';const elements={};
  for(const f of fields){const label=document.createElement('label');label.textContent=f.label;const input=document.createElement(f.options?'select':f.multiline?'textarea':'input');
   if(f.options)for(const item of f.options){const o=document.createElement('option');o.value=typeof item==='string'?item:item.value;o.textContent=typeof item==='string'?item:item.label;input.append(o);}
   else if(!f.multiline)input.type=f.type||'text';
   input.name=f.name;input.id='advanced-'+f.name;input.value=f.value??(f.options?input.options[0]?.value:'');if(f.type==='checkbox')input.checked=!!f.value;
   if(f.type==='number')input.step='any';if(f.required)input.required=true;if(f.readOnly)input.readOnly=true;label.append(input);form.append(label);elements[f.name]=input;
  }
  const error=document.createElement('p');error.className='advanced-error';error.role='alert';form.append(error);
  const actions=document.createElement('div');actions.className='import-actions';const cancel=document.createElement('button');cancel.type='button';cancel.textContent='Cancel';cancel.onclick=()=>d.close();
  const save=document.createElement('button');save.type='submit';save.className='primary';save.textContent='Apply';actions.append(cancel,save);form.append(actions);
  form.onsubmit=e=>{e.preventDefault();try{const values=Object.fromEntries(Object.entries(elements).map(([k,v])=>[k,v.type==='checkbox'?v.checked:v.value]));apply(values);applied=true;d.close();}catch(ex){error.textContent=ex.message;ctx.log(ex.message,true);}};
  d.append(form);d.addEventListener('close',()=>{if(!applied){state=null;refresh();}d.remove();ctx.focus();});document.body.append(d);d.showModal();return d;
 }
 function selectedOne(kind){const chosen=doc().entities.filter(e=>ids().includes(e.id));if(chosen.length!==1||kind&&!kind(chosen[0]))throw Error('Select one suitable object first.');return chosen[0];}
 function acquire(name,after,extra={}){state={name,stage:'select',points:[],after,...extra};if(ids().length){state.stage='ready';after();}else{state.prompt=name+': select objects, then Enter.';refresh();}}
 function stage(name,prompt,count,action,extra={}){state={name,prompt,points:[],count,action,...extra};refresh();ctx.focus();}
 function askName(title,apply,value=''){dialog(title,[{name:'name',label:'Name',value,required:true}],v=>apply(v.name.trim()));}
 function attributeForm(name){
  dialog('Attribute definition — '+name,[{name:'operation',label:'Operation',options:['ADD','UPDATE','REMOVE']},{name:'originalTag',label:'Existing tag for UPDATE / REMOVE'},{name:'tag',label:'Tag (unique)'},{name:'prompt',label:'Prompt'},{name:'defaultValue',label:'Default value'},{name:'x',label:'Local X',type:'number',value:0},{name:'y',label:'Local Y',type:'number',value:0},{name:'height',label:'Text height',type:'number',value:12},{name:'rotation',label:'Rotation degrees',type:'number',value:0},{name:'invisible',label:'Invisible',type:'checkbox'},{name:'constant',label:'Constant',type:'checkbox'},{name:'required',label:'Require a nonempty value',type:'checkbox'}],v=>{
   const data={tag:v.tag,prompt:v.prompt,defaultValue:v.defaultValue,point:{x:number(v.x,'X'),y:number(v.y,'Y')},height:number(v.height,'height'),rotation:number(v.rotation,'angle')*Math.PI/180,invisible:v.invisible,constant:v.constant,required:v.required};
   const result=v.operation==='REMOVE'?B.removeAttribute(doc(),name,v.originalTag):v.operation==='UPDATE'?B.updateAttribute(doc(),name,v.originalTag,data):B.addAttribute(doc(),name,data);
   done(result,'Attribute definitions updated. Use ATTEDIT for instance values.');
  });
 }
 function hatchForm(edit=false,inside=false){
  const chosen=doc().entities.find(e=>ids().includes(e.id)&&e.subtype==='hatch'),data=chosen?.data||{};
  dialog(edit?'HATCHEDIT':inside?'HATCH — pick enclosed area':'HATCH — selected closed boundaries',[{name:'pattern',label:'Pattern',options:['ANSI31','CROSS','SOLID','HORIZONTAL','VERTICAL'],value:data.pattern||'ANSI31'},{name:'spacing',label:'Spacing in drawing units',type:'number',value:data.spacing||10},{name:'angle',label:'Angle degrees',type:'number',value:data.angle??45}],v=>{const options={pattern:v.pattern,spacing:number(v.spacing,'spacing'),angle:number(v.angle,'angle')};if(inside)stage('HATCH','HATCH: pick inside a closed area.',1,p=>done(H.boundary(doc(),p[0],{hatch:true,...options})));else done((edit?H.edit:H.create)(doc(),ids(),options),'Hatch saved as an editable object.');});
 }
 function dimStyleForm(name){
  const base=D.currentStyle(doc()),stored=doc().resources?.dimStyles?.[name];const style={...base,...(stored?.style||stored||{})};
  dialog('DIMSTYLE — '+name,[{name:'name',label:'Style name',value:name,required:true},...['textHeight','dimensionScale','arrowSize','extensionOffset','extensionExtend','textGap','precision'].map(k=>({name:k,label:k,type:'number',value:style[k]??(k==='precision'?2:1)})),{name:'arrowStyle',label:'Arrow style',options:['closed','open','tick'],value:style.arrowStyle||'closed'},{name:'prefix',label:'Prefix',value:style.prefix||''},{name:'suffix',label:'Suffix',value:style.suffix||''},{name:'dimensionColor',label:'Dimension color (blank inherits)',value:style.dimensionColor||''},{name:'textColor',label:'Text color (blank inherits)',value:style.textColor||''},{name:'applySelected',label:'Apply to selected dimensions',type:'checkbox',value:ids().length>0}],v=>{
   if(v.applySelected&&ids().some(id=>doc().entities.find(e=>e.id===id)?.kind!=='dimension'))throw Error('Select only dimensions before applying a dimension style.');
   const opts={};for(const k of ['textHeight','dimensionScale','arrowSize','extensionOffset','extensionExtend','textGap','precision'])opts[k]=number(v[k],k);
   for(const k of ['arrowStyle','prefix','suffix'])opts[k]=v[k];opts.dimensionColor=v.dimensionColor||null;opts.textColor=v.textColor||null;
   const original=doc(),working=C.Document.parse(original.serialize());
   D.style(working,working.resources?.dimStyles?.[v.name]?'UPDATE':'SAVE',v.name,opts);D.style(working,'SETCURRENT',v.name);
   if(v.applySelected)D.style(working,'APPLY',v.name,{ids:ids()});
   original.checkpoint();original.entities=working.entities;original.resources=working.resources;
   done(ids(),'Dimension style saved and set current.');
  });
 }
 function start(name,rest){
  state=null;ctx.enter();name=name==='EXPLOAD'?'EXPLODE':name;
  if(name==='OSNAPSET'){
   const fields=['endpoint','midpoint','center','quadrant','intersection','perpendicular','tangent','nearest'].map(k=>({name:k,label:k,type:'checkbox',value:snapModes.has(k)}));
   dialog('Object snap modes',fields,v=>{snapModes.clear();for(const k of Object.keys(v))if(v[k])snapModes.add(k);ctx.log('Object snap modes: '+[...snapModes].join(', '));});return;
  }
  if(name==='STRETCH'){stage(name,'STRETCH: first crossing-window corner, then opposite corner; then base and destination.',4,p=>{const selected=ctx.crossing(p[0],p[1]);done(A.stretch(doc(),selected,p[0],p[1],{x:p[3].x-p[2].x,y:p[3].y-p[2].y}),'Vertices inside the crossing window stretched.');});return;}
  if(name==='BREAK'){acquire(name,()=>{const e=selectedOne();stage(name,'BREAK: first break point, then second break point on selected object.',2,p=>done(A.breakEntity(doc(),e.id,p[0],p[1])));});return;}
  if(name==='LENGTHEN'){acquire(name,()=>{const e=selectedOne();dialog('LENGTHEN',[{name:'mode',label:'Mode',options:['TOTAL','DELTA','PERCENT'],value:'TOTAL'},{name:'value',label:'Length / change / percent',type:'number',value:100}],v=>stage(name,'LENGTHEN: pick near the endpoint to change.',1,p=>done(A.lengthen(doc(),e.id,v.mode,number(v.value,'length'),p[0]))));});return;}
  if(name==='ALIGN'){acquire(name,()=>dialog('ALIGN',[{name:'scale',label:'Scale uniformly to target length',type:'checkbox'}],v=>stage(name,'ALIGN: source point 1, destination 1, source point 2, destination 2.',4,p=>done(A.align(doc(),ids(),p[0],p[2],p[1],p[3],v.scale)))));return;}
  if(name==='PEDIT'||name==='SPLINEDIT'){
   acquire(name,()=>{const spline=name==='SPLINEDIT';const actions=spline?['VERTEX','INSERT','DELETE','REVERSE','CLOSE','OPEN','TENSION']:['CLOSE','OPEN','REVERSE','JOIN','VERTEX','INSERT','DELETE'];
    const apply=(action,value)=>{if(spline)done(A.splineEdit(doc(),selectedOne().id,action,value));else done(A.pedit(doc(),ids(),action,value));};
    if(rest){const [rawAction,...args]=rest.split(/\s+/),action=rawAction.toUpperCase();let value;
     const nums=args.join(' ').split(/[,\s]+/).filter(Boolean).map(x=>number(x,'option value'));
     if(['VERTEX','INSERT'].includes(action)){if(nums.length!==3)throw Error('Enter index x y after the operation.');value={index:nums[0],point:{x:nums[1],y:nums[2]}};}
     else if(nums.length)value=nums[0];apply(action,value);return;}
    dialog(name,[{name:'action',label:'Operation',options:actions},{name:'index',label:'Vertex index (zero based)',type:'number',value:0},{name:'x',label:'New X',type:'number',value:0},{name:'y',label:'New Y',type:'number',value:0},{name:'tension',label:'Spline tension',type:'number',value:.5}],v=>{let value;if(['VERTEX','INSERT'].includes(v.action))value={index:number(v.index,'index'),point:{x:number(v.x,'X'),y:number(v.y,'Y')}};else if(v.action==='DELETE')value=number(v.index,'index');else if(v.action==='TENSION')value=number(v.tension,'tension');apply(v.action,value);});
   });return;
  }
  if(name==='SPLINE'){stage(name,'SPLINE: specify control points; Enter finishes (at least 2).',Infinity,null,{finish:p=>{if(p.length<2)throw Error('Specify at least two spline points.');ctx.append(A.createSpline(p,{tension:.5}));done([],'Editable spline created.');}});return;}
  if(name==='OVERKILL'){acquire(name,()=>dialog('OVERKILL',[{name:'tolerance',label:'Geometric tolerance in drawing units',type:'number',value:.000001}],v=>done(A.overkill(doc(),ids(),number(v.tolerance,'tolerance')),'Duplicates and compatible collinear overlaps processed.')));return;}
  if(name==='EXPLODE'){acquire(name,()=>done(A.explode(doc(),ids()),'Objects exploded into editable components.'));return;}
  if(name==='HATCH'&&!ids().length){hatchForm(false,true);return;}
  if(name==='HATCH'||name==='HATCHEDIT'){acquire(name,()=>hatchForm(name==='HATCHEDIT'));return;}
  if(name==='REGION'){acquire(name,()=>done(H.region(doc(),ids()),'Planar region created.'));return;}
  if(name==='BOUNDARY'){stage(name,'BOUNDARY: pick inside a closed area.',1,p=>done(H.boundary(doc(),p[0]),'Closed boundary created.'));return;}
  if(name==='BLOCK'){
   const define=name=>acquire('BLOCK',()=>stage('BLOCK','BLOCK '+name+': specify base point.',1,p=>done(B.define(doc(),name,ids(),p[0],{replace:true}),'Block '+name+' defined. Use INSERT to reuse it.')));
   if(rest)define(rest);else askName('BLOCK — definition name',define);return;
  }
  if(name==='INSERT'){
   const insert=name=>{const definition=doc().resources?.blocks?.[name];if(!definition)throw Error('Block definition does not exist: '+name);const attributes=definition.attributes||[];
    dialog('INSERT — '+name,[{name:'scale',label:'Uniform scale',type:'number',value:1},{name:'rotation',label:'Rotation degrees',type:'number',value:0},...attributes.map(a=>({name:'attribute_'+a.tag,label:(a.prompt||a.tag)+' ['+a.tag+']'+(a.constant?' (constant)':''),value:a.defaultValue||'',readOnly:a.constant,required:a.required}))],v=>{
     const values=Object.fromEntries(attributes.filter(a=>!a.constant).map(a=>[a.tag,v['attribute_'+a.tag]]));
     stage('INSERT','INSERT '+name+': specify insertion point.',1,p=>done(B.insert(doc(),name,p[0],{scale:number(v.scale,'scale'),rotation:number(v.rotation,'rotation')*Math.PI/180,attributes:values})));
    });};
   if(rest)insert(rest);else askName('INSERT — existing definition name',insert);return;
  }
  if(name==='WBLOCK'){const save=name=>{const standalone=B.exportBlock(doc(),name);ctx.download(standalone.serialize(),name+'.block.rasm.json','application/json');ctx.log('Downloaded a reusable native block drawing; this is not a DWG export.');};if(rest)save(rest);else askName('WBLOCK — native block export',save);return;}
  if(name==='BEDIT'||name==='REFEDIT'){
   const edit=key=>{if(blockSession)throw Error('Close the current block edit with BCLOSE first.');const original=doc(),result=B.beginEdit(original,key);blockSession={original,context:result.context};ctx.replaceDocument(result.document,'Block edit');updateBlockBanner();ctx.log('Block editing: edit the working geometry, then BCLOSE SAVE or BCLOSE CANCEL.');};
   if(name==='REFEDIT')edit(selectedOne(e=>e.subtype==='block').id);else if(rest)edit(rest);else askName('BEDIT — definition name',edit);return;
  }
  if(name==='BCLOSE'){if(!blockSession)throw Error('No block definition is being edited.');const close=save=>{const session=blockSession,working=doc();if(save)B.commitEdit(session.original,session.context,working);blockSession=null;ctx.replaceDocument(session.original,'Drawing');updateBlockBanner();ctx.changed([],save?'Block definition saved; references updated.':'Block edit discarded.');};if(rest)close(!['CANCEL','DISCARD','NO'].includes(rest.toUpperCase()));else dialog('Close block editing',[{name:'save',label:'Save changes to definition',type:'checkbox',value:true}],v=>close(v.save));return;}
  if(name==='ATTDEF'){if(rest)attributeForm(rest);else askName('ATTDEF — block name',attributeForm);return;}
  if(name==='ATTEDIT'){acquire(name,()=>{const e=selectedOne(e=>e.subtype==='block'),attributes=doc().resources.blocks[e.data.name]?.attributes||[];if(!attributes.length)throw Error('This block has no attributes. Use ATTDEF to add definitions.');
   dialog('ATTEDIT — '+e.data.name,attributes.map(a=>({name:'attribute_'+a.tag,label:(a.prompt||a.tag)+' ['+a.tag+']'+(a.constant?' (constant)':a.invisible?' (invisible)':''),value:e.data.attributes[a.tag]??a.defaultValue,readOnly:a.constant,required:a.required})),v=>done(B.setAttributes(doc(),ids(),Object.fromEntries(attributes.filter(a=>!a.constant).map(a=>[a.tag,v['attribute_'+a.tag]])))));
  });return;}
  if(name==='ATTSYNC'){const sync=name=>done(B.syncAttributes(doc(),name),'Block attributes synchronized.');if(rest)sync(rest);else askName('ATTSYNC — block name',sync);return;}
  if(name==='DIMSTYLE'){
   const [action,...arg]=rest.split(/\s+/),styleName=arg.join(' ');
   if(action.toUpperCase()==='RENAME'){const [oldName,newName]=styleName.split('|').map(x=>x.trim());if(!newName)throw Error('Use DIMSTYLE RENAME Old name|New name');D.style(doc(),'RENAME',oldName,{newName});ctx.changed(ids(),'Dimension style renamed.');return;}
   if(['SETCURRENT','DELETE','RENAME','APPLY','LIST'].includes(action.toUpperCase())){const result=D.style(doc(),action.toUpperCase(),styleName,{ids:ids()});ctx.changed(ids(),typeof result==='object'?JSON.stringify(result):'Dimension style updated.');return;}
   dimStyleForm(rest||doc().resources?.currentDimStyle||'Standard');return;
  }
  if(name==='DIMCONTINUE'||name==='DIMBASELINE'){acquire(name,()=>{const ref=selectedOne(e=>e.kind==='dimension');stage(name,name+': next feature point, then dimension placement.',2,p=>done(D.continueDimension(doc(),ref.id,p[0],p[1],{baseline:name==='DIMBASELINE'})));});return;}
  if(name==='DIMORDINATE'){dialog('DIMORDINATE',[{name:'axis',label:'Measured coordinate',options:['X','Y']}],v=>stage(name,'DIMORDINATE: datum origin, feature point, label location.',3,p=>done(D.ordinate(doc(),p[0],p[1],p[2],v.axis))));return;}
  if(name==='DIMEDIT'){acquire(name,()=>dialog('DIMEDIT',[{name:'action',label:'Operation',options:['TEXT','POSITION','RESET']},{name:'text',label:'Text override (<> = measurement)',value:'<>'}],v=>{if(v.action==='POSITION')stage(name,'DIMEDIT: pick new dimension placement.',1,p=>done(D.edit(doc(),ids(),'POSITION',p[0])));else done(D.edit(doc(),ids(),v.action,v.text));}));return;}
  if(name==='QLEADER'||name==='MLEADER'){stage(name,name+': arrow tip, bend point, then text location.',3,p=>{state={name,stage:'leadertext',points:p,prompt:name+': enter the leader text.'};refresh();});return;}
  if(name==='MLEADEREDIT'){acquire(name,()=>{const e=selectedOne(e=>e.subtype==='leader');dialog('MLEADEREDIT',[{name:'action',label:'Operation',options:['TEXT','POSITION','ADD','REMOVE']},{name:'text',label:'Text',value:e.data.text||''},{name:'index',label:'Arm index (zero based)',type:'number',value:0}],v=>{if(v.action==='TEXT')done(D.editLeader(doc(),e.id,'TEXT',v.text));else if(v.action==='REMOVE')done(D.editLeader(doc(),e.id,'REMOVE',number(v.index,'index')));else stage(name,v.action==='ADD'?'Pick new leader arrow tip, then bend point.':'Pick new text location.',v.action==='ADD'?2:1,p=>done(D.editLeader(doc(),e.id,v.action,v.action==='ADD'?p:p[0])));});});return;}
 }
 function updateBlockBanner(){let banner=document.getElementById('block-edit-banner');if(!banner){banner=document.createElement('div');banner.id='block-edit-banner';banner.className='block-edit-banner';document.querySelector('.work-area').prepend(banner);}banner.replaceChildren();banner.hidden=!blockSession;if(blockSession){const text=document.createElement('span');text.textContent='BLOCK EDIT — changes are staged until saved. ';const save=document.createElement('button');save.textContent='Save block';save.onclick=()=>run(()=>start('BCLOSE','SAVE'));const cancel=document.createElement('button');cancel.textContent='Discard';cancel.onclick=()=>run(()=>start('BCLOSE','CANCEL'));banner.append(text,save,cancel);}}
 function accept(p){if(!state||state.stage==='select'||state.stage==='leadertext')return false;state.points.push({...p});if(state.points.length>=state.count){const action=state.action,values=state.points.map(clone);action(values);}else refresh();return true;}
 function finish(){if(!state)return false;if(state.stage==='select'){if(!ids().length)throw Error('Select at least one editable object.');const after=state.after;state.stage='ready';after();return true;}if(state.finish){const action=state.finish,p=state.points.map(clone);action(p);return true;}ctx.log('Complete the requested points, or Esc to cancel.',true);return true;}
 function execute(raw){const split=N.commandSplit(raw);if(state?.stage==='leadertext'){done(D.leader(doc(),[[state.points[0],state.points[1],state.points[2]]],state.points[2],raw,D.currentStyle(doc())),'Leader created.');return true;}
  if(names.includes(split.name)){start(split.name,split.rest);return true;}
  if(!state)return false;
  if(state.stage==='select'){if(['ALL','A'].includes(split.name)){ctx.selectAll();return true;}throw Error('Select objects, then Enter.');}
  const point=ctx.parsePoint?ctx.parsePoint(raw,state.points.at(-1)||null):N.parsePoint(raw,state.points.at(-1)||null);if(point){if(ctx.acceptPoint)ctx.acceptPoint(point);else accept(point);return true;}throw Error('This command expects a point as x,y, or Esc to cancel.');
 }
 function addToolbar(){const group=document.createElement('details');group.className='tool-group';const summary=document.createElement('summary');summary.textContent='Advanced 2D';group.append(summary);const grid=document.createElement('div');grid.className='tool-grid';for(const name of ['STRETCH','BREAK','LENGTHEN','ALIGN','PEDIT','SPLINE','SPLINEDIT','OVERKILL','EXPLODE','HATCH','HATCHEDIT','BOUNDARY','REGION','BLOCK','INSERT','BEDIT','REFEDIT','WBLOCK','ATTDEF','ATTEDIT','DIMSTYLE','DIMCONTINUE','DIMBASELINE','DIMORDINATE','DIMEDIT','QLEADER','MLEADER','MLEADEREDIT','OSNAPSET']){const b=document.createElement('button');b.type='button';b.dataset.advanced=name;b.textContent=name;b.title=name;b.onclick=()=>run(()=>start(name,''));grid.append(b);}group.append(grid);document.querySelector('.tools').append(group);}
 addToolbar();
 return{get textInput(){return state?.stage==='leadertext';},execute,acceptPoint:accept,finish,cancel(){state=null;refresh();},get active(){return !!state;},get acquiring(){return state?.stage==='select';},get prompt(){return state?.prompt||'';},get name(){return state?.name||'';},get basePoint(){return state?.points.at(-1)||null;},get snapModes(){return [...snapModes];},get blockEditing(){return !!blockSession;},guardReplace(){if(blockSession){ctx.log('Save or discard the block edit with BCLOSE before opening another drawing.',true);return false;}return true;},preview(){return state?.points.length>1?[{kind:'polyline',points:state.points,closed:false}]:[];},dialog};
}};
})(typeof globalThis!=='undefined'?globalThis:this);
</script><script>/* RasmCAD Browser UI. All storage is user-initiated file download/open. */
(() => {
  'use strict';
  const C = window.RasmCore, E = window.RasmEdit, IO = window.RasmIO, S = window.RasmSelection, G = window.RasmGrips,
        Commands = window.RasmCommands, View = window.RasmView,
        $ = id => document.getElementById(id);
  const canvas = $('canvas'), ctx = canvas.getContext('2d'), wrap = $('canvas-wrap');
  let doc = new C.Document(), selected = new Set(), tool = 'select', lastTool = 'line', points = [];
  let dirty = false, filename = 'Drawing', camera = {x: 300, y: 200}, zoom = 1;
  let W = 800, H = 500, dpr = 1, grid = true, snap = true, ortho = false, mouse = null,
      snapPoint = null, gesture = null;
  let frame = 0, downloadSerial = 0;
  let params = {}, lastMeasurement = null, dimTextHeight = 12, busy = false,
      linearStyle = 'horizontal';
  let selectionMode = 'additive', hovered = null, previewWorld = null, selectionCycle = null;
  let lastCreatedId = null, dimensionDefaults = null;
  let propertySelectionKey = '', propertyDirty = new Set();
  let gripPreview = null;
  let advanced=null,plotUI=null,snapType='';
  let oneShot=null,aperture=10,snapWarning='',polarIncrement=0,otrack=false,dynamicInput=false;
  let trackingAnchors=[],trackingHit=null,acquisition=null,fromBase=null,awaitFrom=false;
  let snapPriority=null;
  const VERSION='0.7', commandHistory=[], inputHistory=[], diagnosticEvents=[];
  let historyIndex=0, historyDraft='', suggestions=[], suggestionIndex=-1;
  const accent = '#69dfc3', ink = '#dce7ef';
  const V = {
    add: (a, b) => ({x: a.x + b.x, y: a.y + b.y}),
    sub: (a, b) => ({x: a.x - b.x, y: a.y - b.y}),
    mul: (a, k) => ({x: a.x * k, y: a.y * k})
  };
  const fmt = n => Number(n).toLocaleString(
      'en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: false});
  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));
  const safe = fn => (...args) => {
    try {
      return fn(...args);
    } catch (error) {
      log('Operation failed: ' + error.message, true);
    }
  };
  function log(message, error = false) {
    message=String(message);
    $('status-log').textContent = message;
    $('status-log').style.color = error ? '#ffbaac' : '';
    commandHistory.push({message,error,time:new Date().toISOString()});
    if(commandHistory.length>200)commandHistory.shift();
    const entry=document.createElement('div');entry.textContent=message;
    entry.className=error?'history-error':'history-entry';
    $('command-history').append(entry);
    while($('command-history').childElementCount>200)$('command-history').firstChild.remove();
    $('command-history').scrollTop=$('command-history').scrollHeight;
    if(error){diagnosticEvents.push({time:new Date().toISOString(),message});if(diagnosticEvents.length>100)diagnosticEvents.shift();}
  }
  const currentView=()=>({camera,zoom,width:W,height:H});
  function worldToScreen(p) {
    return View.project(p,currentView());
  }
  function screenToWorld(p) {
    return {x: camera.x + (p.x - W / 2) / zoom, y: camera.y - (p.y - H / 2) / zoom};
  }
  function pointer(e) {
    const r = canvas.getBoundingClientRect();
    return {x: e.clientX - r.left, y: e.clientY - r.top};
  }
  function layer(e) {
    return doc.layer(e.layer);
  }
  function visible(e) {
    return layer(e)?.visible !== false;
  }
  function editable(e) {
    const l = layer(e);
    return l && l.visible && !l.locked;
  }
  function entityColor(e) {
    return e.color || layer(e)?.color || ink;
  }
  function schedule() {
    if (!frame)
      frame = requestAnimationFrame(() => {
        frame = 0;
        render();
      });
  }
  function sync() {
    $('entity-count').textContent = String(doc.entities.length);
    $('selection-count').textContent = String(selected.size);
    $('save-state').textContent =
        dirty ? 'Unsaved changes — save your project' : 'No unsaved changes';
    $('file-name').textContent =
        (filename === 'Drawing' ? 'Untitled drawing' : filename) + (dirty ? ' *' : '');
    document.title = (dirty ? '* ' : '') + filename + ' — RasmCAD Advanced '+VERSION;
    $('undo-btn').disabled = !doc.canUndo();
    $('redo-btn').disabled = !doc.canRedo();
    $('delete-btn').disabled = selected.size === 0;
    $('welcome').hidden = doc.entities.length > 0 || tool !== 'select';
    document.querySelectorAll('[data-tool]').forEach(b => {
      const on = b.dataset.tool === tool;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    for (const [id, on] of [['grid-btn', grid], ['snap-btn', snap], ['ortho-btn', ortho]])
      $(id).setAttribute('aria-pressed', String(on));
    if ($('active-command')) $('active-command').textContent = advanced?.active?advanced.name+(advanced.acquiring?' · SELECT':''):params.acquiring ? tool.toUpperCase()+' · SELECT' : tool.toUpperCase();
    if ($('selection-hint')) $('selection-hint').textContent = params.acquiring ? 'Select objects, then Enter or right-click to continue. Shift removes.' : 'Click adds · Shift removes · left→right window · right→left crossing · Esc clears';
    if ($('finish-btn')) $('finish-btn').disabled = tool === 'select'&&!advanced?.active;
    const draft=points.length>0&&tool!=='select';
    $('draft-status').textContent=draft ? 'Preview is unfinished. Click the next point or enter a value to commit; Esc keeps completed objects.' : doc.entities.length+' committed objects · Esc returns to selection';
    $('draft-status').classList.toggle('pending',draft);
    updateProperties();
    schedule();
  }
  function changed() {
    dirty = true;
    sync();
  }
  function updateLayers() {
    const select = $('layer-select');
    select.replaceChildren();
    $('layer-list').replaceChildren();
    for (const l of doc.layers) {
      const option = document.createElement('option');
      option.value = l.name;
      option.textContent = l.name + (l.visible ? '' : ' (hidden)') + (l.locked ? ' (locked)' : '');
      select.append(option);
      const b = document.createElement('button');
      b.className = 'layer-row' + (l.name === doc.currentLayer ? ' active' : '');
      b.title = l.name;
      const chip = document.createElement('span');
      chip.style.backgroundColor = l.color;
      const title = document.createElement('span');
      title.className = 'layer-title';
      title.textContent = l.name;
      const flag = document.createElement('em');
      flag.textContent = !l.visible ? 'hidden' : l.locked ? 'locked' : '';
      b.append(chip, title, flag);
      b.onclick = () => selectLayer(l.name);
      $('layer-list').append(b);
    }
    select.value = doc.currentLayer;
    const current = doc.layer(doc.currentLayer);
    $('layer-color').value = current.color;
    $('layer-visibility').textContent = current.visible ? 'Hide' : 'Show';
    $('layer-lock').textContent = current.locked ? 'Unlock' : 'Lock';
    const lockedVisible=doc.layers.filter(l=>l.visible&&l.locked).length;
    $('unlock-visible-layers').disabled=!lockedVisible;
    $('import-unlock-layers').hidden=!lockedVisible;
    $('layer-state').textContent=current.visible&&!current.locked?'Ready to draw on '+current.name:
      current.name+' is '+(!current.visible?'hidden':'locked')+'. Drawing will use an editable layer.';
    const properties = $('property-layer');
    if (properties) {
      const pending=properties.value;
      properties.replaceChildren();
      for (const l of doc.layers) {
        const o = document.createElement('option');
        o.value = l.name;
        o.textContent = l.name;
        properties.append(o);
      }
      if(propertyDirty.has('property-layer')&&doc.layer(pending))properties.value=pending;
    }
  }
  const propertyFields = {
    'property-layer':['layer','string'], 'property-color':['color','color'],
    'property-linewidth':['lineWidth','number'], 'property-text':['text','text'],
    'property-height':['textHeight','textNumber'], 'dim-scale':['dimensionScale','dimensionNumber'],
    'dim-arrow-size':['arrowSize','dimensionNumber'], 'dim-arrow-style':['arrowStyle','dimensionString'],
    'dim-extension-offset':['extensionOffset','dimensionNumber'], 'dim-extension-extend':['extensionExtend','dimensionNumber'],
    'dim-text-gap':['textGap','dimensionNumber'], 'dim-precision':['precision','dimensionNumber'],
    'dim-prefix':['prefix','dimensionString'], 'dim-suffix':['suffix','dimensionString'],
    'dim-line-color':['dimensionColor','dimensionColor'], 'dim-text-color':['textColor','dimensionColor']
  };
  const colorChecks = {'property-bylayer':'property-color','dim-line-bylayer':'dim-line-color','dim-text-bylayer':'dim-text-color'};
  const isText = e => e.kind==='text'||e.kind==='dimension';
  function updateProperties() {
    const list=doc.entities.filter(e=>selected.has(e.id)),key=[...selected].sort((a,b)=>a-b).join(',');
    if(key!==propertySelectionKey){propertySelectionKey=key;propertyDirty.clear();}
    $('property-type').textContent=list.length===1?list[0].kind.toUpperCase():list.length?list.length+' objects':'No selection';
    const dims=list.filter(e=>e.kind==='dimension');
    if($('dimension-properties')) $('dimension-properties').hidden=!dims.length;
    for(const[id,[field,type]] of Object.entries(propertyFields)){
      const el=$(id);if(!el)continue;
      const applicable=type.startsWith('dimension')?dims:type.startsWith('text')?list.filter(isText):list;
      el.disabled=!applicable.length;
      if(propertyDirty.has(id))continue;
      const values=applicable.map(e=>e[field]??(type.endsWith('Color')||type==='color'?null:field==='dimensionScale'?1:field==='arrowStyle'?'closed':field==='precision'?2:field==='textHeight'?12:type.includes('Number')||type==='number'?0:''));
      const mixed=values.some(v=>v!==values[0]);el.dataset.mixed=String(mixed);el.title=mixed?'Mixed values. Edit only the fields you want to change.':'';
      if(el.type==='color')el.value=values[0]|| (applicable[0]?entityColor(applicable[0]):'#e5edf5');
      else el.value=mixed?'':(values[0]??'');
      if('placeholder' in el)el.placeholder=mixed?'Mixed':field==='text'?'<> = measured value':'';
    }
    for(const[check,id]of Object.entries(colorChecks)){
      const box=$(check),el=$(id);if(!box||!el)continue;
      const field=propertyFields[id][0],applicable=id==='property-color'?list:dims;
      box.disabled=!applicable.length;
      if(!propertyDirty.has(id)){
        const inherited=applicable.filter(e=>e[field]==null).length;
        box.checked=!!applicable.length&&inherited===applicable.length;
        box.indeterminate=inherited>0&&inherited<applicable.length;
      }
      el.disabled=!applicable.length||box.checked;
    }
    $('apply-properties').disabled=!list.length;
  }
  function applyProperties() {
    if(!selected.size)throw Error('Select objects first.');
    if(!propertyDirty.size){log('No property changes to apply.');return;}
    const next=C.Document.parse(doc.serialize());
    for(const e of next.entities)if(selected.has(e.id)){
      if(!editable(doc.entities.find(x=>x.id===e.id)))throw Error('Selection contains a locked or hidden object');
      for(const id of propertyDirty){const[field,type]=propertyFields[id];if(type.startsWith('dimension')&&e.kind!=='dimension'||type.startsWith('text')&&!isText(e))continue;
        const el=$(id);let value=type==='number'||type.endsWith('Number')?Number(el.value):el.value;
        if(type==='number'||type.endsWith('Number')){if(el.value.trim()===''||!Number.isFinite(value))throw Error('Enter a valid '+field);}
        if(type==='color'||type==='dimensionColor'){const check=Object.keys(colorChecks).find(k=>colorChecks[k]===id);value=$(check).checked?null:el.value;}
        e[field]=value;
      }
      const target=next.layer(e.layer);if(!target||!target.visible||target.locked)throw Error('Target layer is hidden, locked or missing');
    }
    next.serialize();doc.checkpoint();doc.entities=next.entities;propertyDirty.clear();changed();log('Changed properties applied; other object properties were preserved.');
  }
  function defaultDimensionStyle(){
    if(doc.resources?.currentDimStyle)return window.RasmDimensions.currentStyle(doc);
    if(dimensionDefaults)return {...dimensionDefaults};
    const height=clamp(14/zoom,1e-6,1e9);
    return {textHeight:height,dimensionScale:1,arrowSize:height*.6,extensionOffset:height*.15,extensionExtend:height*.25,textGap:height*.35,precision:2,prefix:'',suffix:'',textColor:null,dimensionColor:null,arrowStyle:'closed'};
  }
  function useDimensionDefaults(){
    const selectedDimension=doc.entities.find(e=>selected.has(e.id)&&e.kind==='dimension');if(!selectedDimension)throw Error('Select a dimension first.');
    const e={...selectedDimension};for(const id of propertyDirty){const[field,type]=propertyFields[id];if(!type.startsWith('dimension')&&id!=='property-height'&&id!=='property-color')continue;const el=$(id);if(type.endsWith('Number')){if(el.value.trim()==='')throw Error('Enter a valid '+field);e[field]=Number(el.value);}else if(type==='dimensionColor'||type==='color'){const check=Object.keys(colorChecks).find(k=>colorChecks[k]===id);e[field]=$(check).checked?null:el.value;}else e[field]=el.value;}
    C.validateEntity(e);
    dimensionDefaults=Object.fromEntries(['textHeight','dimensionScale','arrowSize','extensionOffset','extensionExtend','textGap','precision','prefix','suffix','textColor','dimensionColor','arrowStyle','color'].map(k=>[k,e[k]]));
    dimTextHeight=e.textHeight;log('New-dimension defaults updated for this session. Selected objects were not changed.');
  }
  function selectLayer(name) {
    if (name !== doc.currentLayer) {
      doc.checkpoint();
      doc.currentLayer = name;
      points = [];
      changed();
    }
    updateLayers();
  }
  function addLayer(name) {
    name = name.trim();
    if (!name) throw Error('Enter a layer name.');
    if (name.length > 80 || /[\x00-\x1f]/.test(name))
      throw Error('Invalid layer name or name too long.');
    if (doc.layer(name)) {
      selectLayer(name);
      return;
    }
    if (doc.layers.length >= 4096) throw Error('Layer limit reached.');
    doc.checkpoint();
    doc.layers.push({name, color: '#69dfc3', visible: true, locked: false});
    doc.currentLayer = name;
    points = [];
    changed();
    updateLayers();
    $('layer-name').value = '';
    log('Layer created: ' + name);
  }
  function ensureDrawingLayer(){
    const current=doc.layer(doc.currentLayer);
    if(current?.visible&&!current.locked)return null;
    // Prepare the repair before changing history, so a layer-limit error leaves
    // both the drawing and Undo stack intact.
    const next=C.Document.parse(doc.serialize()),result=IO.ensureWritableLayer(next);
    doc.checkpoint();doc.layers=next.layers;doc.currentLayer=next.currentLayer;
    dirty=true;updateLayers();sync();
    log(result.message||'Drawing on editable layer '+doc.currentLayer+'. Source layer states were preserved.');
    return result;
  }
  function unlockVisibleLayers(){
    const count=doc.layers.filter(l=>l.visible&&l.locked).length;
    if(!count){log('All visible layers are already unlocked.');return;}
    doc.checkpoint();for(const l of doc.layers)if(l.visible)l.locked=false;
    updateLayers();changed();
    log('Unlocked '+count+' visible layers. Their objects can now be selected and edited. Undo restores the locks.');
  }
  function prompt() {
    if(advanced?.active){$('prompt').textContent=advanced.prompt;return;}
    if(params.acquiring){$('prompt').textContent=tool.toUpperCase()+': select objects, then Enter / right-click / Finish to continue. Shift removes.';return;}
    const at = points.length;
    const prompts = {
      select: 'Select objects. Click adds; Shift removes. Type an edit command after selecting.',
      line: at ? 'LINE: next point; Enter / right-click / Finish ends. U undo; C close.' :
                 'LINE: specify first point or enter x,y.',
      polyline: at ? 'PLINE: next point; Enter to finish, C to close.' :
                     'PLINE: specify first point.',
      rectangle: at ? 'RECTANGLE: specify opposite corner.' : 'RECTANGLE: specify first corner.',
      circle: params.circleMode==='2P'?'CIRCLE 2P: specify diameter endpoints.':params.circleMode==='3P'?'CIRCLE 3P: specify three points on the circumference.':at ? 'CIRCLE: click radius point, enter radius, or D for diameter. Finish accepts preview.' : 'CIRCLE: specify center, or enter 2P / 3P.',
      arc: at === 0 ? 'ARC: specify center.' :
          at === 1  ? 'ARC: specify start point.' :
                      'ARC: specify end direction (counterclockwise).',
      text: at ? 'TEXT: enter text in the command field.' : 'TEXT: specify insertion point.',
      dimension: at === 0 ? 'DIM: first extension point.' :
          at === 1        ? 'DIM: second extension point.' :
                            'DIM: specify dimension line location.',
      move: at ? 'MOVE: specify destination or @dx,dy.' : 'MOVE: specify base point.',
      copy: at ? 'COPY Multiple: destination or @dx,dy; U undo; Enter/Esc finish.' : 'COPY: specify base point.',
      rotate: at ? 'ROTATE: enter angle in degrees (positive counterclockwise).' :
                   'ROTATE: specify rotation center.',
      scale: at ? 'SCALE: enter positive scale factor (2 or 0.5).' : 'SCALE: specify base point.'
    };
    const extra = {
      trim:
          'TRIM: click portions to remove; U undo; Enter/Esc finish. Visible objects are boundaries (or preselect).',
      extend: 'EXTEND: click near the endpoint to extend; other visible objects are boundaries.',
      offset: params.value == null ?
          'OFFSET: enter positive distance, then click the side for selected objects.' :
          'OFFSET: click a side repeatedly; U undo; Enter/Esc finish.',
      fillet: params.value == null ?
          'FILLET: enter radius, then click the retained side of two lines.' :
          params.first ? 'FILLET: select the second line on the side to keep.' :
                         'FILLET: select the first line on the side to keep.',
      chamfer: params.value == null ? 'CHAMFER: enter distance1,distance2, then click two lines.' :
          params.first              ? 'CHAMFER: select second line.' :
                                      'CHAMFER: select first line.',
      mirror: points.length ? 'MIRROR: second point on mirror axis (creates a copy).' :
                              'MIRROR: first point on mirror axis.',
      array: 'ARRAY: enter rows,columns,dx,dy for selected objects.',
      polararray: params.count ? 'POLARARRAY: specify array center.' :
                                 'POLARARRAY: enter count,fill-angle (example 6,360).',
      distance: points.length ? 'DISTANCE: specify second point.' :
                                'DISTANCE: specify first point.',
      angle: [
        'ANGLE: specify first arm point.', 'ANGLE: specify vertex.',
        'ANGLE: specify second arm point.'
      ][points.length],
      area: 'AREA: click a circle/closed polyline, or enter polygon vertices then Enter.',
      dimlinear: points.length < 2 ?
          'DIMLINEAR: specify extension points.' :
          'DIMLINEAR: specify dimension line location (' + linearStyle + ').',
      dimangular: [
        'DIMANGULAR: first arm point.', 'DIMANGULAR: vertex.', 'DIMANGULAR: second arm point.',
        'DIMANGULAR: specify arc/text location.'
      ][points.length],
      dimradius: params.circle ? 'DIMRADIUS: specify label/leader location.' :
                                 'DIMRADIUS: select a circle/arc, then specify label location.',
      dimdiameter: params.circle ? 'DIMDIAMETER: specify label/leader location.' :
                                   'DIMDIAMETER: select a circle/arc, then specify label location.'
    };
    $('prompt').textContent = extra[tool] || prompts[tool] || 'Specify input in the command field.';
  }
  function setTool(next, focus = true) {
    if(next==='explode'&&advanced){advanced.execute('EXPLODE');return;}
    if(advanced?.active)advanced.cancel();
    if (tool==='polyline'&&points.length>=2&&next!==tool){const p=points;points=[];append(make('polyline',p,{closed:false}));}
    selected=new Set([...selected].filter(id=>doc.entities.some(e=>e.id===id&&editable(e))));
    const needsSelection=['move','copy','rotate','scale','offset','mirror','array','polararray','explode','join','erase'].includes(next);
    if ((next === 'explode' || next === 'join')&&selected.size) {
      finishEdit(E[next](doc, [...selected]));
      return;
    }
    if(['line','polyline','rectangle','circle','arc','text','dimension','dimlinear','dimangular','dimradius','dimdiameter'].includes(next))selected.clear();
    if (next !== 'select') lastTool = next;
    tool = next;
    oneShot=null;fromBase=null;awaitFrom=false;trackingAnchors=[];trackingHit=null;acquisition=null;
    points = [];
    params = {boundaries: [...selected],acquiring:needsSelection&&!selected.size};
    snapPoint = null;
    previewWorld = null;
    hovered = null;
    gesture = null;
    gripPreview = null;
    selectionCycle = null;
    if(['line','polyline','rectangle','circle','arc','text','dimension','dimlinear','dimangular','dimradius','dimdiameter'].includes(next))ensureDrawingLayer();
    prompt();
    sync();
    if (focus) $('command').focus();
  }
  function commitSelection(){
    if(!selected.size){log('Select at least one editable object, or Esc to cancel.',true);return;}
    params.acquiring=false;
    if(tool==='erase'){erase();return;}
    if(tool==='explode'||tool==='join'){finishEdit(E[tool](doc,[...selected]));return;}
    prompt();sync();log(selected.size+' objects selected. Follow the command prompt.');
  }
  function finishCommand(){
    if(advanced?.active){advanced.finish();return;}
    if(params.acquiring){commitSelection();return;}
    if(tool==='polyline'){finishPolyline(false);return;}
    if(tool==='circle'&&points.length){
      if(previewWorld&&C.distance(previewWorld,points[0])>1/zoom){acceptPoint(previewWorld);return;}
      log('Specify a valid radius point or positive radius. Esc cancels the unfinished circle.',true);return;
    }
    if(tool==='area'&&points.length>=3){const a=E.area(make('polyline',points,{closed:true}));measured({type:'area',...a},'AREA = '+fmt(a.area)+'   PERIMETER = '+fmt(a.perimeter));return;}
    if(tool==='select'){
      if(selected.size){log(selected.size+' objects selected. Choose Move, Copy, Properties, or another edit command.');return;}
      setTool(lastTool);return;
    }
    setTool('select');log('Command finished. Select objects or start another command.');
  }
  function cancelCommand(){
    if(advanced?.active)advanced.cancel();
    if(tool==='polyline'&&points.length>=2){finishPolyline(false);}else{points=[];setTool('select',false);}
    selected.clear();$('command').value='';previewWorld=null;updateSuggestions();sync();log('Command canceled. Completed geometry has been kept.');canvas.focus();
  }
  function append(entity) {
    ensureDrawingLayer();
    entity.layer = doc.currentLayer;
    C.validateEntity({...entity, id: doc.nextId});
    doc.checkpoint();
    const id=doc.add(entity);lastCreatedId=id;
    changed();
    return id;
  }
  function make(kind, p, extra = {}) {
    return {kind, points: p.map(q => ({...q})), ...extra};
  }
  function hitAt(p) {
    return S.pick(doc,p,8/zoom);
  }
  function finishEdit(ids) {
    selected = new Set(ids);
    changed();
    setTool('select');
    log('Edit completed. ' + ids.length + ' resulting objects.');
  }
  const repeating=()=>['trim','extend','offset','copy'].includes(tool);
  function repeatedEdit(ids){params.editCount=(params.editCount||0)+1;params.lastEditState=doc.serialize();changed();prompt();sync();log(tool.toUpperCase()+': edit completed. Pick again; U undo; Enter/Esc finish.');return ids;}
  function undoRepeated(){if(params.lastEditState&&doc.serialize()!==params.lastEditState){setTool('select',false);history();log('Intervening document edit undone. Repeated command ended; Undo remains available.');return;}if(!params.editCount){log('No edits in this command to undo.');return;}doc.undo();params.editCount--;params.lastEditState=doc.serialize();selected=new Set((tool==='copy'?params.copySource||[]:[...selected]).filter(id=>doc.entities.some(e=>e.id===id)));changed();prompt();sync();log('Last '+tool.toUpperCase()+' edit undone. Continue or Enter/Esc.');}
  function measured(result, message) {
    lastMeasurement = result;
    setTool('select');
    log(message);
  }
  function advancedPoint(p) {
    if (tool === 'id') {
      measured({type: 'id', point: p}, 'ID: X = ' + fmt(p.x) + '   Y = ' + fmt(p.y));
      return true;
    }
    if (tool === 'matchprop') {
      const e = hitAt(p);
      if (!e) throw Error('Pick a source/target object');
      if (!params.source) {
        params.source = e;
        log('MATCHPROP: now pick the target object.');
        return true;
      }
      const next = C.Document.parse(doc.serialize()),
            target = next.entities.find(x => x.id === e.id), source = params.source;
      target.layer = source.layer;
      target.color = source.color;
      target.lineWidth = source.lineWidth;
      target.textHeight = source.textHeight;
      next.serialize();
      doc.checkpoint();
      doc.entities = next.entities;
      finishEdit([e.id]);
      return true;
    }
    if (tool === 'trim' || tool === 'extend') {
      const e = hitAt(p);
      if (!e) throw Error('Pick an object close to the portion or endpoint to edit');
      repeatedEdit(E[tool](doc, e.id, p, params.boundaries || []));
      return true;
    }
    if (tool === 'offset') {
      if (params.value == null) throw Error('Enter offset distance first');
      repeatedEdit(E.offset(doc, [...selected], params.value, p));
      return true;
    }
    if (tool === 'fillet' || tool === 'chamfer') {
      if (params.value == null) throw Error('Enter radius or chamfer distances first');
      const e = hitAt(p);
      if (!e || e.kind !== 'line') throw Error('Pick a LINE entity');
      if (!params.first) {
        params.first = e.id;
        params.pick = p;
        prompt();
        return true;
      }
      const ids = tool === 'fillet' ?
          E.fillet(doc, params.first, e.id, params.value, params.pick, p) :
          E.chamfer(doc, params.first, e.id, params.value, params.second, params.pick, p);
      finishEdit(ids);
      return true;
    }
    if (tool === 'mirror') {
      points.push(p);
      if (points.length === 2)
        finishEdit(E.mirror(doc, [...selected], points[0], points[1], true));
      else
        prompt();
      return true;
    }
    if (tool === 'polararray') {
      if (!params.count) throw Error('Enter count,fill-angle first');
      finishEdit(E.polarArray(doc, [...selected], p, params.count, params.fill));
      return true;
    }
    if (tool === 'array') throw Error('Enter rows,columns,dx,dy in the command field');
    if (tool === 'distance') {
      points.push(p);
      if (points.length === 2) {
        const [a, b] = points, d = E.distance(a, b);
        measured(
            {type: 'distance', value: d, dx: b.x - a.x, dy: b.y - a.y},
            'DISTANCE = ' + fmt(d) + '   ΔX = ' + fmt(b.x - a.x) + '   ΔY = ' + fmt(b.y - a.y));
      } else
        prompt();
      return true;
    }
    if (tool === 'angle') {
      points.push(p);
      if (points.length === 3) {
        const a = E.angle(points[0], points[1], points[2]);
        measured({type: 'angle', value: a}, 'ANGLE = ' + fmt(a) + ' degrees');
      } else
        prompt();
      return true;
    }
    if (tool === 'area') {
      if (!points.length) {
        const e = hitAt(p);
        if (e && (e.kind === 'circle' || e.kind === 'polyline' && e.closed)) {
          const a = E.area(e);
          measured(
              {type: 'area', ...a}, 'AREA = ' + fmt(a.area) + '   PERIMETER = ' + fmt(a.perimeter));
          return true;
        }
      }
      points.push(p);
      prompt();
      schedule();
      return true;
    }
    if (['dimlinear', 'dimangular'].includes(tool)) {
      points.push(p);
      const count = tool === 'dimangular' ? 4 : 3;
      if (points.length === count) {
        append(make('dimension', points, {
          ...defaultDimensionStyle(),
          dimensionStyle: tool === 'dimangular' ? 'angular' : linearStyle,
        }));
        setTool('select');
      } else
        prompt();
      schedule();
      return true;
    }
    if (tool === 'dimradius' || tool === 'dimdiameter') {
      if (!params.circle && !points.length) {
        const e = hitAt(p);
        if (e && (e.kind === 'circle' || e.kind === 'arc')) {
          params.circle = e;
          prompt();
          return true;
        }
      }
      if (params.circle) {
        const c = params.circle.points[0], d = V.sub(p, c), length = C.distance(p, c);
        if (length < 1e-9) throw Error('Specify a label away from the center');
        const edge = V.add(c, V.mul(d, params.circle.radius / length));
        append(make('dimension', [c, edge, p], {
          ...defaultDimensionStyle(),
          dimensionStyle: tool === 'dimradius' ? 'radius' : 'diameter',
        }));
        setTool('select');
      } else {
        points.push(p);
        if (points.length === 3) {
          append(make('dimension', points, {
            ...defaultDimensionStyle(),
            dimensionStyle: tool === 'dimradius' ? 'radius' : 'diameter',
          }));
          setTool('select');
        } else
          prompt();
      }
      schedule();
      return true;
    }
    return false;
  }
  function finishPolyline(close) {
    const vertices=points.map(p=>({...p}));points=[];
    if (vertices.length >= 2) {
      append(make('polyline', vertices, {closed: close&&vertices.length>=3}));
      log('Polyline created.');
    }
    setTool('select');
  }
  function acceptPoint(p) {
    if(awaitFrom){fromBase={...p};awaitFrom=false;oneShot=null;prompt();log('FROM: enter @dx,dy or @distance<angle from the temporary base.');return;}
    if(fromBase){fromBase=null;}
    oneShot=null;
    if(advanced?.active&&advanced.acceptPoint(p))return;
    if (!Number.isFinite(p.x) || !Number.isFinite(p.y) || Math.abs(p.x) > 1e12 ||
        Math.abs(p.y) > 1e12)
      throw Error('Coordinates out of range.');
    if(params.acquiring){pick(worldToScreen(p),{});return;}
    const savedPoints=points.map(q=>({...q}));
    try {
    if (advancedPoint(p)) return;
    if (tool === 'select') {
      log('Choose a drawing tool before entering coordinates.');
      return;
    }
    if (['move', 'copy'].includes(tool)) {
      if (!points.length){
        points = [p];
        if(tool==='copy')params.copySource=[...selected];
      }else {
        const delta = V.sub(p, points[0]), next = C.Document.parse(doc.serialize());
        let ids = (tool==='copy'?params.copySource:[...selected]).filter(id => doc.entities.some(e => e.id === id && editable(e)));
        if (tool === 'copy') {
          ids = ids.map(id => {
            const e = doc.entities.find(e => e.id === id);
            return next.add({...e, id: undefined});
          });
        }
        next.transform(ids, {translation: delta});
        doc.checkpoint();
        doc.entities = next.entities;
        doc.nextId = next.nextId;
        selected = new Set(ids);
        changed();
        log(tool === 'copy' ? 'Objects copied.' : 'Objects moved.');
        if(tool==='copy')repeatedEdit(ids);else setTool('select');
      }
      prompt();
      schedule();
      return;
    }
    if (['rotate', 'scale'].includes(tool)) {
      if (!points.length)
        points = [p];
      else
        log('Enter a numeric value in the command field.');
      prompt();
      schedule();
      return;
    }
    if (tool === 'text') {
      points = [p];
      prompt();
      schedule();
      return;
    }
    if(tool==='polyline'&&points.length&&C.distance(points.at(-1),p)<1e-9)return;
    if(['dimension','dimlinear'].includes(tool)&&points.length===1&&C.distance(points[0],p)<1e-9)throw Error('Choose distinct extension points.');
    if(tool==='polyline'&&points.length)params.lastDirection=V.sub(p,points.at(-1));
    points.push(p);
    if(tool==='line'&&points.length===1){params.lineStart={...p};params.lineIds=[];}
    if (tool === 'line' && points.length === 2) {
      if (C.distance(points[0], points[1]) < 1e-9) {
        points.pop();
        log('Same point. Double-click or Finish to end the LINE command.');return;
      }
      const id=append(make('line', points));params.lineIds.push(id);
      params.lastDirection=V.sub(points[1],points[0]);
      points = [p];
    } else if (tool === 'rectangle' && points.length === 2) {
      const [a, b] = points;
      if (Math.abs(a.x - b.x) < 1e-9 || Math.abs(a.y - b.y) < 1e-9) {
        points.pop();
        throw Error('Rectangle requires nonzero width and height.');
      }
      append(make('polyline', [a, {x: b.x, y: a.y}, b, {x: a.x, y: b.y}], {closed: true}));
      setTool('select');
    } else if (tool === 'circle' && (points.length === (params.circleMode==='3P'?3:2))) {
      let center=points[0],r=C.distance(points[0],points[1]);
      if(params.circleMode==='2P'){center=V.mul(V.add(points[0],points[1]),.5);r/=2;}
      if(params.circleMode==='3P'){const circle=Commands.circleThrough3Points(...points);center=circle.center;r=circle.radius;}
      if (r < 1e-9) {
        points.pop();
        throw Error('Radius must be positive.');
      }
      append(make('circle', [center], {radius: r}));
      setTool('select');
    } else if (tool === 'arc' && points.length === 3) {
      const [c, a, b] = points, r = C.distance(c, a);
      if (r < 1e-9) {
        points.pop();
        points.pop();
        throw Error('Arc radius must be positive.');
      }
      append(make('arc', [c], {
        radius: r,
        startAngle: Math.atan2(a.y - c.y, a.x - c.x),
        endAngle: Math.atan2(b.y - c.y, b.x - c.x)
      }));
      setTool('select');
    } else if (tool === 'dimension' && points.length === 3) {
      if (C.distance(points[0], points[1]) < 1e-9) {
        points.pop();
        points.pop();
        throw Error('Choose different extension points.');
      }
      append(make('dimension', points, defaultDimensionStyle()));
      setTool('select');
    }
    prompt();
    sync();
    }catch(error){points=savedPoints;prompt();schedule();throw error;}
  }
  function constrained(px) {
    let p = screenToWorld(px);
    snapPoint = null;
    snapType='';
    snapWarning='';trackingHit=null;
    const base=fromBase||advanced?.basePoint||points.at(-1)||null;
    if(snap||oneShot){
      const hit=window.RasmSnaps.find(doc,p,aperture/zoom,{modes:oneShot==='none'?[]:oneShot?[oneShot]:advanced?.snapModes,priority:snapPriority,base,excludeIds:gesture?.kind==='grip'?[gesture.id]:[],onWarning:w=>{snapWarning=w;}});
      if(hit){p={...hit.point};snapPoint=p;snapType=hit.type;}
      if(otrack&&hit&&['endpoint','midpoint','center','intersection','quadrant'].includes(hit.type)){
        const now=performance.now();if(!acquisition||C.distance(acquisition.point,hit.point)>1e-9)acquisition={point:{...hit.point},since:now};
        else if(now-acquisition.since>=350&&!trackingAnchors.some(a=>C.distance(a,hit.point)<1e-9)){trackingAnchors.push({...hit.point});if(trackingAnchors.length>4)trackingAnchors.shift();}
      }else acquisition=null;
    }
    if(!snapPoint&&oneShot!=='none'&&(otrack||polarIncrement)&&(tool!=='select'||advanced?.active&&!advanced?.acquiring&&!advanced?.textInput)){
      trackingHit=window.RasmTracking.constrain(p,base,otrack?trackingAnchors:[],aperture/zoom,polarIncrement);
      if(trackingHit){p={...trackingHit.point};snapType=trackingHit.type;}
    }
    if (!snapPoint && !trackingHit && ortho && points.length &&
        ['line', 'polyline', 'move', 'copy'].includes(tool)) {
      const b = points.at(-1);
      if (Math.abs(p.x - b.x) > Math.abs(p.y - b.y))
        p.y = b.y;
      else
        p.x = b.x;
    }
    return p;
  }
  function transformNumber(value) {
    if (!points.length) throw Error('Specify base point first.');
    if (tool === 'scale' && value <= 0) throw Error('Scale factor must be positive.');
    const options = {pivot: points[0]};
    if (tool === 'rotate')
      options.rotation = value * Math.PI / 180;
    else
      options.scale = value;
    const ids = [...selected].filter(id => doc.entities.some(e => e.id === id && editable(e)));
    doc.checkpoint();
    doc.transform(ids, options);
    changed();
    log('Selected objects updated.');
    setTool('select');
  }
  function erase() {
    const ids = [...selected].filter(id => doc.entities.some(e => e.id === id && editable(e)));
    if (!ids.length){setTool('erase');return;}
    doc.checkpoint();
    doc.erase(ids);
    selected.clear();
    setTool('select', false);
    changed();
    log('Erased ' + ids.length + ' objects.');
  }
  function history(redo = false) {
    if(!redo&&repeating()){undoRepeated();return;}
    if(!redo&&tool==='line'&&params.lineIds?.length){execute('U');return;}
    if(!redo&&tool==='polyline'&&points.length>1){points.pop();prompt();schedule();log('Last polyline vertex undone.');return;}
    points=[];
    if (redo ? doc.redo() : doc.undo()) {
      selected.clear();
      setTool('select', false);
      changed();
      updateLayers();
      log(redo ? 'Redo.' : 'Undo.');
    }
  }
  function fit() {
    const b = doc.bounds();
    if (!b.valid) {
      camera = {x: 300, y: 200};
      zoom = 1;
    } else {
      camera = V.mul(V.add(b.min, b.max), .5);
      zoom = clamp(
          Math.min(
              Math.max(40, W - 100) / Math.max(1, b.max.x - b.min.x),
              Math.max(40, H - 100) / Math.max(1, b.max.y - b.min.y)),
          .00001, 10000);
    }
    schedule();
  }
  function parsePoint(input) {
    return Commands.parsePoint(input,fromBase||points.at(-1)||null);
  }
  function updateSuggestions(){
    const value=$('command').value;
    suggestions=tool==='text'&&points.length?[]:Commands.suggest(value);
    suggestionIndex=-1;renderSuggestions();
  }
  function renderSuggestions(){
    const list=$('suggestions');list.replaceChildren();list.hidden=!suggestions.length;
    $('command').setAttribute('aria-expanded',String(!!suggestions.length));
    $('command').removeAttribute('aria-activedescendant');
    suggestions.forEach((entry,index)=>{
      const item=document.createElement('li');item.id='suggestion-'+index;
      item.role='option';item.setAttribute('aria-selected',String(index===suggestionIndex));
      item.classList.toggle('active',index===suggestionIndex);
      item.textContent=entry.name+' — '+entry.description;
      item.addEventListener('mousedown',e=>{e.preventDefault();completeSuggestion(index);});
      list.append(item);
      if(index===suggestionIndex)$('command').setAttribute('aria-activedescendant',item.id);
    });
  }
  function completeSuggestion(index=0){
    if(!suggestions[index])return;
    $('command').value=suggestions[index].name+' ';suggestions=[];suggestionIndex=-1;renderSuggestions();$('command').focus();
  }
  function submitCommand(){
    if(suggestionIndex>=0&&suggestions[suggestionIndex])$('command').value=suggestions[suggestionIndex].name;
    const value=$('command').value;
    if(value.trim()){
      if(inputHistory.at(-1)!==value)inputHistory.push(value);
      if(inputHistory.length>100)inputHistory.shift();
      log('Command: '+value);
    }
    historyIndex=inputHistory.length;historyDraft='';execute(value);
  }
  function downloadDiagnostics(){
    const result={application:'RasmCAD Advanced',version:VERSION,generatedAt:new Date().toISOString(),
      browser:navigator.userAgent,devicePixelRatio:window.devicePixelRatio,viewport:{width:W,height:H},camera,zoom,
      tool,entityCount:doc.entities.length,selectedCount:selected.size,unfinishedPoints:points.length,
      history:commandHistory.slice(-100),errors:diagnosticEvents.slice()};
    download(JSON.stringify(result,null,2),'RasmCAD-'+VERSION+'-diagnostics.json','application/json');
    log('Diagnostics downloaded. Review the file before sharing: recent command text is included.');
  }
  function execute(input, optionOnly=false) {
    input = String(input).trim();
    $('command').value = '';
    updateSuggestions();
    if (!input) {
      finishCommand();
      return;
    }
    if(!(tool==='text'&&points.length)&&!advanced?.textInput){
      const [word,...words]=Commands.normalizeInput(input).toUpperCase().split(/\s+/),rest=words.join(' ');
      const modes={END:'endpoint',MID:'midpoint',CEN:'center',QUA:'quadrant',INT:'intersection',PER:'perpendicular',TAN:'tangent',NEA:'nearest',NON:'none'};
      if(modes[word]&&!rest){if(tool==='select'&&!advanced?.active)throw Error('Start a point-based command before using a snap override.');oneShot=modes[word];log(word+': next picked point only. Running snaps are preserved.');return;}
      if(word==='APERTURE'){const n=Number(rest);if(!rest||!Number.isFinite(n)||n<1||n>50)throw Error('APERTURE requires 1..50 screen pixels.');aperture=n;log('Snap aperture = '+n+' pixels.');return;}
      if(word==='SNAPPRIORITY'){const names=rest.toLowerCase().split(/[,\s]+/);if(rest==='DEFAULT')snapPriority=null;else{if(!rest||names.some(n=>!window.RasmSnaps.modes.includes(n)))throw Error('SNAPPRIORITY: full mode names in order, or DEFAULT.');snapPriority=names;}log('Snap priority updated.');return;}
      if(['POLAR','OTRACK','DYNMODE'].includes(word)){if(!/^(ON|OFF)(?:\s+\d+(?:\.\d+)?)?$/.test(rest))throw Error(word+': use ON or OFF; POLAR ON may include an angle increment.');const on=words[0]==='ON';if(word==='POLAR'){const n=words[1]?Number(words[1]):90;if(!(n>0&&n<=180))throw Error('POLAR increment must be 0..180 degrees, excluding zero.');polarIncrement=on?n:0;}else if(word==='OTRACK'){otrack=on;trackingAnchors=[];}else dynamicInput=on;log(word+' '+rest);return;}
      if(word==='TRACK'&&!rest){if(!snapPoint)throw Error('Hover an exact snap point first, then TRACK.');otrack=true;trackingAnchors.push({...snapPoint});if(trackingAnchors.length>4)trackingAnchors.shift();log('Object tracking point acquired.');return;}
      if(word==='FROM'&&!rest){if(tool==='select'&&!advanced?.active)throw Error('Start a drawing/edit point prompt first.');awaitFrom=true;fromBase=null;log('FROM: pick temporary base, then enter @dx,dy or @distance<angle.');return;}
      if(repeating()&&['U','UNDO'].includes(word)&&!rest){undoRepeated();return;}
      if(tool==='copy'&&['M','MULTIPLE'].includes(word)&&!rest){log('COPY uses Multiple mode. Pick base/destinations; U undo; Enter/Esc finish.');return;}
    }
    if(advanced?.active||/^(STRETCH|BREAK|LENGTHEN|ALIGN|PEDIT|SPLINEDIT|SPLINE|OVERKILL|EXPLODE|EXPLOAD|HATCH|HATCHEDIT|BOUNDARY|REGION|BLOCK|INSERT|WBLOCK|BEDIT|REFEDIT|BCLOSE|ATTDEF|ATTEDIT|ATTSYNC|DIMSTYLE|DIMCONTINUE|DIMBASELINE|DIMORDINATE|DIMEDIT|QLEADER|MLEADER|MLEADEREDIT|OSNAPSET)(?:\s|$)/i.test(input)){if(advanced.execute(input))return;}
    if(params.acquiring){const p=parsePoint(input);if(p){acceptPoint(p);return;}if(['ALL','A'].includes(input.toUpperCase())){selected=new Set(doc.entities.filter(editable).map(e=>e.id));sync();return;}throw Error('Select objects, then press Enter. Esc cancels.');}
    if (tool === 'text' && points.length) {
      append(make('text', [points[0]], {text: input, textHeight:clamp(14/zoom,1e-6,1e9)}));
      setTool('select');
      log('Text created.');
      return;
    }
    input=Commands.normalizeInput(input);
    if (tool === 'polyline' && input.toUpperCase() === 'C') {
      finishPolyline(true);
      return;
    }
    if(tool==='line'&&input.toUpperCase()==='C'){if(!params.lineStart||!params.lineIds?.length)throw Error('Draw line segments before Close.');if(C.distance(points[0],params.lineStart)>1e-9)append(make('line',[points[0],params.lineStart]));setTool('select');return;}
    if(tool==='line'&&['U','UNDO'].includes(input.toUpperCase())){const id=params.lineIds?.at(-1),e=doc.entities.find(e=>e.id===id);if(!e){log('No more segments in this LINE command to undo.');return;}const start={...e.points[0]};doc.undo();params.lineIds.pop();points=[start];changed();prompt();log('Last LINE segment undone. Continue drawing or Finish.');return;}
    if(tool==='polyline'&&['U','UNDO'].includes(input.toUpperCase())){if(points.length>1)points.pop();prompt();schedule();return;}
    if(tool==='circle'&&!points.length&&['2P','3P'].includes(input.toUpperCase())){params.circleMode=input.toUpperCase();prompt();return;}
    if(tool==='circle'&&points.length===1&&!params.circleMode&&input.toUpperCase()==='D'){params.circleDiameter=true;prompt();log('CIRCLE: enter diameter (not radius).');return;}
    if (tool === 'array') {
      const a = input.split(/[,\s]+/).map(Number);
      if (a.length !== 4 || a.some(v => !Number.isFinite(v)))
        throw Error('Enter rows,columns,dx,dy');
      finishEdit(E.rectangularArray(doc, [...selected], ...a));
      return;
    }
    if (tool === 'polararray' && !params.count) {
      const a = input.split(/[,\s]+/).map(Number);
      if (a.length < 1 || a.length > 2 || !Number.isInteger(a[0]) || a[0] < 2 ||
          a.some(v => !Number.isFinite(v)))
        throw Error('Enter integer count and optional fill angle');
      params.count = a[0];
      params.fill = a[1] ?? 360;
      prompt();
      return;
    }
    if (['offset', 'fillet', 'chamfer'].includes(tool) && params.value == null) {
      const a = input.split(/[,\s]+/).map(Number);
      if (a.length > 2 || a.some(v => !Number.isFinite(v)) || a[0] < 0 ||
          (tool === 'offset' && a[0] === 0))
        throw Error('Enter a valid distance/radius');
      params.value = a[0];
      params.second = a[1] ?? a[0];
      prompt();
      return;
    }
    const point = parsePoint(input);
    if (point) {
      acceptPoint(point);
      return;
    }
    if (/^[+-]?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?$/i.test(input)) {
      const v = Number(input);
      if (!Number.isFinite(v)) throw Error('Enter a valid number.');
      if(['line','polyline'].includes(tool)){
        if(!points.length)throw Error('Specify the first point before entering a length.');
        const base=points.at(-1),cursor=previewWorld||(mouse?constrained(mouse):null);
        const endpoint=Commands.distancePoint(base,v,cursor,{ortho,lastDirection:params.lastDirection});
        params.lastDirection=V.sub(endpoint,base);
        acceptPoint(endpoint);mouse=null;previewWorld={...endpoint};
        log(tool.toUpperCase()+': length '+fmt(v)+' committed. Enter or Esc ends drawing; click or enter the next segment.');
        sync();return;
      }
      if (tool === 'circle' && points.length&&!params.circleMode) {
        if (v <= 0) throw Error('Radius must be positive.');
        acceptPoint({x: points[0].x + v/(params.circleDiameter?2:1), y: points[0].y});
        return;
      }
      if (['rotate', 'scale'].includes(tool)) {
        transformNumber(v);
        return;
      }
      throw Error('This command needs a point or a command name. For a point enter x,y.');
    }
    const match = input.match(/^(\S+)(?:\s+([\s\S]*))?$/), name = match[1].toUpperCase(),
          rest = match[2] || '';
    const aliases = {
      L: 'line',
      LINE: 'line',
      PL: 'polyline',
      PLINE: 'polyline',
      POLYLINE: 'polyline',
      REC: 'rectangle',
      RECTANGLE: 'rectangle',
      C: 'circle',
      CIRCLE: 'circle',
      A: 'arc',
      ARC: 'arc',
      T: 'text',
      TEXT: 'text',
      DTEXT: 'text',
      MTEXT: 'text',
      DIM: 'dimension',
      DIMALIGNED: 'dimension',
      DAL: 'dimension',
      M: 'move',
      MOVE: 'move',
      CO: 'copy',
      COPY: 'copy',
      RO: 'rotate',
      ROTATE: 'rotate',
      SC: 'scale',
      SCALE: 'scale',
      SELECT: 'select',
      TR: 'trim',
      TRIM: 'trim',
      EX: 'extend',
      EXTEND: 'extend',
      O: 'offset',
      OFFSET: 'offset',
      F: 'fillet',
      FILLET: 'fillet',
      CHA: 'chamfer',
      CHAMFER: 'chamfer',
      MI: 'mirror',
      MIRROR: 'mirror',
      AR: 'array',
      ARRAY: 'array',
      ARRAYRECT: 'array',
      POLARARRAY: 'polararray',
      ARRAYPOLAR: 'polararray',
      X: 'explode',
      EXPLODE: 'explode',
      J: 'join',
      JOIN: 'join',
      DI: 'distance',
      DIST: 'distance',
      DISTANCE: 'distance',
      ANGLE: 'angle',
      AREA: 'area',
      AA: 'area',
      DIMLINEAR: 'dimlinear',
      DLI: 'dimlinear',
      DIMANGULAR: 'dimangular',
      DAN: 'dimangular',
      DIMRADIUS: 'dimradius',
      DRA: 'dimradius',
      DIMDIAMETER: 'dimdiameter',
      DDI: 'dimdiameter',
      PAN: 'pan',
      ID: 'id',
      MATCHPROP: 'matchprop',
      MA: 'matchprop'
    };
    if (name === 'DIMHORIZONTAL' || name === 'DIMVERTICAL') {
      linearStyle = name === 'DIMHORIZONTAL' ? 'horizontal' : 'vertical';
      setTool('dimlinear');
      return;
    }
    const dimensionVariables={DIMTXT:'textHeight',DIMSCALE:'dimensionScale',DIMASZ:'arrowSize',DIMEXO:'extensionOffset',DIMEXE:'extensionExtend',DIMGAP:'textGap',DIMDEC:'precision'};
    if (dimensionVariables[name]) {
      const v = Number(rest);
      const field=dimensionVariables[name];if(!rest||!Number.isFinite(v)||v<0||(['textHeight','dimensionScale','arrowSize'].includes(field)&&v===0)||field==='precision'&&(!Number.isInteger(v)||v>8))throw Error('Invalid '+name+' value');
      dimensionDefaults={...defaultDimensionStyle(),[field]:v};dimTextHeight=dimensionDefaults.textHeight;
      log(name+' = '+v+' for new dimensions. Select existing dimensions and use Properties to change them.');
      return;
    }
    if (name === 'DIMLINEAR' || name === 'DLI') linearStyle = 'horizontal';
    if(optionOnly||(tool!=='select'&&/^[A-Z]$/.test(name)&&!['U'].includes(name)))throw Error(tool.toUpperCase()+': unsupported option '+input+'. See HELP for supported options.');
    if (aliases[name]) {
      setTool(aliases[name]);
      if (rest) {
        for (const token of rest.split(/\s+/)) execute(token,true);
      }
      return;
    }
    if (name === 'LAYER') {
      addLayer(rest);
      return;
    }
    const actions = {
      Z: fit,
      ZOOM: fit,
      ZOOMEXTENTS: fit,
      U: () => history(),
      UNDO: () => history(),
      REDO: () => history(true),
      MREDO: () => history(true),
      E: erase,
      ERASE: erase,
      SAVE: save,
      SAVEAS: save,
      QSAVE: save,
      OPEN: () => openPicker(),
      IMPORT: () => openPicker(),
      DXFIN: () => openPicker(),
      DXFOUT: exportDxf,
      EXPORT: exportDxf,
      NEW: () => newDrawing(),
      QNEW: () => newDrawing(),
      DEMO: () => example(),
      HELP: () => showHelp(),
      GRID: () => toggle('grid'),
      SNAP: () => toggle('snap'),
      OSNAP: () => toggle('snap'),
      ORTHO: () => toggle('ortho'),
      REGEN: schedule,
      REDRAW: schedule,
      PLOT: printDrawing,
      PRINT: printDrawing,
      PROPERTIES: () => $('sidebar').classList.add('open'),
      LIST: () => log(JSON.stringify(doc.entities.filter(e => selected.has(e.id)))),
      SELECTALL: () => {
        selected = new Set(doc.entities.filter(editable).map(e => e.id));
        sync();
      }
    };
    if (actions[name]) {
      actions[name]();
      return;
    }
    throw Error('Unknown command. Enter HELP or coordinates as x,y.');
  }
  function confirmReplace() {
    return !dirty ||
        window.confirm(
            'Unsaved changes. Cancel and Save project to keep them, or OK to discard them.');
  }
  function setDocument(next, name, saved) {
    const layerRecovery=IO.ensureWritableLayer(next);
    // Replacing a document must not finish an old PLINE into the new document.
    // Clear the old construction state before setTool can inspect it.
    points=[];params={};gesture=null;gripPreview=null;mouse=null;previewWorld=null;
    doc = next;
    filename = name;
    dimensionDefaults=null;propertyDirty.clear();propertySelectionKey='';lastCreatedId=null;
    selected.clear();
    setTool('select', false);
    dirty = !saved||layerRecovery.changed;
    updateLayers();
    fit();
    sync();
    return layerRecovery;
  }
  function newDrawing() {
    if(advanced&&!advanced.guardReplace())return;
    if (confirmReplace()) {
      setDocument(new C.Document(), 'Drawing', true);
      log('Untitled drawing.');
    }
  }
  function example() {
    if(advanced&&!advanced.guardReplace())return;
    if (confirmReplace()) {
      setDocument(C.sampleDocument(), 'Example', false);
      log('Example plan opened: ' + doc.entities.length + ' editable objects.');
    }
  }
  function download(content, name, mime) {
    const blob = content instanceof Blob ? content : new Blob([content], {type: mime});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.hidden = true;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 20000);
    downloadSerial++;
  }
  function save() {
    const data = doc.serialize();
    download(data, filename + '.rasm.json', 'application/json;charset=utf-8');
    dirty = false;
    sync();
    log('Downloaded ' + filename + '.rasm.json to browser downloads. Keep the latest version.');
  }
  function openPicker() {
    if(advanced&&!advanced.guardReplace())return;
    if (confirmReplace()) {
      $('file-input').value = '';
      $('file-input').click();
    }
  }
  async function loadFile(file) {
    if(advanced&&!advanced.guardReplace())throw Error('Close block editing before opening another drawing.');
    if (!file) return;
    if (file.size > 64 * 1024 * 1024) throw Error('File exceeds 64 MiB.');
    if (busy) throw Error('An import is already running');
    busy = true;
    document.querySelector('main').inert = true;
    document.querySelector('.actions').inert = true;
    log('Reading ' + file.name + ' locally. DWG may take several seconds...');
    $('open-btn').disabled = true;
    try {
      await new Promise(r => setTimeout(r, 50));
      const result = await IO.importFile(new Uint8Array(await file.arrayBuffer()), file.name);
      const name = file.name.replace(/(?:\.rasm)?\.json$|\.(?:rcad|dxf|dwg|dwt|dws|bak|sv\$)$/i, '') || 'Drawing';
      const layerRecovery=setDocument(result.document, name, /\.json$/i.test(file.name));
      if(layerRecovery.changed&&layerRecovery.message)result.warnings.push(layerRecovery.message);
      log('Opened ' + file.name + ' — ' + doc.entities.length + ' objects. ' +
          result.warnings.length + ' import notices.');
      const editableCount=doc.entities.filter(editable).length;
      $('import-report-content').textContent = 'Source: ' + result.sourceFormat +
          '\nImported objects: ' + doc.entities.length + '\nCurrently selectable objects: '+editableCount+
          '\nCurrent drawing layer: '+doc.currentLayer+' (visible and unlocked)\n\n' +
          (result.warnings.length ? result.warnings.join('\n') :
                                    'No import notices for the supported objects.');
      if (result.warnings.length) $('import-report').showModal();
    } finally {
      busy = false;
      document.querySelector('main').inert = false;
      document.querySelector('.actions').inert = false;
      $('open-btn').disabled = false;
    }
  }
  function exportDxf() {
    download(C.exportDxf(doc), filename + '.dxf', 'application/dxf;charset=utf-8');
    log('DXF exported. Also save the native project to retain editable dimension objects.');
  }
  function exportPng() {
    const oldMouse = mouse, oldSelected = selected;
    mouse = null;
    selected = new Set();
    render(true);
    canvas.toBlob(blob => {
      if (blob) download(blob, filename + '.png', 'image/png');
    }, 'image/png');
    mouse = oldMouse;
    selected = oldSelected;
    schedule();
    log('Current view exported as PNG.');
  }
  function printDrawing() {
    if(plotUI){plotUI.show();return;}
    render(true);
    const image = canvas.toDataURL('image/png');
    const win = window.open('', '_blank');
    if (!win)
      throw Error(
          'The browser blocked the print window. Allow this user-initiated window to print.');
    win.document.open();
    win.document.write(
        '<!doctype html><title>RasmCAD drawing</title><style>@page{size:landscape;margin:12mm}body{margin:0;background:white}img{width:100%;max-height:95vh;object-fit:contain}</style><img alt="RasmCAD drawing">');
    win.document.close();
    win.document.querySelector('img').src = image;
    win.document.querySelector('img').onload = () => {
      win.focus();
      win.print();
    };
    schedule();
  }
  function toggle(which) {
    if (which === 'grid') grid = !grid;
    if (which === 'snap') snap = !snap;
    if (which === 'ortho') ortho = !ortho;
    sync();
  }
  function showHelp() {
    const d = $('help-dialog');
    if (!d.open) d.showModal();
  }
  function line(a, b, color, width = 1, dash = []) {
    const clipped=View.clipSegment(worldToScreen(a),worldToScreen(b),W,H,Math.max(2,width));
    if(!clipped)return;
    a=clipped.a;b=clipped.b;
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.setLineDash(dash);
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
    ctx.setLineDash([]);
  }
  function text(p, value, height, color, angle = 0) {
    const s = worldToScreen(p), size = clamp(height * zoom, 0, 600);
    if (size < 2) return;
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(-angle);
    ctx.fillStyle = color;
    ctx.font = size + 'px Tahoma, Arial, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.direction = 'ltr';
    ctx.fillText(value, 0, 0);
    ctx.restore();
  }
  function drawEntity(e, color, width = 1) {
    const p = e.points;
    if (!p.length) return;
    if(e.kind==='compound'){for(const part of e.parts||[])drawEntity(part,selected.has(e.id)||hovered===e.id?color:(part.color||color),width);return;}
    if(e.kind==='solid'){ctx.beginPath();p.forEach((q,i)=>{const at=worldToScreen(q);if(i)ctx.lineTo(at.x,at.y);else ctx.moveTo(at.x,at.y);});ctx.closePath();ctx.fillStyle=color;ctx.fill();return;}
    if (e.kind === 'line' || e.kind === 'polyline') {
      for (let i = 1; i < p.length; i++) line(p[i - 1], p[i], color, width);
      if (e.closed) line(p.at(-1), p[0], color, width);
    } else if (e.kind === 'circle' || e.kind === 'arc') {
      ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=width;
      for(const path of View.arcPolylines(e,currentView())){
        ctx.moveTo(path[0].x,path[0].y);
        for(let i=1;i<path.length;i++)ctx.lineTo(path[i].x,path[i].y);
      }
      ctx.stroke();
    } else if (e.kind === 'text')
      text(p[0], e.text, e.textHeight, color, e.startAngle);
    else if (e.kind === 'dimension') {
      const g = C.annotationGeometry(e);
      const override=selected.has(e.id)||hovered===e.id;
      for(const f of g.fills||[]){ctx.beginPath();f.points.forEach((p,i)=>{const s=worldToScreen(p);if(i)ctx.lineTo(s.x,s.y);else ctx.moveTo(s.x,s.y);});ctx.closePath();ctx.fillStyle=override?color:(f.color||color);ctx.fill();}
      for (const s of g.segments) line(s.a, s.b, override?color:(s.color||color), width);
      for (const a of g.arcs)
        drawEntity(
            {
              kind: 'arc',
              points: [a.center],
              radius: a.radius,
              startAngle: a.startAngle,
              endAngle: a.endAngle
            },
            override?color:(a.color||color), width);
      for (const l of g.labels) text(l.point, l.text, l.height, override?color:(l.color||color), l.angle || 0);
    }
  }
  function preview() {
    if(advanced?.active){for(const e of advanced.preview())drawEntity(e,accent);return;}
    if (!points.length||params.acquiring) return;
    const p = mouse ? constrained(mouse) : points.at(-1);
    let e;
    if (tool === 'line' || tool === 'polyline') e = make('polyline', [...points, p]);
    if (tool === 'rectangle') {
      const a = points[0];
      e = make('polyline', [a, {x: p.x, y: a.y}, p, {x: a.x, y: p.y}], {closed: true});
    }
    if (tool === 'circle'&&!params.circleMode) e = make('circle', [points[0]], {radius: C.distance(points[0], p)});
    if(tool==='circle'&&params.circleMode==='2P')e=make('circle',[V.mul(V.add(points[0],p),.5)],{radius:C.distance(points[0],p)/2});
    if(tool==='circle'&&params.circleMode==='3P'){if(points.length===1)line(points[0],p,accent,1,[4,4]);else{try{const circle=Commands.circleThrough3Points(...points,p);e=make('circle',[circle.center],{radius:circle.radius});}catch(_){/* Collinear preview has no circle. */}}}
    if (tool === 'arc') {
      const c = points[0], a = points[1] || p;
      e = make('arc', [c], {
        radius: C.distance(c, a),
        startAngle: points.length > 1 ? Math.atan2(a.y - c.y, a.x - c.x) : 0,
        endAngle: Math.atan2(p.y - c.y, p.x - c.x)
      });
    }
    if (tool === 'dimension' && points.length === 1) line(points[0], p, accent, 1, [4, 4]);
    if (tool === 'dimension' && points.length === 2 && C.distance(points[0], points[1]) > 1e-9)
      e = make('dimension', [...points, p], defaultDimensionStyle());
    if(tool==='dimlinear'&&points.length===2)e=make('dimension',[...points,p],{...defaultDimensionStyle(),dimensionStyle:linearStyle});
    if(tool==='dimangular'&&points.length===3){try{const d=make('dimension',[...points,p],{...defaultDimensionStyle(),dimensionStyle:'angular'});C.annotationGeometry(d);e=d;}catch{}}
    if(['dimradius','dimdiameter'].includes(tool)&&params.circle){const c=params.circle.points[0],length=C.distance(c,p);if(length>1e-9)e=make('dimension',[c,V.add(c,V.mul(V.sub(p,c),params.circle.radius/length)),p],{...defaultDimensionStyle(),dimensionStyle:tool==='dimradius'?'radius':'diameter'});}
    if (tool === 'text') text(points[0], 'Enter text...', 12, accent);
    if (tool === 'move' || tool === 'copy') {
      const delta = V.sub(p, points[0]);
      for (const item of doc.entities)
        if (selected.has(item.id) && editable(item)) {
          drawEntity({...item, points: item.points.map(q => V.add(q, delta))}, accent);
        }
      line(points[0], p, accent, 1, [4, 4]);
    }
    if (e) drawEntity(e, accent);
    for (const p of points) {
      const s = worldToScreen(p);
      ctx.fillStyle = accent;
      ctx.fillRect(s.x - 2, s.y - 2, 4, 4);
    }
  }
  function render(clean = false) {
    const previousSelection=selected,previousHover=hovered;
    if(clean){selected=new Set();hovered=null;}
    try{
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = '#101b27';
    ctx.fillRect(0, 0, W, H);
    if (grid) {
      let step = Math.pow(10, Math.floor(Math.log10(65 / zoom)));
      if (step * zoom < 24)
        step *= 5;
      else if (step * zoom < 40)
        step *= 2;
      const a = screenToWorld({x: 0, y: H}), b = screenToWorld({x: W, y: 0});
      let count = 0;
      for (let x = Math.ceil(a.x / step) * step; x <= b.x && count < 500; x += step, count++)
        line({x, y: a.y}, {x, y: b.y}, '#203141');
      count = 0;
      for (let y = Math.ceil(a.y / step) * step; y <= b.y && count < 500; y += step, count++)
        line({x: a.x, y}, {x: b.x, y}, '#203141');
    }
    for (const original of doc.entities) {
      const e=gripPreview&&gripPreview.id===original.id?gripPreview:original;
      if (visible(e)) {
        drawEntity(
            e, selected.has(e.id) ? accent : hovered===e.id?'#a4e8ff':entityColor(e),
            selected.has(e.id)||hovered===e.id ? 2 : clamp(e.lineWidth || 1, 1, 4));
        if (selected.has(e.id))
          for (const handle of G.handles(e)) {
            const s = worldToScreen(handle.point);
            ctx.fillStyle = accent;
            ctx.fillRect(s.x - 4, s.y - 4, 8, 8);
          }
      }
    }
    if (!clean) preview();
    if (mouse && !clean) {
      ctx.strokeStyle = '#9bb5c6';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(mouse.x - 18, mouse.y);
      ctx.lineTo(mouse.x + 18, mouse.y);
      ctx.moveTo(mouse.x, mouse.y - 18);
      ctx.lineTo(mouse.x, mouse.y + 18);
      ctx.stroke();
      if(trackingHit){for(const anchor of trackingHit.anchors)line(anchor,trackingHit.point,'#efb957',1,[5,5]);}
      for(const anchor of trackingAnchors){const q=worldToScreen(anchor);ctx.strokeStyle='#efb957';ctx.beginPath();ctx.moveTo(q.x-4,q.y-4);ctx.lineTo(q.x+4,q.y+4);ctx.moveTo(q.x-4,q.y+4);ctx.lineTo(q.x+4,q.y-4);ctx.stroke();}
      if(dynamicInput&&points.length&&previewWorld){const b=fromBase||points.at(-1),dx=previewWorld.x-b.x,dy=previewWorld.y-b.y;ctx.font='12px sans-serif';ctx.fillStyle='#ffdb82';ctx.fillText($('command').value||('D '+fmt(Math.hypot(dx,dy))+'  < '+fmt(Math.atan2(dy,dx)*180/Math.PI)),mouse.x+20,mouse.y-18);}
      if (snapPoint) {
        const s = worldToScreen(snapPoint);
        ctx.strokeStyle = '#ffdb82';
        ctx.strokeRect(s.x - 5, s.y - 5, 10, 10);
      }
    }
    if (gesture?.kind === 'select' && gesture.moved && mouse) {
      const crossing=mouse.x<gesture.start.x;
      ctx.strokeStyle = crossing?'#69dfc3':'#7db8ff';
      ctx.fillStyle = crossing?'#69dfc318':'#7db8ff18';
      const x = Math.min(gesture.start.x, mouse.x), y = Math.min(gesture.start.y, mouse.y),
            w = Math.abs(gesture.start.x - mouse.x), h = Math.abs(gesture.start.y - mouse.y);
      ctx.fillRect(x, y, w, h);
      ctx.setLineDash(crossing?[5,4]:[]);
      ctx.strokeRect(x, y, w, h);
      ctx.setLineDash([]);
    }
    ctx.lineWidth = 1.5;
    ctx.strokeStyle = '#f29197';
    ctx.beginPath();
    ctx.moveTo(29, H - 28);
    ctx.lineTo(65, H - 28);
    ctx.stroke();
    ctx.strokeStyle = '#77d9b3';
    ctx.beginPath();
    ctx.moveTo(29, H - 28);
    ctx.lineTo(29, H - 64);
    ctx.stroke();
    ctx.font = '10px Arial';
    ctx.fillStyle = '#f29197';
    ctx.fillText('X', 70, H - 24);
    ctx.fillStyle = '#77d9b3';
    ctx.fillText('Y', 25, H - 71);
    }finally{if(clean){selected=previousSelection;hovered=previousHover;}}
  }
  function resize() {
    const r = wrap.getBoundingClientRect();
    W = Math.max(1, r.width);
    H = Math.max(1, r.height);
    dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    schedule();
  }
  function pick(px, modifiers = {}) {
    const hits=S.candidates(doc,screenToWorld(px),7/zoom),found=hits[0];
    if(selectionMode==='replace'&&!params.acquiring&&!modifiers.ctrlKey&&!modifiers.metaKey&&!modifiers.shiftKey)selected.clear();
    if(found){
      if(modifiers.shiftKey)selected.delete(found.id);
      else if((modifiers.ctrlKey||modifiers.metaKey)&&selected.has(found.id))selected.delete(found.id);
      else selected.add(found.id);
      selectionCycle={px:{...px},ids:hits.map(e=>e.id),index:0};
    }else if(!params.acquiring&&!modifiers.shiftKey&&!modifiers.ctrlKey&&!modifiers.metaKey){selected.clear();selectionCycle=null;}
    prompt();sync();
  }
  function gripAt(px){let best=8,result=null;for(const e of doc.entities)if(selected.has(e.id)&&editable(e))for(const h of G.handles(e)){const s=worldToScreen(h.point),distance=Math.hypot(s.x-px.x,s.y-px.y);if(distance<best){best=distance;result={id:e.id,key:h.key,role:h.role};}}return result;}
  canvas.addEventListener('pointerdown',safe(e=>{
    if(busy||![0,1,2].includes(e.button))return;
    e.preventDefault();canvas.focus();const px=pointer(e);mouse=px;canvas.setPointerCapture(e.pointerId);
    if(e.button===1||tool==='pan'){gesture={kind:'pan',start:px,camera:{...camera}};canvas.style.cursor='grabbing';return;}
    if(e.button===2){gesture={kind:'right',start:px};return;}
    if(advanced?.active&&!advanced.acquiring){gesture={kind:'advanced'};acceptPoint(constrained(px));$('command').focus();return;}
    if(tool==='select'&&!params.acquiring&&!advanced?.active&&!e.ctrlKey&&!e.metaKey&&!e.shiftKey){const grip=gripAt(px);if(grip){gesture={kind:'grip',...grip,start:px,moved:false};selectionCycle=null;canvas.style.cursor='move';log('Drag '+grip.role+'. Release to apply; Esc cancels.');return;}}
    if(tool==='select'||params.acquiring){gesture={kind:'select',start:px,moved:false,modifiers:{ctrlKey:e.ctrlKey,metaKey:e.metaKey,shiftKey:e.shiftKey}};return;}
    const initialTool=tool,initialStage=points.length,p=constrained(px);
    previewWorld={...p};acceptPoint(p);
    // A press-drag-release starts and completes a single shape. Ordinary clicks
    // still use the continuous LINE workflow and never commit twice on release.
    if(tool===initialTool)gesture={kind:'draw',start:px,initialTool,createdStart:initialStage===0&&points.length===1};
    $('command').focus();
  }));
  canvas.addEventListener('pointermove',safe(e=>{
    const px=pointer(e);mouse=px;
    if(gesture?.kind==='pan')camera={x:gesture.camera.x-(px.x-gesture.start.x)/zoom,y:gesture.camera.y+(px.y-gesture.start.y)/zoom};
    if(gesture?.kind==='select'&&Math.hypot(px.x-gesture.start.x,px.y-gesture.start.y)>5)gesture.moved=true;
    const p=constrained(px);previewWorld={...p};
    if(gesture?.kind==='grip'){
      if(Math.hypot(px.x-gesture.start.x,px.y-gesture.start.y)>3)gesture.moved=true;
      gesture.target={...p};try{gripPreview=G.preview(doc.entities.find(e=>e.id===gesture.id),gesture.key,p);gesture.invalid=null;}catch(error){gripPreview=null;gesture.invalid=error.message;}
    }
    hovered=(tool==='select'||params.acquiring)&&gesture?.kind!=='pan'?S.pick(doc,screenToWorld(px),7/zoom)?.id??null:null;
    $('coordinates').textContent='X '+fmt(p.x)+' · Y '+fmt(p.y)+(snapType?' · '+snapType.toUpperCase():'')+(snapWarning?' · INCOMPLETE INTERSECTION SEARCH':'');$('coordinates').title=snapWarning;schedule();
  }));
  canvas.addEventListener('pointerup',safe(e=>{
    const px=pointer(e),g=gesture;gesture=null;
    gripPreview=null;
    if(canvas.hasPointerCapture(e.pointerId))canvas.releasePointerCapture(e.pointerId);
    canvas.style.cursor=tool==='select'||params.acquiring?'default':'crosshair';
    if(g?.kind==='draw'&&g.createdStart&&tool===g.initialTool&&['line','circle','rectangle'].includes(tool)&&params.circleMode!=='3P'&&Math.hypot(px.x-g.start.x,px.y-g.start.y)>5){
      const p=constrained(px);acceptPoint(p);
      if(tool==='line')setTool('select');
      log('Drawing committed. Select the object or start another command.');
    }else if(g?.kind==='grip'){
      if(g.moved&&g.target&&!g.invalid){if(G.apply(doc,g.id,g.key,g.target)){changed();log('Grip edit applied. Undo restores the previous geometry.');}}
      else if(g.invalid)log('Grip edit canceled: '+g.invalid,true);
    }else if(g?.kind==='right'){
      if(Math.hypot(px.x-g.start.x,px.y-g.start.y)<6&&tool!=='select')finishCommand();
      else if(tool==='select'&&selected.size)log(selected.size+' objects selected. Choose an edit command or Properties.');
    }else if(g?.kind==='select'){
      if(g.moved){
        const ids=S.windowSelect(doc,screenToWorld(g.start),screenToWorld(px),px.x<g.start.x),m=g.modifiers;
        if(selectionMode==='replace'&&!params.acquiring&&!m.shiftKey&&!m.ctrlKey&&!m.metaKey)selected.clear();
        for(const id of ids)if(m.shiftKey)selected.delete(id);else if((m.ctrlKey||m.metaKey)&&selected.has(id))selected.delete(id);else selected.add(id);
        prompt();sync();
      }else pick(px,g.modifiers);
    }
    $('command').focus();schedule();
  }));
  canvas.addEventListener('pointercancel', () => {
    gesture = null;
    gripPreview = null;
    schedule();
  });
  canvas.addEventListener('pointerleave', () => {
    if (!gesture) {
      mouse = null;
      snapPoint = null;
      schedule();
    }
  });
  canvas.addEventListener('contextmenu', e => e.preventDefault());
  canvas.addEventListener('dblclick',safe(e=>{e.preventDefault();if(['line','polyline'].includes(tool)){finishCommand();return;}if(tool==='select'){const found=S.pick(doc,screenToWorld(pointer(e)),7/zoom);if(found){selected=new Set([found.id]);sync();$('sidebar').classList.add('open');if(isText(found))$('property-text').focus();}}}));
  canvas.addEventListener('wheel', e => {
    e.preventDefault();
    const px = pointer(e), before = screenToWorld(px);
    zoom = clamp(zoom * Math.exp(-e.deltaY * .0015), .00001, 10000);
    camera = V.add(camera, V.sub(before, screenToWorld(px)));
    schedule();
  }, {passive: false});
  document.querySelectorAll('[data-tool]')
      .forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool)));
  const bind = (id, fn) => $(id).addEventListener('click', safe(fn));
  bind('new-btn', newDrawing);
  bind('open-btn', openPicker);
  bind('save-btn', save);
  bind('example-btn', example);
  bind('dxf-btn', exportDxf);
  bind('png-btn', exportPng);
  bind('undo-btn', () => history());
  bind('redo-btn', () => history(true));
  bind('delete-btn', erase);
  bind('fit-btn', fit);
  bind('welcome-line', () => setTool('line'));
  bind('welcome-example', example);
  bind('help-btn', showHelp);
  bind('help-close', () => $('help-dialog').close());
  bind('layers-toggle', () => $('sidebar').classList.toggle('open'));
  bind('print-btn', printDrawing);
  bind('apply-properties', applyProperties);
  bind('finish-btn',finishCommand);bind('cancel-btn',cancelCommand);bind('dim-defaults-btn',useDimensionDefaults);
  bind('select-btn',cancelCommand);bind('repeat-btn',()=>setTool(lastTool));bind('diagnostics-btn',downloadDiagnostics);
  bind('history-toggle',()=>{const on=$('command-history').classList.toggle('expanded');$('history-toggle').setAttribute('aria-expanded',String(on));$('history-toggle').textContent='COMMAND HISTORY '+(on?'▾':'▴');$('command-history').scrollTop=$('command-history').scrollHeight;});
  $('selection-mode').addEventListener('change',e=>{selectionMode=e.target.value;log('Selection mode: '+selectionMode);});
  for(const id of Object.keys(propertyFields)){
    for(const event of['input','change'])$(id).addEventListener(event,()=>{propertyDirty.add(id);if($(id).type==='color'){const check=Object.keys(colorChecks).find(k=>colorChecks[k]===id);if(check){$(check).checked=false;$(check).indeterminate=false;}}});
  }
  for(const[check,id]of Object.entries(colorChecks))$(check).addEventListener('change',()=>{propertyDirty.add(id);$(id).disabled=$(check).checked;});
  bind('import-report-close', () => $('import-report').close());
  bind('import-continue',()=>{$('import-report').close();$('command').focus();});
  bind('import-unlock-layers',()=>{unlockVisibleLayers();$('import-report').close();$('command').focus();});
  bind('unlock-visible-layers',unlockVisibleLayers);
  for (const which of ['grid', 'snap', 'ortho']) bind(which + '-btn', () => toggle(which));
  bind('add-layer-btn', () => addLayer($('layer-name').value));
  $('layer-name').addEventListener('keydown', safe(e => {
                                     if (e.key === 'Enter') {
                                       e.preventDefault();
                                       addLayer(e.currentTarget.value);
                                     }
                                   }));
  $('layer-select').addEventListener('change', safe(e => selectLayer(e.target.value)));
  $('layer-color').addEventListener('change', safe(e => {
                                      doc.checkpoint();
                                      doc.layer(doc.currentLayer).color = e.target.value;
                                      changed();
                                      updateLayers();
                                    }));
  bind('layer-visibility', () => {
    doc.checkpoint();
    const l = doc.layer(doc.currentLayer);
    l.visible = !l.visible;
    selected.clear();
    points = [];
    changed();
    updateLayers();
  });
  bind('layer-lock', () => {
    doc.checkpoint();
    const l = doc.layer(doc.currentLayer);
    l.locked = !l.locked;
    selected.clear();
    points = [];
    changed();
    updateLayers();
  });
  $('command-form').addEventListener('submit', safe(e => {
                                       e.preventDefault();
                                       submitCommand();
                                     }));
  $('command').addEventListener('input',()=>{historyIndex=inputHistory.length;updateSuggestions();schedule();});
  $('command').addEventListener('keydown',safe(e=>{
    if(e.isComposing||e.keyCode===229)return;
    if(e.key==='Enter'){e.preventDefault();e.stopPropagation();submitCommand();return;}
    if(e.key==='Tab'&&suggestions.length){e.preventDefault();e.stopPropagation();completeSuggestion(suggestionIndex<0?0:suggestionIndex);return;}
    if(['ArrowUp','ArrowDown'].includes(e.key)){
      e.preventDefault();e.stopPropagation();const step=e.key==='ArrowUp'?-1:1;
      if(suggestions.length){suggestionIndex=suggestionIndex<0?(step<0?suggestions.length-1:0):(suggestionIndex+step+suggestions.length)%suggestions.length;renderSuggestions();}
      else if(inputHistory.length){
        if(historyIndex===inputHistory.length)historyDraft=$('command').value;
        historyIndex=clamp(historyIndex+step,0,inputHistory.length);
        $('command').value=historyIndex===inputHistory.length?historyDraft:inputHistory[historyIndex];
      }
    }
  }));
  $('file-input').addEventListener('change', async e => {
    try {
      await loadFile(e.target.files[0]);
    } catch (error) {
      log('Open failed; current drawing was preserved. ' + error.message, true);
    }
  });
  document.addEventListener('keydown', safe(e => {
                              if(e.isComposing||e.keyCode===229)return;
                              const input = e.target instanceof HTMLInputElement ||
                                  e.target instanceof HTMLSelectElement ||
                                  e.target instanceof HTMLTextAreaElement;
                              const cmd = e.target === $('command');
                              const empty = cmd && !$('command').value;
                              if(document.querySelector('.advanced-dialog[open],#plot-dialog[open]'))return;
                              if ($('help-dialog').open || $('import-report').open) {
                                if (e.key === 'Escape') {
                                  if ($('help-dialog').open) $('help-dialog').close();
                                  if ($('import-report').open) $('import-report').close();
                                }
                                return;
                              }
                              if (e.key === 'Escape') {
                                e.preventDefault();
                                cancelCommand();
                                return;
                              }
                              if (e.key === 'F1') {
                                e.preventDefault();
                                showHelp();
                                return;
                              }
                              if(['F3','F7','F8'].includes(e.key)){e.preventDefault();toggle(e.key==='F3'?'snap':e.key==='F7'?'grid':'ortho');return;}
                              if (input && !cmd) return;
                              if(e.key==='Tab'&&selectionCycle?.ids.length>1&&(!input||empty)){
                                e.preventDefault();const ids=selectionCycle.ids;selected.delete(ids[selectionCycle.index]);selectionCycle.index=(selectionCycle.index+(e.shiftKey?ids.length-1:1))%ids.length;selected.add(ids[selectionCycle.index]);sync();return;
                              }
                              if (e.ctrlKey || e.metaKey) {
                                const key = e.key.toLowerCase();
                                const actions = {
                                  s: save,
                                  o: openPicker,
                                  n: newDrawing,
                                  z: () => history(e.shiftKey),
                                  y: () => history(true)
                                };
                                if (actions[key]) {
                                  e.preventDefault();
                                  actions[key]();
                                  return;
                                }
                                if (key === 'a' && (!input || empty)) {
                                  e.preventDefault();
                                  selected = new Set(doc.entities.filter(editable).map(e => e.id));
                                  sync();
                                  return;
                                }
                                return;
                              }
                              if (e.key === 'Delete' && (!input || empty)) {
                                e.preventDefault();
                                erase();
                                return;
                              }
                              if ((!input||empty) && e.key===' '&&tool!=='text'&&!(e.target instanceof HTMLButtonElement)){
                                e.preventDefault();finishCommand();return;
                              }
                              if (!input && e.key === 'Enter'&&!(e.target instanceof HTMLButtonElement)) {
                                e.preventDefault();
                                execute('');
                                return;
                              }
                              if (!input && e.key.length === 1 && !e.altKey) {
                                $('command').focus();
                                $('command').value += e.key;
                                updateSuggestions();
                                e.preventDefault();
                              }
                            }));
  window.addEventListener('beforeunload', e => {
    if (dirty) {
      e.preventDefault();
      e.returnValue = '';
    }
  });
  const reportUnexpected=message=>{const banner=$('errors-banner');banner.hidden=false;banner.textContent='Unexpected error: '+message+'. Save your project and use Diagnostics to report this.';log('Unexpected error: '+message,true);};
  window.addEventListener('error',e=>reportUnexpected(e.message||'A script could not run'));
  window.addEventListener('unhandledrejection',e=>reportUnexpected(e.reason?.message||String(e.reason)));
  new ResizeObserver(resize).observe(wrap);
  window.addEventListener('resize', resize);
  Object.defineProperty(window, 'RasmCAD', {
    value: Object.freeze({
      version:VERSION,
      get document() {
        return doc;
      },
      get selectedIds() {
        return [...selected];
      },
      get tool() {
        return advanced?.active?advanced.name.toLowerCase():tool;
      },
      get dirty() {
        return dirty;
      },
      get downloads() {
        return downloadSerial;
      },
      get lastMeasurement() {
        return lastMeasurement;
      },
      get acquiringSelection(){return !!params.acquiring||!!advanced?.acquiring;},
      worldToScreen,
      screenToWorld,
      execute: safe(execute)
    })
  });
  const measurementCtx=document.createElement('canvas').getContext('2d');
  S.setTextMeasurer((value,height)=>{measurementCtx.font=clamp(height*zoom,0,600)+'px Tahoma, Arial, sans-serif';const m=measurementCtx.measureText(value);return {left:-m.actualBoundingBoxLeft/zoom,right:m.actualBoundingBoxRight/zoom,bottom:-m.actualBoundingBoxDescent/zoom,top:m.actualBoundingBoxAscent/zoom};});
  advanced=window.RasmAdvancedUI.mount({
    parsePoint:(raw,base)=>Commands.parsePoint(raw,fromBase||base||null),acceptPoint,
    getDocument:()=>doc,getSelection:()=>[...selected],
    enter:()=>{setTool('select',false);},
    changed:(ids,message)=>{if(ids)selected=new Set(ids);dirty=true;updateLayers();prompt();sync();if(message)log(message);},
    refresh:()=>{prompt();sync();},focus:()=>$('command').focus(),log,download,
    append:e=>{ensureDrawingLayer();append(e);},
    crossing:(a,b)=>S.windowSelect(doc,a,b,true),
    selectAll:()=>{selected=new Set(doc.entities.filter(editable).map(e=>e.id));prompt();sync();},
    replaceDocument:(next,name)=>setDocument(next,name,false)
  });
  plotUI=window.RasmPlotUI.mount({getDocument:()=>doc,download,log,
    getSelectionBounds:()=>{const b={valid:false,min:{x:0,y:0},max:{x:0,y:0}};for(const e of doc.entities)if(selected.has(e.id)){const q=C.entityBounds(e);if(q.valid){if(!b.valid){b.min={...q.min};b.max={...q.max};b.valid=true;}else{b.min.x=Math.min(b.min.x,q.min.x);b.min.y=Math.min(b.min.y,q.min.y);b.max.x=Math.max(b.max.x,q.max.x);b.max.y=Math.max(b.max.y,q.max.y);}}}return b.valid?b:null;},
    setPlotSettings:settings=>{doc.checkpoint();doc.resources.plot=settings;changed();}
  });
  updateLayers();
  resize();
  prompt();
  sync();
})();
</script>
</body></html>
